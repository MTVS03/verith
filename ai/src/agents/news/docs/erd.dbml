// ============================================
// news 에이전트 DB 스키마 (개념)
// PostgreSQL(원본) + Neo4j(그래프)
// 주의: 이 문서는 news가 제시하는 *명세*일 뿐이다.
//   실제 모델 정의·테이블 생성은 backend 소유:
//   → C:\verith\backend\db\models\news  (구현 지시서: 그곳 SCHEMA_SPEC.md)
//   news는 절대규칙 1대로 DB 직접 접근 금지, backend HTTP로만 조회/저장한다.
// ============================================

// ─────────── PostgreSQL (News 원본) ───────────

Table news [note: '기사 원본. Neo4j엔 news_id 참조만 두고 본문은 여기서 가져옴'] {
  id             bigint    [pk, increment]
  title          text      [not null]
  content        text      [note: '본문']
  summary        text      [note: 'LLM 통일 요약. 임베딩·병합의 기준']
  url            text      [unique, note: '원문 직링크. 1차 중복 차단']
  publisher      varchar   [note: '언론사명. importance 가중치에 사용']
  sentiment      varchar   [note: 'KR-FinBert 결과: 긍정/중립/부정']
  embedding      vector    [note: 'summary 임베딩. pgvector']
  published_at   timestamp [note: '7일 롤링 기준']
  event_id       uuid      [note: '소속 이벤트 = Event.canonical_id(UUID). nullable(병합 전 NULL). ai Article.event_id(str)와 정합. news.id(=news_id)만 정수 PK로 별개']
  created_at     timestamp
}

// ─────────── PostgreSQL (리포트 저장) ───────────
// 질의 흐름 산출물(HTML 리포트 하나)의 식별·이력 저장.
// ④ 답변 텍스트는 별도 출력이 아니라 HTML 안 "뉴스 흐름 요약" 섹션으로 렌더된다.
Table reports [note: '질의 결과 리포트. report_id는 uuid4(랜덤), 시간순 정렬은 created_at으로'] {
  report_id      uuid      [pk, note: 'Pydantic Field(default_factory=lambda: str(uuid.uuid4())). 컬럼 타입 UUID 권장(TEXT도 무방, backend와 합의)']
  question       text      [note: '사용자 질문(또는 종목 프리셋)']
  intent         varchar   [note: '관계/이유/요약/현황']
  answer_text    text      [note: '④ 답변 텍스트(원본). HTML "뉴스 흐름 요약" 섹션으로 렌더됨']
  evidence       jsonb     [note: '근거 news_id 목록(근거 이슈 칩→이벤트→기사 추적)']
  html           text      [note: '렌더된 HTML 리포트(답변 내장). 또는 경로']
  created_at     timestamp [note: '시간순 정렬 기준(아이디에 시간정보 안 넣음)']
}

// ─────────── Neo4j (Event 중심 그래프) ───────────
// DBML은 RDB 표기이므로 Neo4j는 주석으로 구조만 기술.
//
// (Event)   중심 노드
//   id (canonical), canonical_title, importance
//   ※ 감성 count는 저장 안 함 → 조회 시 실시간 집계
//
// 관계:
//   (Company)-[:PARTICIPATES_IN]->(Event)   여러 회사가 한 이벤트 공유 가능
//   (Company)-[:BELONGS_TO]->(Sector)
//   (Company)-[:RELATED_TO]->(Company)      같은 이벤트 공유 등으로 파생
//   (Event)-[:HAS_NEWS]->(NewsRef {news_id}) 본문은 PostgreSQL에서
//   (Event)-[:HAS_KEYWORD]->(Keyword)
//   (Event)-[:MENTIONS]->(Person)
//   (Event)-[:ABOUT]->(Country)
//
// NewsRef 키 전환: ai GraphBatch 입력은 NewsRef.key=url(저장 전 news_id 미부여).
//   backend가 save 시 news.url upsert로 얻은 news.id를 Neo4j NewsRef.news_id로 해소.
//   → 입력=url, 최종 그래프=news_id 참조 (SCHEMA_SPEC §3·§7.3, TASK 07 §0.2).

// ─────────── 삭제 규칙 (CASCADE) ───────────
// published_at < now-168h 기사 삭제
//   → Event 기사수 감소 → 0이면 Event 삭제
//   → 고아 Keyword/Person/Country 삭제
//   → Company는 유지

Table _import_note [note: '''
importance = 기사 개수 + 언론사 가중치 + 감성 절대값 (LLM 생성 아님, 객관 계산)
감성 count는 저장하지 않고 조회 시 실시간 집계 (하루 수백 건 수준이라 충분)
'''] {
  note_only varchar
}
