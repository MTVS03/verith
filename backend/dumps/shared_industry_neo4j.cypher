MERGE (c:`Chunk` {`id`: '096770-0162-002b4811'}) SET c += {`text`: '[SK이노베이션] 5. 석유 트레이딩 사업\n탱크터미널은 트레이딩 사업에 활용되는 주요 인프라로, 안정적인 재고 관리와 물류 효율성을 통해 시장의 변동성에 유연하게 대응할 수 있는 기반을 제공합니다. 이를 통해 트레이딩 사업의 경쟁력을 강화하는 데 중요한 역할을 합니다.\n② 국내외 시장 여건\n미국의 고율 상호관세 영향으로 Global 교역 수요 및 경기 둔화 우려감이 확대됨에 따라 상반기 석유 시황은 평년 대비 부진한 흐름을 보였습니다. 미국의 평균 관세율이 4월 "Liberation Day" 이후 최대 25% 수준까지 치솟았으나, 캐나다, EU, 일본 등 주요국의 무역 협상을 통해 10% 수준으로 안정화되며 수요 불안 심리가 일부 해소되었습니다. 8월 이후 우크라이나가 이전 대비 광범위하고 지속적인 방식으로 러시아의 주요 정유 시설에 드론 공격을 가하며, 공급 부족 우려가 급격하게 확대되며 시장은 강세 영향을 받았습니다. 최대 2백만B/D (전체 Capacity 6.6백만B/D의 30% 수준의 정유 시설에 드론 공격이 가해짐에 따라 석유 제품 시황은 러-우 전쟁 발발 이후 가장 강력한 강세 시황을 시현했습니다. 한편 나이지리아의 신규 정유사 Dangote Ref.의 Gasoline 생산 설비 (200KB/D RFCC) 가 2025년 하반기 지속 가동 차질을 겪으며, 공급 측면의 또다른 강세 요인으로 작용했습니다. 11월 이후 미국 주도의 러-우 전쟁 휴전 논의 소식이 보도되며 초강세 시황은 하향 조정되었으나, 가동 중단된 설비들의 복귀 지연과 동절기 석유 수요 증가가 맞물려 연말 견조한 수준을 유지했습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 석유 트레이딩 사업', `idx`: 162} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0203116, 0.0461129, -7.41401e-06, 0.0131523, -0.0219934, -0.0101239, 0.0192848, 0.0828788, 0.0518237, 0.041706, 0.0565016, -0.0380753, -0.0583902, 0.0105215, 0.00815184, -0.0168786, 0.0983269, -0.0235642, 0.00941885, -0.0185915, -0.0681375, -0.00847659, 0.00265274, 0.0184951, -0.0478823, -0.00131327, 0.00784032, 0.0464364, 0.0169924, 0.0539106, 0.0876517, 0.0706268, -0.0489132, 0.00582558, 0.0292125, -0.0253995, 0.0460972, 0.0167182, -0.063456, 0.0326481, -0.0193893, -0.0387383, 0.0488533, -0.0360609, 0.0560003, -0.0382934, -0.0254959, -0.00348575, -0.0429461, 0.0238028, -0.048749, -0.0518157, -0.00935508, 0.0586844, 0.0373008, -0.0329574, -0.0288442, 0.0116691, -0.0552356, 0.0489651, -0.0617675, 0.0241486, 0.0786857, -0.0559917, 0.0024035, -0.0166928, 0.0151286, -0.0426837,