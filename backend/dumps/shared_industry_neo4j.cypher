MERGE (c:`Chunk` {`id`: '096770-0024-fede59d2'}) SET c += {`text`: '[SK이노베이션] 3. 원재료 및 생산설비 > [SK온㈜] > 나. 주요 원재료 등의 가격변동추이\n당사 주요 원재료의 가격은 고객사와의 계약에 따라 결정되어 영업기밀에 해당됩니다. 따라서 동 사항에 대한 세부 내용을 공시할 경우 당사의 영업에 현저한 영향을 미칠 수 있다고 판단하여 세부 내역은 기재하지 않았습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [SK온㈜] > 나. 주요 원재료 등의 가격변동추이', `idx`: 24} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00246192, 0.0494728, -0.0751744, -0.0168002, -0.0536404, -0.0604772, 0.00877837, 0.0243195, 0.019681, 0.00575263, 0.0516225, 0.0219839, 0.0280867, -0.0238903, -0.000260185, 0.0310074, 0.0409329, -0.0191331, -0.025923, 0.0326947, -0.0376476, -0.0518662, 0.0152862, 0.0445121, 0.128302, -0.0212799, -0.00987933, 0.0324674, -0.0012748, 0.0192826, 0.0418936, 0.0138538, -0.0142222, -0.0460102, -0.0166875, -0.00817386, 0.0114418, 0.0782655, -0.0263766, 0.0826376, 0.0227138, 0.0202213, 0.0742594, -0.0201617, 0.0669001, -0.0380914, -0.0488345, -0.00145268, 0.00182825, -0.0032606, 0.0039416, -0.0561593, 0.0579832, -0.0261779, 0.054053, 0.0643632, -0.0716689, -0.0417482, 0.00167657, 0.091184, -0.0380699, -0.0255741, 0.0416921, -0.000843216, 0.0446252, -0.0359142, 0.0358598, 0.011401, 0.00889583, -0.0155507, -0.0375689, -0.00151341, 0.0326836, 0.0264596, -0.0210812, 0.0338582, 0.00820381, 0.0229763, 0.00830691, 0.0327265, -0.0183355, 0.032389, -0.0289361, -0.00365973, 0.0199346, 0.0441243, -0.0213137, -0.00835865, 0.0466819, 0.0129697, 0.0159614, -0.0525326, -0.00926603, 0.0343434, 0.0751851, -0.0279601, -0.0819391, 0.0463909, -0.0223869, 0.0175827, -0.043107, -0.0212198, 0.0635685, -0.0829575, 0.0588286, 0.0291251, -0.0261063, 0.0773978, 0.0232394, 0.0277643, -0.00515005, -0.0112798, -0.0236893, -0.0162878, 0.028697, -0.00888578, -0.00169215, 0.0126481, 0.0808217, 0.05