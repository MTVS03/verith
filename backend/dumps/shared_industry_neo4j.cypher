MERGE (c:`Chunk` {`id`: '003670-0013-7abd7e34'}) SET c += {`text`: '[포스코퓨처엠] 3. 원재료 및 생산설비 > 바. 생산설비의 신설ㆍ매입계획 등\n- 진행중인 투자\n당사는 2025년 당기말 현재 생산 시설 신규 및 확장 등을 위하여 총 12,112억원을 사용하였습니다. 향후에도 사업 경쟁력 강화를 위하여 경영 환경 및 시장 변화에 맞춰 적정한 투자를 집행해 나갈 것입니다.\n(단위 : 억원)\n사업부문\n구분\n투자기간\n대상자산\n투자내용\n투자효과\n제55기(당기) 투자액\n비고\n이차전지소재\n신/증설\n2025-01~2025-12\n건물/설비 등\n생산 시설 신규/확장 투자 등\n생산능력 증가\n12,112\n누적실적\n합계\n12,112\n-', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > 바. 생산설비의 신설ㆍ매입계획 등', `idx`: 13} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0322421, 0.0238416, 0.0090529, 0.00988255, -0.0378695, 0.04056, -0.0430052, 0.0737914, -0.0317886, -0.0252183, -0.0128902, 0.0264045, -0.00988023, -0.0151549, 0.0098777, 0.00667767, 0.0471286, -0.0302981, 0.0163339, 0.0516319, 0.106376, -0.0121659, 0.0453702, 0.000296352, -6.9352e-05, -0.0148542, 0.0289163, -0.00267154, 0.0152252, 0.0831348, 0.0037791, 0.0452969, -0.0736505, 0.00414101, 0.0406368, 0.00383338, -0.00052186, -0.00563643, -0.0201951, 0.0204785, 0.0223892, -0.00574421, -0.0186578, 0.023625, 0.00652986, -0.00849383, -0.0226144, -0.0333402, -0.0746113, -0.0305588, -0.0104159, -0.0184107, -0.0397676, -0.0353202, 0.0285221, 0.0304928, -0.136274, -0.0162514, 0.0155324, 0.0521891, -0.0330364, -0.0531026, 0.0664322, -0.0429456, 0.0808768, -0.0457195, -0.00772047, -0.0170239, -0.0085291, 0.0251218, -0.0205268, 0.0564036, 0.0207813, -0.0247982, -0.0746313, 0.00552953, 0.00328727, -0.0314129, 0.0466001, -0.0549187, -0.0123799, 0.0156284, 0.013374, -0.0572119, 0.00871693, -0.00896639, -0.0636028, -0.00943756, -0.0005874, -0.0394285, -0.00651963, -0.0527687, -0.038606, 0.0746942, -0.0106195, -0.0245623, -0.0101545, -0.0216273, -0.0141541, -0.0292708, -0.04058, 0.010791, 0.0391445, -0.0200595, 0.0326746, 0.0392794, -0