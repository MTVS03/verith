MERGE (c:`Chunk` {`id`: '086520-0108-fdcb7e25'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [소형전지 산업]\n기존에 소형전지의 대부분은 스마트폰, 노트북 등 모바일 IT 기기 시장의 성장에 따라 동반 성장하여 왔으나, 모바일 IT 기기 시장이 성숙기에 진입함에 따라 소형전지 시장은 전동공구, 전기자전거, 무선청소기, 잔디깎기(Garden Tool) 등 Non-IT 산업으로 그 적용시장을 확대해 나가고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [소형전지 산업]', `idx`: 108} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00147913, 0.0294901, -0.0186419, -0.0111985, -0.00512664, -0.0522936, -0.00913475, 0.0810393, -0.0276736, 0.0208397, 0.0663498, -0.0231474, -0.0115, -0.0777504, 0.0565395, -0.058924, -0.00621541, 0.044677, 0.0208837, -0.12675, 0.0555315, 0.0261951, 0.0449671, 0.0339455, 0.0196422, -0.081268, -0.0228123, -0.0696652, 0.0211641, 0.00361249, 0.0145056, -0.0100861, 0.0055715, 0.0177761, -0.0505332, 0.0373457, -0.0377082, -0.036634, -0.0140321, 0.0115902, 0.0136015, -0.0446773, 0.0551827, -0.0577458, -0.0163986, -0.0894578, -0.0484041, -0.00472031, -0.0372396, -0.0619406, -0.0463199, -0.0365741, 0.050773, -0.00278607, 0.0270458, 0.0590492, -0.0589142, -0.00447038, -0.0251603, 0.0600303, 0.0237382, 0.0149012, 0.0880291, -0.0522051, -0.0532292, -0.0605695, -0.00956477, -0.0612529, 0.00594108, 0.0202903, 0.0161007, 0.0487544, 0.0384011, -0.0202122, 0.0131744, -0.0506383, 0.0118136, 0.0270143, 0.0211747, 0.0286624, 0.000636865, -0.013326, 0.0163776, -0.015374, -0.00724526, -0.0265323, 0.0433955, 0.00608851, -0.0273405, -0.0659878, -0.00465155, -0.100565, 0.0504862, 0.0468203, -0.0200433, 0.0833121, -0.0171336, 0.00193965, -0.0340056, 0.00177358, 0.025077, 0.063695, 0.0153803, -0.00449984, -0.0537808, 0.0211253, -0.0153319, -0.00890322, -0.00719374, 0.0164068, 0.0188375, -0.00526279, 0.0367385, 0.0410108, -0.0579923, -0.0532945, 0.0274574, 0.0177514, 0.0870474, 0.0396