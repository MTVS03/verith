MERGE (c:`Chunk` {`id`: '086520-0127-4dcb81de'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [환경사업부문] > 나. 법률/규정 및 환경 관련 규제사항 등\n□ 에코프로에이치엔(연결)\n정부나 지방자치단체의 법률, 규정등으로 당사의 영업활동, 비용지출 또는 경쟁상의 지위 등 사업의 영위에 중요한 영향을 미치는 사항은 없으며, 에코프로에이치엔이 취득한 환경경영시스템 및 안전보건 경영시스템 인증은 다음과 같습니다.\n- ISO 14001(환경경영시스템)\n- ISO 45001(안전경영시스템)\n당사 환경경영 실적에 관한 세부 내용은 당사 홈페이지(www.ecoprohn.co.kr)을 참고하시기 바랍니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [환경사업부문] > 나. 법률/규정 및 환경 관련 규제사항 등', `idx`: 127} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0443637, -0.0281103, -0.00829268, -0.0906914, -0.0738042, -0.0360033, -0.00176617, 0.0220537, -0.0884887, 0.0751559, -0.0207192, 0.00728467, -0.0117507, -0.0428819, 0.0113556, 0.0247887, 0.0063506, 0.023858, -0.0499326, -0.0327757, -0.0207234, -0.0388845, 0.0269844, -0.0674824, 0.0936444, -0.00932276, 0.0234112, -0.0593823, -0.0364459, -0.00139993, -0.0633885, 0.040747, 0.0427849, 0.00291812, -0.00218271, 0.0341734, -0.0223968, 0.0134321, -0.0142261, 0.089893, -0.0243653, -0.0469842, 0.00870672, -0.0257092, -0.0110106, -0.00743245, -0.0117504, 0.00613829, -0.0465737, -0.00628889, 0.0261347, 0.0177643, 0.0533356, -0.12998, 0.00680248, 0.0870428, -0.0043477, -0.0854106, -0.00885858, 0.0475726, -0.0229225, -0.0359535, 0.0265209, -0.0612997, -0.0192381, -0.0366619, 0.0330576, -0.0375169, 0.00216663, 0.00428011, 0.0214032, -0.0460044, -0.0288302, -0.0504478, -0.00567853, -0.0308008, -0.022123, -0.0116817, 0.0362229, 0.0510636, -0.0554929, -0.0161434, 0.00940521, 0.0971306, 0.00547024, 0.0289404, -0.0585895, -0.00714282, 0.0315196, -0.0504059, -0.0579938, -0.0364934, -0.00368706, 0.0306745, 0.0577973, 0.00744252, 0.0125042, -0.0201333, 0.0280594, 0.00793848, -0.0582127, 0.0386876, 0.0116684, -0.0425959, 0.00939738, -0.0152594, 0.04993