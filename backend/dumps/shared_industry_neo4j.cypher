MERGE (c:`Chunk` {`id`: '348370-0026-a7a373d3'}) SET c += {`text`: '[엔켐] 7. 기타 참고사항 > 가. 지적재산권 보유현황\n10-2025-0033821\n2025.03.17\n21\n리튬 이차전지용 전해액 첨가제, 이를 포함하는 리튬 이차전지용 전해액 및 리튬 이차전지\n리튬 이차전지용 첨가제를 개발, SEI층 안정화, 전해질 산화와 전극의 분해 방지, 고온수명 특성 우수하며 고온 저장시 내부저항을 감소시키고 전지두께 팽창 억제하여 좋은 용량유지율 제공함\nCN202510651901.5\n2025.05.20', `company`: '엔켐', `stock_code`: '348370', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260326001049&dcmNo=11183261&eleId=9&offset=70916&length=79058&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 가. 지적재산권 보유현황', `idx`: 26} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0151471, 0.0656096, 0.0648017, -0.03038, -0.0387031, -0.0623309, 0.0142654, 0.100005, -0.00355511, -0.0300967, 0.0102214, 0.0310475, -0.0336969, -0.0183406, -0.0464787, -0.0233066, -0.0444126, -0.0427165, -0.105498, 0.0336402, 0.0284659, -0.0738517, 0.0119241, 0.0313307, 0.0338863, 0.0195415, 0.00352581, 0.0247062, 0.0395224, -0.0251666, -0.0331356, 0.0179081, -0.0970085, 0.0180963, -0.00654014, 0.0431678, 0.0373936, -0.035342, -0.0747217, 0.030455, 0.0179696, 0.0115502, 0.0171213, 0.010487, -0.00788889, 0.00974878, -0.0427268, -0.0205662, 0.0440269, 0.00810424, -0.0250749, -0.0273171, 0.0115905, -0.0030475, 0.0996817, -0.0025593, -0.0422712, -0.0516122, 0.00231994, -0.023614, 0.0371151, -0.0177076, 0.0272526, -0.0708508, -0.0180972, -0.0304828, 0.0249099, 0.0369094, 0.0218357, -0.0106518, 0.0101753, 0.0601663, 0.000118069, -0.0454746, -0.0038899, 0.0320311, 0.0145866, 0.0163856, 0.0743941, -0.00484841, 0.0398451, 0.0475159, -0.0152254, -0.0110333, -0.0140654, -0.0453752, -0.0413716, -0.00936446, 0.0574657, -0.0275844, -0.0250746, 0.0274162, 0.0678103, 0.0230621, 0.0679639, 0.0632337, -0.0184363, 0.0300293, 0.0499384, -0.0187603, -0.0389354, 0.0557514, 0.0128949, -0.0232219, 0.0556289, -0.0455515, -0.0163911, -0.0141146, -0.0258635, 0.0319183, -0.0522088, -0.0357688, 0.0698785, 0.0281826, 0.00382855, -0.042326