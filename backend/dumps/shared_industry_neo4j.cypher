MERGE (c:`Chunk` {`id`: '003670-0012-9ab25b06'}) SET c += {`text`: '[포스코퓨처엠] 3. 원재료 및 생산설비 > 마. 생산설비의 현황\n128,689,378\n3,892,711,958\n7,350,246,823\n정부보조금\n(738,000)\n(8,003,815)\n(29,063)\n(18,573,741)\n(44,108)\n(114,339)\n(37,269,473)\n(64,772,539)\n감가상각누계액\n-\n(104,709,719)\n(17,034,900)\n(487,091,155)\n(18,076,941)\n(80,434,399)\n-\n(707,347,114)\n손상차손누계액\n(1,307,007)\n(7,764,064)\n(503,820)\n(194,438,326)\n(66,338)\n(2,536,183)\n(118,963,452)\n(325,579,190)\n(주1)\n건설중인자산의 본계정 대체된 금액으로 구성되어 있으며, 이 중 무형자산으로 3,009,703천원 대체되었습니다. 그 외 당기 중 유형자산에서 매각예정자산으로 52,592,614천원 대체되었습니다.(주석 14 참조).\n(주2)\n기타의 당기말장부가액은 공구와기구 11,865,149천원, 비품 33,739,308천원으로 구성되어 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > 마. 생산설비의 현황', `idx`: 12} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.000669046, 0.0302297, -0.0338194, 0.0341114, 0.0103541, 0.00575368, -0.0171342, 0.105332, -0.0365746, -0.0410279, -0.0410668, 0.0159718, 0.0197786, 0.0314653, 0.0143894, -0.0124659, 0.0103765, -0.0244483, -0.0373051, 0.013164, 0.0534438, -0.00744344, 0.00999577, 0.0131369, 0.0180463, 0.00445161, 0.0363558, 0.00371636, 0.0340146, -0.013128, 0.032204, 0.0269887, -0.042303, 0.00508097, -0.00439454, 0.0248571, 0.0359189, -0.00918904, -0.0170978, 0.0599477, -0.0183022, 0.037671, -0.00296959, 0.0196128, 0.00394742, -0.00236367, 0.00524603, -0.0657837, -0.0225214, -0.0496746, -0.0112263, 0.00601657, 0.0219216, -0.0246562, 0.0181075, 0.0300097, -0.131813, 0.0533378, 0.0124058, 0.0363209, -0.0483793, -0.0408491, 0.00775038, -0.0111285, 0.0842056, -0.034827, -0.0522336, -0.0172454, 0.0204183, 0.0650196, -0.014243, -0.0167579, -0.00177201, -0.00117539, -0.0696344, -0.0627641, 0.0315679, -0.00248731, 0.0411372, -0.0569818, 0.0567566, 0.0163742, 0.00249681, 0.023699, -0.0434321