MERGE (c:`Chunk` {`id`: '361610-0016-135c09b9'}) SET c += {`text`: '[SK아이이테크놀로지] 5. 위험관리 및 파생거래 > 다. 파생상품 계약 및 그 계약에 관한 내용\nUSDPLN 3.80\nUSD 50\n(3,263)\n-\n(3,263)\n미적용\n합계\n(36,030)\n-\n(36,030)\n(주1)\n계약금액은 계약통화 기준 금액이며, 공정가치, 자산 및 부채는 원화 기준입니다.\n(주2)\n공정가액 평가주체는 거래처와 동일합니다.\n(주3)\n계약기간 만료 시점에 약정환율 대비 환율 상승 시 손실, 환율 하락 시 이익 발생하는 계약입니다.\n(주4)\n계약기간 만료 시점에 약정환율 대비 환율 상승 시 이익, 환율 하락 시 손실 발생하는 계약입니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 다. 파생상품 계약 및 그 계약에 관한 내용', `idx`: 16} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [2.91169e-08, 0.0237428, -0.057781, -0.00656224, -0.0259351, 0.0415368, 0.022573, 0.0491521, 0.0256159, 0.0300583, 0.0335819, 0.0551219, 0.00833283, 0.0734437, 0.0149759, 0.00250635, -0.0317692, 0.00796296, -0.00950445, -0.00223456, 0.00968592, -0.0137918, -0.039587, 0.0704448, 0.0435456, -0.0297799, -0.0212, 0.000597313, 0.0192985, 0.0355257, 0.0315072, 0.0829838, -0.0244104, -0.0393386, 0.0172952, -0.0231946, 0.0202498, 0.0645324, -0.0434497, 0.0512242, -0.00469064, -0.0226636, -0.00979233, -0.0727212, 0.108651, 0.00413772, 0.00112481, -0.0425382, -0.030252, 0.0073639, -0.0202537, -0.088389, 0.100569, 0.02295, 0.0751559, -0.0155128, -0.0331416, 0.0868864, 0.0395649, -0.00293152, -0.0256602, -0.0293578, 0.00530031, -0.0361964, 0.0302883, -0.0561142, -0.00802884, 0.0536225, -0.0126304, -0.00168073, -0.0880556, -0.0119586, 0.0436519, 0.0822819, -0.034019, 0.0435955, 0.0191116, 0.029877, 0.0596316, -0.00523305, 0.0242836, 0.0642938, 0.0246445, 0.0471429, -0.0408805, 0.0446717, -0.0274893, 0.00540405, 0.00882, -0.0401051, -0.0113994, 0.021475, 0.000550518, 0.0428192, -0.0133301, -0.0281943, -0.060987, 0.0325067, -0.0272728, 0.00610867, -0.0229695, -0.00397959, 0.00833032, -0.00746554, -0.000887866, 0.057556, -0.