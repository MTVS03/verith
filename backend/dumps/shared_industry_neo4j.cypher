MERGE (c:`Chunk` {`id`: '003670-0030-1c7fa997'}) SET c += {`text`: '[포스코퓨처엠] 7. 기타 참고사항 > 다. 환경물질의 배출 또는 환경보호와 관련된 사항\n(기후변화 대응)\n회사는 2050 탈탄소를 공식 선언하고 이를 실현하기 위하여 단계적 목표와 실행 방안을 구체화한 로드맵을 수립하였습니다. 탈탄소를 위한 세가지 전략인 공정개선, 재생에너지 확대, 에너지효율 향상을 기반으로 중장기 목표를 설정하고 단계적인 이행을 추진하고 있습니다. 연료 전환, 공정 개선, 설비 교체, 기술 도입 등을 적극적으로 실천하여 기후변화 문제 해결을 위해 노력하고자 합니다.\n(환경경영)\n회사는 환경 정책을 준수할 것을 요구하고 있으며 국제 표준에 부합하는 환경경영체계 구축을 위하여 환경경영시스템(ISO 14001) 인증을 취득하고 정기적인 심사를 통해 환경 관리 수준을 지속적으로 개선하고 있습니다. 정기 심사 및 내부 심사를 통해 환경 성과를 점검하고 개선사항을 발굴 및 조치하여 해당 영역을 보완하여 환경경영체계를 강화하고자 합니다.\n회사는 폐기물 발생 시 성분 분석 및 용출시험을 실시하고 분석 결과를 바탕으로 지정폐기물 분류 및 처리 방법을 검토합니다. 유해화학물질 역시 국제적 규제 및 기준, 이니셔티브를 준수하여 관리하며 사업장별 유해물질 정보를 통합적으로 운영하고 있습니다. 또한, 수질 및 대기오염물질 배출을 저감하기 위해 법적 기준보다 더욱 엄격한 자체 기준을 적용하고 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 다. 환경물질의 배출 또는 환경보호와 관련된 사항', `idx`: 30} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0449017, -0.00345668, 0.00057294, -0.0306383, -0.0350111, -0.037338, -0.0312988, 0.0321623, -0.110951, 0.0502427, 0.00290933, 0.0294271, 0.0247544, 0.0297861, 0.0693462, 0.0508848, -0.00499572, 0.00931198, 0.0121245, 0.0689458, 0.0896579, -0.0555412, 0.0168487, -0.0312861, 0.0173742, 0.00197459, -0.0324245, -0.0416792, 0.0222366, 0.0991308, 0.00398453, 0.0326246, -0.106677, -0.0480972, -0.00480262, -0.0398283, 0.00792848, -0.0154265, -0.0417021, -0.00375546, 0.0589197, -0.0283293, -0.0109119, 0.0216322, -0.0105281, -0.00737452, -0.0210918, -0.0576134, -0.0724872, -0.0404597, -0.0354162, 0.0836854, 0.00504079, -0.00371007, 0.0548049, 0.0622975, -0.0796005, -0.0139873, 0.0198938, -0.00137175, 0.0220623, -0.0573815, -0.0202817, -0.0183135, 0.00169021, -0.0451125, 0.0278689, -0.0289264, 0.00514521, 0.010828, 0.0385098, 0.00782297, -0.0533247, -0.0706553, -0.0423211, -0