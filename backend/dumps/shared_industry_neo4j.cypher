MERGE (c:`Chunk` {`id`: '086520-0097-76c0dd23'}) SET c += {`text`: '[에코프로] 6. 주요계약 및 연구개발활동 > [연구개발비용계÷당기매출액×100]\n신규\nCO2 공급장치 개발\n진행중\n신규\n망초 처리 시스템 개발\n진행중\n신규\n전해액 첩가제 개발 (A)\n진행중\n신규\n전해액 첩가제 개발 (B)\n진행중\n신규\n금속 산화물 흡착 소재를 이용한 NOx 효율 극대화 기술 개발\n진행중\n신규\nHBM 가공용 소재개발\n진행중\n신규\n유기성 폐자원 및 이산화탄소 동시활용 폴리머 플랫폼 제조기술 개발\n진행중\n신규\n1톤/일 규모 혼합 폐플라스틱의 가스화를 통한 재생 나프타 생산 기술 개발\n진행중\n신규\n고GWP 온실가스 저감을 위한 N2O, NF3 동시처리형 촉매 소재와 담체를 활용한 모듈 개발\n진행중\n신규\n탄소저감 능동형 공기부유 유해인자 통합 필터시스템 개발\n진행중\n신규\n고성능 리튬인산철전지용 전해액 제조기술 개발\n진행중\n신규\n전기화 전환 기술 개발(e-항공유, e-플라스틱 원료(FDCA))\n진행중\n신규\n전기화(학)포집 기술 개발(e-DAC, e-DOC)\n진행중', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '6. 주요계약 및 연구개발활동 > [연구개발비용계÷당기매출액×100]', `idx`: 97} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0454198, -0.00652931, 0.030576, 0.00634739, -0.0172829, -0.0354719, -0.0314938, 0.091789, -0.0635194, 0.00838559, 0.0313138, 0.00673624, 0.0688526, 0.0182233, -0.0165456, 0.0259602, 0.0121116, -0.0679385, -0.0160586, -0.00772839, 0.0148776, -0.0200146, 0.0180869, 0.0289081, 0.0572647, 0.00784258, 0.0527047, -0.0472829, 0.00913705, 0.0580208, -0.00880148, 0.0209209, -0.0614515, -0.0522207, -0.0378719, 0.021546, 0.0911664, 0.02856, -0.0488929, 0.0831637, 0.0539455, -0.00386691, 0.0234299, 0.0322934, 0.0100127, -0.0268964, -0.0650487, -0.0230618, -0.0741422, -0.0271007, 0.0022181, -0.0046319, -0.0301421, -0.0142141, 0.0987835, 0.0110475, -0.131546, -0.0219775, -0.0396657, 0.0759524, 0.0171062, -0.00531221, 0.0326253, -0.00941439, 0.0474404, -0.014162, -0.0273638, 0.0581646, 0.0083081, 0.0417159, 0.0147043, 0.0547665, 0.0562372, -0.0645013, 0.0115232, 0.00811537, 0.00418544, -0.025098, 0.0155487, 0.0108756, 0.0081148, -0.0224123, -0.0364744, -0.0430669, -0.0267473, -0.0407065, -0.0253065, -0.00419709, -0.0626148, -0.05555