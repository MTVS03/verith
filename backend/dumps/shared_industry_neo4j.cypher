MERGE (c:`Chunk` {`id`: '348370-0011-46775036'}) SET c += {`text`: '[엔켐] 4. 매출 및 수주상황 > 다. 수주상황\n당사의 제품은 공동연구개발 후 양산 시 양사간 협의 후 PO를 통해 주문과 생산을 진행하기 때문에 수주상황을 객관적 수치로 표현하기 어려우며, 확정 PO가 아닌 해당 연도별 FCST만 공유받고 있습니다. 또한, 매 분기마다 해당 FCST의 변동폭이 매우 큰 편이며 수주 후 납품 기일이 짧아 특정일 기준에 의한수주 잔고가 크지 않으므로 수주상황에 대한 기재를 생략합니다.', `company`: '엔켐', `stock_code`: '348370', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260326001049&dcmNo=11183261&eleId=9&offset=70916&length=79058&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 다. 수주상황', `idx`: 11} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0336426, -0.0386987, -0.0407081, 0.0176578, -0.0150651, 0.0131179, -0.0108805, 0.090881, 0.00622424, 0.0686773, 0.0642279, 0.0403028, -0.00216354, -0.0531813, 0.0240325, -0.0111141, 0.00937703, -0.037638, -0.0577724, 0.00572182, -0.00376379, -0.00273758, 0.0547188, 0.0460374, 0.0910089, 0.037276, 0.012172, 0.0311582, 0.0140815, 0.0662656, 0.0466045, 0.0566411, -0.00467513, -0.037052, 0.0138074, 0.0102592, 0.0199919, -0.054376, -0.0154254, 0.0439841, 0.00151692, -0.0259392, 0.00374116, -0.0534888, 0.00322658, -0.067591, -0.00185025, 0.0047212, -0.0215938, 0.0274342, -0.116656, 0.00123313, 0.0478309, -0.0156933, 0.059521, 0.00929752, -0.0670896, -0.00482443, -0.0101796, -0.0012368, -0.0266636, -0.0192544, -0.0166024, 0.0181036, -0.006695, -0.0157337, -0.00427949, -0.0189116, 0.041887, 0.0203305, -0.0260225, 0.00816018, 0.022383, -0.0114853, -0.00362816, 0.00315501, 0.00163183, -0.0575549, 0.0241861, -0.0434713, 0.0236635, -0.0102291, -0.0167499, -0.0582673, 0.0495249, -0.0209247, -0.0562479, -0.00813302, -0.00382479, -0.0126986, 0.0603363, -0.00468807, 0.0178567, 0.0729393, 0.0320952, 0.0141809, -0.121689, 0.00300093, 0.00362001, -0.0873312, -0.0146198, -0.00138804, 0.0607447, -0.129621, 0.00194986, 0.0205211, -0.0240821, -0.0170987, -0.0525235, 0.0380799, -0.00868101, -0.0084841, 0.0499737, -0.0109796, 0.00808091, -0.0173456, -0