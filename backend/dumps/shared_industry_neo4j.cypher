MERGE (c:`Chunk` {`id`: '096770-0029-63211535'}) SET c += {`text`: '[SK이노베이션] 3. 원재료 및 생산설비 > [SK지오센트릭㈜] > 나. 원재료 공급 시장의 독과점 정도\n- 일반적으로 납사시장의 경우, 수입 원유를 국내 정유사에서 생산한 제품을 도입하    거나, 경우에 따라서는 중동 및 인도 지역의 정유사를 통해 수입하고 있습니다.\n- 수입납사의 경우 장기계약 및 Spot 거래를 통해 공급 받게 되며, 제품의 가격차이\n가 발생할 경우 역외 거래(Arbitrage, 주로 유럽산)가 가능한 특성이 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [SK지오센트릭㈜] > 나. 원재료 공급 시장의 독과점 정도', `idx`: 29} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0264896, -0.00947497, 0.0242005, -0.000975706, -0.0557622, 0.0361495, 0.00658708, 0.0476028, 0.0749552, 0.0287986, 0.0594767, 0.0623901, -0.0422909, 0.00233452, 0.0375553, -0.0127092, 0.0151764, -0.0478217, -0.0291472, 0.0581975, -0.0446183, 0.0176205, -0.0408715, -0.0601225, 0.0632936, -0.02139, 0.0320386, 0.0279977, -0.0153584, -0.00869897, 0.00424474, -0.000512306, -0.0201599, -0.0409684, 0.00885348, -0.0294476, 0.040295, 0.018356, -0.0320231, 0.0902806, -0.0122796, -0.0679879, 0.0644438, -0.0767885, 0.018829, -0.0228653, 0.00590849, -0.0612142, -0.0446258, 0.0337789, -0.0418595, 0.0173791, 0.0855249, 0.0359767, 0.0152868, 0.00597005, -0.0311903, -0.00487044, -0.0256474, 0.0597561, -0.0856211, -0.00907128, -0.0118516, 0.022041, 0.00256721, -0.0427829, 0.000971806, 0.0184461, -0.085748, -0.00406342, -0.0262812, 0.0284972, 0.0181748, 0.0358604, -0.0178955, -0.0275294, -0.0215256, -0.0113222, 0.0312622, -0.0338001, -0.0105131, 0.00453236, -0.0585478, 0.045265, 0.0123452, -8.80417e-05, -0.00435718, -0.00213472, 0.0136762, 0.00516363, 0.0154492, -0.0179885, -0.0537881, 0.0139746, -0.00786223, 0.00225132, -0.060901, 0.0570882, -0.00749216, -0.0668893, 0.00462337, -0.0677917, 0.0543945, -0.0584467, 0.080068, 0.0350081, -0.0478415, 0.0426277, -0.0766302, 0.00773331, 0.0276956, 0.021