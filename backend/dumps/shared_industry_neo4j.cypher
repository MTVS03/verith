MERGE (c:`Chunk` {`id`: '247540-0037-a6954d17'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > [ESS 시장]\nSNE리서치에서 발표한 자료에 따르면  따르면 글로벌 ESS 연간 시장규모는 2024년307Gwh에서 2030년 920Gwh까지 증가할 것으로 전망하고 있습니다. 특히 신재생 에너지 발전 확대로 전력망 안정화를 위한 Grid용 시장이 전체 85%를 점유하며 시장을 주도하고, AI 확대에 따른 Data Back-up용 UPS 시장도 급성장 추세에 있습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [ESS 시장]', `idx`: 37} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0116963, 0.046862, 0.0189941, -0.0456341, -0.0387451, -0.0435814, -0.0351689, 0.016855, -0.0192875, 0.0581361, 0.0594929, -0.0111959, 0.0261772, 0.00440481, -0.026119, -0.0308932, 0.0121467, -0.0662449, -0.0779317, -0.0535388, 0.0533599, 0.0276382, 0.0253325, -0.00540484, 0.060538, 0.0260216, -0.00815445, 0.0414866, -0.0260588, 0.0588187, -0.021946, 0.00434891, 0.0295707, 0.0689417, -0.0134465, 0.0340836, -0.0170288, -0.0540883, -0.0310536, -0.0623114, -0.0343795, -0.0515536, 0.0570849, -0.0354514, -0.0378719, -0.0167195, -0.037934, -0.0121141, -0.0413866, -0.00681466, -0.0353788, -0.0198085, 0.0301655, 0.0722621, 0.0789371, 0.0949722, 0.0125837, 0.0127174, -0.00435402, 0.0187349, -0.0449575, -0.0190842, 0.0100403, -0.0177081, 0.052847, -0.0452167, 0.0902082, 0.0340048, 0.0361773, 0.0299252, 0.00368918, 0.0361065, 0.0404582, 0.0436909, -0.00924066, -0.0186142, 0.0165435, -0.054557, 0.0125577, -0.0190758, 0.0117787, -0.00700366, -0.0285409, 0.0137012, -0.0823417, -0.0730056, -0.0308188, 0.00535767, -0.00122899, -0.0479693, -0.0139695, -0.0364665, -0.00130962, 0.01355, -0.0114341, 0.0426089, -0.0146822, -0.0519128, -0.0453627, 0.0301673, 0.0296055, -0.0136937, -0.00637352, 0.031593, -0.0261843, -0.0212817, 0.0135683, -0.027727, -0.0184647, -0.0228235, -0.0487624, -0.0414218, 0.0282415, 0.0515082, -0.0494193, -0.0280274, 0.046137, -