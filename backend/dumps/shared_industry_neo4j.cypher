MERGE (c:`Chunk` {`id`: '006400-0036-5d219eb1'}) SET c += {`text`: '[삼성SDI] 7. 기타 참고사항 > 나. 환경물질의 배출 또는 환경보호와 관련된 사항 등\n에너지 사용량 (단위 : TJ)\n10,602\n11,012\n11,648\n※ 별도기준으로 작성되었습니다.\n※ 온실가스 배출량 및 에너지 사용량은「온실가스 배출권의 할당 및 거래에 관한\n법률」제24조 제1항에 따라 정부에 제출하는 명세서 기준으로 기재하였습니다.\n※ 2023년 및 2024년 온실가스 배출량 및 에너지 사용량은 외부 검증기관 검증을\n완료한 수치이나  전자재료 부문의 편광필름 사업 양도에 따라 배출량을 재작성\n하였습니다.\n※ 2025년 온실가스 배출량 및 에너지 사용량의 경우 잠정 집계된 수치로  기재하였\n습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 나. 환경물질의 배출 또는 환경보호와 관련된 사항 등', `idx`: 36} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0441915, 0.0548645, -0.0147271, -0.0285851, -0.116889, -0.0527309, -0.00418256, 0.0179219, -0.0649383, 0.0108967, 0.0391056, 0.0289012, 0.0485098, -0.0207025, 0.0287891, -0.0344741, 0.00585251, -0.0556124, -0.0496944, 0.0180734, 0.0587878, -0.0104983, 0.00934297, 0.0256641, 0.0180245, -0.0218315, 0.00420781, -0.0229099, 0.0409428, 0.073523, -0.0124845, -0.0369979, -0.0169295, 0.00547672, -0.0447069, -0.030604, 0.00658187, -0.000706912, -0.0343447, 0.00238764, 0.00947794, -0.0859796, 0.0363436, -0.0277809, 0.0414116, -0.013242, 0.0156768, 0.00306574, -0.0137204, 0.0367069, -0.013769, -0.0328774, 0.0228033, -0.0649842, -0.0138604, 0.0884803, -0.0767843, 0.0264148, -0.044949, 0.0159063, -0.0464723, -0.0152498, -0.0430056, -0.0390599, -0.011359, -0.0519733, 0.0355948, 0.0222873, 0.0464472, 0.0687518, 0.0220009, -0.0548638, 0.0428841, 0.0114482, -0.00212141, 0.00821427, -0.0159058, 0.0415732, 0.0339973, -0.0142091, 0.0181017, -0.000953988, 0.00198883, -0.0152693, 0.0283108, -0.0452803, -0.0471336, 0.0447967, 0.00578214, 0.00832057, -0.0723644, -0.0239433, 0.0190154, 0.0820201, 0.0131558, -0.0658322, -0.0230962, 0.0479758, 0.0223205, -0.00529172, 0.0158884, -0.0376119, -0.0372541, 0.0085092