MERGE (c:`Chunk` {`id`: '247540-0027-d490b09f'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > 나. 법률/규정 등에 의한 규제사항\n정부나 지방자치단체의 법률, 규정 등으로 당사의 영업활동, 비용지출 또는 경쟁상의 지위 등 사업의 영위에 중요한 영향을 미치는 사항은 없습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 나. 법률/규정 등에 의한 규제사항', `idx`: 27} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0629445, 0.00464656, 0.0170298, -0.0586015, -0.0440603, -0.0705392, 0.00652726, 0.0857667, -0.0613939, 0.0108452, -0.00468451, 0.0175459, 0.00338128, -0.0271834, -0.0270286, 0.0240622, 0.0193202, 0.0205946, -0.052261, -0.0384629, -0.0682933, -0.0579308, -0.0238867, -0.00528348, 0.0668648, 0.0353733, 0.00397286, -0.0121538, 0.000265526, 0.0202029, -0.0419368, 0.0116568, 0.0319968, -0.0440722, 0.0389278, 0.0183965, -0.0144095, 0.0230003, -0.0202839, 0.0825515, -0.0123692, 0.00807266, 0.011081, -0.0087119, 0.0077337, -0.0416849, -0.0226141, -0.0235456, -0.0207941, 0.00748557, -0.0117367, -0.0347096, 0.0163252, -0.0924515, 0.000724327, 0.094643, 0.00625543, -0.0674769, -0.04337, 0.0151801, -0.0191582, -0.0630975, 0.0158125, -0.0707267, 0.051408, -0.0321641, 0.0114276, -0.0544387, -0.0114527, 0.0317444, -0.00404561, -0.0271114, -0.00403617, -0.0231588, -0.0731165, -0.000149861, -0.0619194, 0.0088504, 0.0614436, 0.0441124, -0.0220372, -0.0367316, 0.0935126, 0.0149597, 0.0383691, 0.0423827, -0.026166, -0.0474892, 0.0157702, -0.00861517, -0.00153715, -0.0615247, 0.0260265, 0.0403406, 0.0765793, 0.0249234, -0.0251981, -0.0210032, 0.0233048, 0.0404268, -0.0349254, 0.0751067, 0.0257498, -0.0825156, 0.0254978, -0.0317809, 0.00198451, 0.0328341, 0.0147027, 0.0335969, -0.0386665, -0.0161892, 0.00992046, -0.00661582, 0.0257563, -0.0143569, 0.0556559, -0.00522276, -0.0126128, 0.00602595, -0.0134806, -0.00907642, 0.034838, -0.00439975, 0.01