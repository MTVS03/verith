MERGE (c:`Chunk` {`id`: '006400-0044-96edf3c1'}) SET c += {`text`: '[삼성SDI] 7. 기타 참고사항 > 라. 사업부문별 주요 재무정보\n첨단 제조 생산 세액공제 제도 및 2023년 12월 14일에 발표된 관련 Proposed Re\ngulation에 따라 당사는 미국내에서 생산, 판매한 배터리에 대한 세액공제를 적용\n받을 것으로 판단하였으며, 당기 중 수취할 것으로 예상되는 금액을 기타영업수익\n으로 인식하였습니다.\n※ 제56기 영업손익의 비중은 음의 숫자로 산출되어 기재하지 않았습니다.\n(2) 공통자산 및 비용의 배부기준\n① 공통자산의 경우 직접 귀속이 가능한 자산 (재고자산, 유형자산, 투자자산 등) 은\n각 사업부문에 직접 귀속시키고, 전사 공통관리가 필요한 자산 및 귀속이 불분명한 자산은 합리적인 배부기준 (매출액 등) 에 의거 각 사업부문에 배부하고 있습니다.\n② 공통 판매비와 관리비는 각 사업부문별 귀속이 명확한 경우에는 직접적으로 귀속시키고, 귀속여부가 불분명한 경우에는 별도의 배부기준(매출액 비율, 인원수 비율 등)으로 각 사업부문에 배부하고 있습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 라. 사업부문별 주요 재무정보', `idx`: 44} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.00706575, -0.0262853, 0.00780378, 0.00794034, -0.0904626, 0.0177736, 0.0547394, 0.0899576, 0.00806433, 0.0295647, 0.0177766, 0.0280363, 0.0482298, 0.0455628, -0.0252656, -0.0815447, 0.0165783, 0.0256837, -0.0709938, -0.0304097, 0.0212358, 0.0134414, 0.0119895, 0.0181305, -0.0176207, 0.000764852, -0.0237555, 0.0136017, 0.0192191, 0.046426, 0.017802, 0.0399416, -0.0506709, -0.0272423, -0.0367458, -0.0582333, -0.0391631, 0.0322307, -0.0476547, 0.0109489, 0.0177553, 0.0318003, 0.0720268, -0.103054, 0.0627295, 0.00607224, -0.0939985, 0.00635854, -0.0403887, 0.0146341, -0.00292989, 0.0126491, 0.0111678, -0.0424581, 0.0158304, 0.0444992, -0.068651, 0.00758464, -0.0471099, 0.052626, -0.00512215, -0.0634027, -0.0213534, -0.068015, 0.0738871, -0.0894122, -0.039276, -0.00109596, 0.00956231, 0.0577922, -0.00147682, -0.0391448, 0.0163949, 0.00523112, -0.0256377, -0.0135054, -0.00873082, -0.0464541, 0.0516063, -0.0699535, 0.0125965, -0.0315401, 0.0135634, 0.0134384, -0.044081, 0.0545232, -0.0156588, 0.0333928, -0.00053732, -0.0294087, 0.00552417, -0.008958