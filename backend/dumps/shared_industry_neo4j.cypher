MERGE (c:`Chunk` {`id`: '066970-0023-f1ea71bb'}) SET c += {`text`: '[엘앤에프] 1. 시장위험\nUSD 9,500,000\nUSD 389,691,781\n-\nUSD 411,519,178\n주1) 이자비용이 포함된 금액입니다.\n주2) 교환사채의 경우, 계약상 조기상환 가능시점을 만기로 하여 현금흐름총액을 표시하였습니다.\n3) 환위험\n① 환위험에 대한 노출\n보고기간말 현재 외환 위험에 노출되어 있는 연결회사의 금융자산ㆍ부채의 내역은 다음과 같습니다.\n(단위: 천원)\n구  분\n당기말\n전기말\nUSD\nJPY\n기타\nUSD\nJPY\n기타\n현금및현금성자산\n74,630,065\n3,231,410\n1\n9,032,723\n1,077,823\n541\n매출채권및기타채권\n334,449,715\n675,567\n9,429\n214,360,928\n1,810,369\n9,216\n당기손익-공정가치측정금융자산\n62,183,143\n-\n-\n44,100,000\n-\n-\n매입채무및기타채무\n(325,839,398)\n-\n(1,314)\n(71,659,019)\n-\n-\n단기차입금\n-\n-\n-\n(73,500,000)\n-\n-\n교환사채\n(545,262,000)\n-\n-\n(558,600,000)\n-\n-\n외환 금융자산ㆍ부채 순액\n(399,838,475)\n3,906,977\n8,116\n(436,265,368)\n2,888,192\n9,757\n당기말과 전기말에 적용된 환율은 다음과 같습니다.\n(단위 : 원)\n구  분\n평균 환율\n기말 환율\n제26(당)기말\n제25(전)기말\n제26(당)기말\n제25(전)기말\nUSD\n1,422.22\n1,363.98\n1,434.90\n1,470.00\nJPY\n9.5079\n9.0036\n9.1763\n9.3648\nCNY\n197.78\n189.20\n204.76\n201.27\nHKD', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 시장위험', `idx`: 23} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0238121, -0.0438238, 0.031578, -0.0105602, -0.0378464, 0.0469809, 0.0376986, 0.0503811, -0.0373876, -0.0118813, 0.0309031, 0.0451191, 0.0225671, -0.0208156, -0.0147127, -0.0144649, 0.0279568, -0.0211426, -0.0267125, -0.00312272, -0.0106043, -0.00558278, -0.0304824, -0.0010574, -0.00441149, 0.00403046, -0.0183055, -0.0393635, 0.0075607, -0.00232511, -0.00649332, 0.0349612, -0.00670065, 0.00660425, 0.00107989, 0.023377, -0.0212154, 0.0770316, -0.0342605, 0.0421064, -0.0235299, -0.0120974, 0.0297835, -0.0197389, 0.0302491, -0.0521198, 0.0335203, -0.0285067, 0.0137957, 0.0179702, -0.00152104, -0.0533773, -0.00211988, 0.012138, 0.0557015, 0.0160285, -0.0417056, 0.0444422, 0.006619