MERGE (c:`Chunk` {`id`: '247540-0036-544e61ff'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > [글로벌 전기차 시장 전망(~2035)]\n글로벌 전기차 시장 전망\n자료 : SNE리서치 (2024.12)\nSNE 리서치에서 발표한 자료에 따르면, 글로벌 전기차 판매는 2024년 1,650만대에서 2030년 4,199만대, 2035년에는 6,978만대까지 판매될 것으로 전망하고 있으며, EV용 배터리 수요는 2024년 834GWh 수준에서 2030년 2,277GWh, 2035년 4,394GWh까지 확대될 것으로 예상하고 있습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [글로벌 전기차 시장 전망(~2035)]', `idx`: 36} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0323931, 0.0132744, 0.0484771, -0.02655, -0.050706, 0.00698873, -0.07111, -0.0320434, -0.0611455, 0.00155936, -0.00786729, 0.0256126, 0.00836599, -0.0213038, -0.0430077, -0.0257526, 0.029046, -0.0922499, -0.0680796, -0.0375244, 0.0452171, 0.032828, 0.0164864, -0.0113673, 0.0389209, -0.0201928, -0.0488374, 0.00741339, -0.0314499, 0.0488493, -0.0131693, -0.0132711, 0.0187833, 0.0740785, -0.0303175, 0.0299288, -0.0205266, -0.00320177, -0.0328301, -0.0154414, 0.0150699, -0.0625177, 0.06723, -0.0301383, -0.111556, -0.00375209, -0.0670569, -0.0425674, 0.00744623, 0.00908435, -0.0504835, -0.00875707, -0.0141476, 0.112513, 0.0172029, 0.0861055, 0.0186937, -0.00947054, -0.0758001, 0.0131268, -0.0889629, -0.00984643, 0.0324223, 0.00695686, 0.0506484, 0.000704182, 0.0432925, 0.0222622, 0.0410798, -0.015642, -0.0259647, 0.0201393, 0.0702631, 0.0374248, -0.0028626, -0.0345105, -0.0285966, -0.0196182, -0.0112864, -0.0525525, 0.0262972, -0.0161078, -0.0187035, -0.0315401, -0.00754308, -0.0530387, -0.00756607, 0.0149683, -0.0427603, 0.0179953, -0.0628906, -0.0223368, 0.0612562, -0.0164419, -0.00146203, -0.0207015, -0.0742646, -0.0580569, -0.0192982, 0.0286936, 0.00982436, -0.00158537, -0.0200944, 0.0401757, -0.0328212, -0.0353317, 0.0146002, -0.0405045, -0.015402, -0.00456126, -0.0865749, -0.076