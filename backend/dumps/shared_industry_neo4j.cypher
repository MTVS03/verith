MERGE (c:`Chunk` {`id`: '003670-0042-204a943b'}) SET c += {`text`: '[포스코퓨처엠] 7. 기타 참고사항 > [PT.KRAKATAU POSCO FUTUREM ]\n포스코의 인니제철소 사업파트너 PT-krakatau Steel의 자회사인 PT.Krakatau Sarana Infrastrutur사와 8:2(포스코퓨처엠 : 80%, PT.Krakatau Sarana Infrastrutur : 20%)의 비율로 지분을 투자하여 인니에 설립된 해외법인으로, 생석회를 생산하여 인도네시아 일관밀 PT-KP(PT.Krakatau Posco) 제강 공장에 공급중에 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [PT.KRAKATAU POSCO FUTUREM ]', `idx`: 42} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00336803, -0.0210459, -0.0044825, 0.0416447, -0.0529397, 0.0463956, -0.00163897, 0.0116191, -0.0214861, 0.068375, 0.0283924, 0.00581959, -0.0214268, 0.0267071, 0.0322534, -0.0143417, 0.0384296, 0.0261937, 0.0150095, 0.0881246, 0.0518349, 0.0217407, 0.0130264, 0.00818415, 0.0204678, -0.0115522, 0.0637825, 0.121894, 0.0192327, -0.0122795, 0.0620351, 0.0287749, -0.0195596, -0.0237886, 0.0279512, 0.00168223, 0.0815477, -0.0116566, -0.0355895, 0.0461701, -0.0453535, -0.0498964, -0.030534, 0.00237323, 0.0475536, -0.0135435, -0.0594073, 0.0191268, 0.000277619, -0.0140681, -0.0744448, 0.0500457, -0.0242815, 0.0147362, -0.00183778, 0.0141508, -0.0760356, 0.0354131, -0.038989, 0.0475654, 0.0188922, -0.0289526, 0.00169176, -0.0603922, -0.0214814, -0.00349249, -0.00573085, -0.029897, 0.0127679, 0.0580548, -0.0342956, -0.04803, 0.00330128, -0.00719181, -0.0186481, -0.0057326, -0.0202841, 0.00620114, -0.00121814, 0.0108219, 0.0570543, -0.0382111, 0.00476345, 0.0809774, -0.0207545, 0.00652454, -0.0461154, 0.00572012, -0.000311114, -0.0353599, 0.0123939, -0.0726914, -0.0710472, 0.0688628, -0.0248922, 0.031904, -0.00952615, 0.0357588, -0.013811, -0.0593075, -0.0502589, -0.0302415, 0.040186, -0.0526131, -0.0553278, -0.0108667, -0.0874652, -0.0108502, -0.0190118, -0.0332531, 0.086569