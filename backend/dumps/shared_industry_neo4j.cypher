6, -0.00855682, 0.0169446, -0.0229538, -0.00577842, 0.02597, 0.0126603, -0.0261802, -0.0107547, -0.021557, -0.0233835, 0.0085293, -0.0016785, -0.00941123, -0.0554691, 0.0285328, 0.00295472, 0.00975786, -0.00472727, -0.0389487, 0.00529972, 0.0109299, 0.027337, 0.0283189, -0.016761, 0.0437479, -0.0603282, -0.0267647, 0.021378, 0.0188776, -0.0320097, -0.0214425, 0.0191793, 0.0134281, 0.0433517, 0.00193427, -0.00832408, 0.0050529, 0.00088984, -0.0451403, -0.00325144, 0.0151135, 0.0125293, -0.0329293, 0.0134461, -0.0242951, 0.0319034, 0.0461546, 0.00469939, 0.00890316, -0.00918159, 0.0249218, 0.00762641, 0.0278824, 0.0298126, 0.00155812, -0.0133132, 0.0156193, 0.00864168, -0.00566515, 0.00150545, -0.0297535, -0.0334187, 0.0226593, -0.0276103, 0.0426821, -0.00954748, 0.0226417, 0.026662, 0.016273, 0.0437446, 0.0257387, 0.0218069, -0.0192554, -0.00524319, -0.00966401, 0.0224442, -0.0603579, 0.00171645, -0.0138116, 0.0233803, -0.00166632, 0.0546471, 0.0232248, -0.0636881, -0.0287719, 0.0403857, 0.00373922, -0.0418374, 0.0363883, -0.0411409, 0.0330793]);
MERGE (c:`Chunk` {`id`: '086520-0068-4568e41c'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > [전지재료사업부문] > 라. 유동성 위험\n당사는 미사용 차입금 한도를 적정 수준으로 유지하고, 영업 자금 수요를 충족시키기 위해 차입금 한도나 약정을 위반하는 일이 없도록 유동성에 대한 예측을 항시 모니터링하고 있습니다. 보고기간말 현재 당사는 유동성위험을 관리하기 위해 사용가능한 차입금 한도 502,958백만원 (전기말: 546,000백만원)을 확보하고 있습니다.\n(1) 유동성 약정\n당사는 보고기간말 현재 다음의 차입금 한도 약정을 체결하고 있습니다.\n(단위: 천원)\n구  분\n당기말\n전기말\n- 1년 내 만기 도래\n529,625,040\n1,031,666,640\n- 1년 이후 만기 도래\n558,499,960\n114,166,600\n(2) 만기분석\n유동성 위험 분석에서는 당사의 모든 비파생 금융부채를 계약상 만기별로 구분하였습니다.\n유동성 위험 분석에 포함된 금액은 계약상의 할인되지 않은 현금흐름입니다. 금융보증계약 이외의 12개월 이내 만기가 도래하는 금액은 현재가치 할인의 효과가 중요하지 않으므로 장부금액과 동일합니다. 금융보증계약은 즉시 지급을 요구받을 수 있으므로 계약금액 총액이 3개월 미만 구분에 포함되어 있습니다.\n(단위: 천원)\n당기말\n3개월 미만\n3개월~1년\n1년~ 5년\n5년 초과\n총 계약상\n장부금액\n차입금\n6,231,982\n304,278,470\n111,946,048\n150,114,848\n572,571,348\n516,166,600\n매입채무\n9,160,567\n-\n-\n-\n9,160,567\n9,160,567\n미지급금(*)\n20,467,314\n3,419,996\n17,099,979\n13,679,983\n54,667,272\n42,828,502', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [전지재료사업부문] > 라. 유동성 위험', `idx`: 68} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0169539, 0.0331511, 0.00856264, -0.0431057, -0.0677304, 0.00238566, 0.0243138, 0.0372257, -0.02533, 0.0247755, 0.0262206, 0.0115049, 0.0643245, -0.00367563, -0.0318636, -0.010162, 0.0238606, 0.0143568, -0.0423803, -0.0210383, 0.0289015, -0.00683531, -0.0347305, 0.00272801, 0.016662, -0.0255445, -0.0791238, -0.0392457, 0.0450264, 0.0824307, 0.0320438, 0.0766143, -0.0615875, 0.0126996, -0.0108563, -0.0129601, -0.00511535, -0.0700511, -0.0164432, 0.0834164, 0.0303456, 0.0100193, 0.030493, 0.0189626, 0.0347186, -0.0578191, -0.0214076, 0.00949386, -0.0485652, -0.000132358, -0.023191, -0.0821821, 0.0252929, -0.0133662, 0.07138, 0.00605952, -0.069407, -0.00167445, 0.10106, 0.0