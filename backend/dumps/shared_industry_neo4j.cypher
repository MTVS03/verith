MERGE (c:`Chunk` {`id`: '096770-0066-f28a693b'}) SET c += {`text`: '[SK이노베이션] 4. 매출 및 수주상황 > [SK온㈜] > 나. 판매경로 및 판매방법 등\n① 판매경로\n▶ 배터리사업\n국내 및 해외 생산법인에서 제품을 생산하며, 본사 및 해외 법인을 통해 고객社에 직접 판매\n▶ 석유사업\n- 수출 : 국내 생산업체(SK에너지(주), SK인천석유화학(주))에서 물품을 구매하여                  해외 수요처에 판매\n- 내수 : 국내 수요처에 해외 원료 도입에 대한 용역 제공, 원유 및 석유화학제품의                  보관, 취급, 출하 관련 용역 및 임대수익\n▶ 기유 및 윤활유사업', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [SK온㈜] > 나. 판매경로 및 판매방법 등', `idx`: 66} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0304958, 0.0523306, -0.0248928, -0.00330577, -0.0495071, 0.0310713, -0.00794062, 9.26864e-05, 0.0208055, 0.0599923, 0.0591453, 0.0382357, -0.00761653, -0.0192501, 0.00507819, 0.0340553, 0.0267279, -0.00889117, -0.0241123, 0.0169482, 0.0352928, 0.0335554, 0.0306864, 0.0353953, 0.0896793, -0.0831472, 0.00559014, 0.0560211, -0.0712602, -0.0274084, 0.0282528, 0.0255766, -0.0707798, -0.0285343, -0.0669736, -0.0457795, 0.0317728, 0.0898225, -0.0579913, 0.0645426, 0.0146736, 0.0158563, 0.0626199, -0.0390226, 0.00405782, -0.00228657, -0.029185, 0.0134749, 0.00707397, -0.000259365, -0.0520457, 0.0199317, 0.0259081, 0.0407581, 0.0472823, 0.0142773, -0.055329, -0.0163615, -0.0468098, 0.127827, -0.0327913, 0.020317, -0.0321113, -0.00286945, -0.0565011, -0.0114912, 0.000982697, -0.0161229, -0.0424508, 0.0162154, -0.0489812, 0.0404506, 5.19445e-05, -0.02924, 0.00634874, -0.0452344, -0.00929765, 0.00654021, 0.0390486, -0.0532689, -0.0735902, -0.00322704, -0.0502276, 0.0412949, 0.0107839, -0.0194881, 0.0189769, -0.0424794, 0.033781, -0.024098, -0.0214091, -0.0365916, -0.0787051, 0.0164755, 0.0326719, -0.027572, -0.0540141, 0.0232014, -0.0960426, -0.00866629, -0.0193904, -0.00568838, 0.0467076, -0.0530167, -0.0177473, 0.040713, -0.0156375, 0.046665