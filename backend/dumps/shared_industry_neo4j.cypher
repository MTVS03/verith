MERGE (c:`Chunk` {`id`: '096770-0129-46e0fa6a'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [SK아이이테크놀로지㈜] > 가. 파생상품 계약 및 그 계약에 관한 내용\nUSDPLN 3.80\nUSD 50\n(3,263)\n-\n(3,263)\n미적용\n합계\n(36,030)\n-\n(36,030)\n(주1)\n계약금액은 계약통화 기준 금액이며, 공정가치, 자산 및 부채는 원화 기준입니다.\n(주2)\n공정가액 평가주체는 거래처와 동일합니다.\n(주3)\n계약기간 만료 시점에 약정환율 대비 환율 상승 시 손실, 환율 하락 시 이익 발생하는 계약입니다.\n(주4)\n계약기간 만료 시점에 약정환율 대비 환율 상승 시 이익, 환율 하락 시 손실 발생하는 계약입니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [SK아이이테크놀로지㈜] > 가. 파생상품 계약 및 그 계약에 관한 내용', `idx`: 129} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.00149971, 0.0298768, -0.0653266, -0.00488572, -0.022976, 0.044843, 0.0242618, 0.0571466, 0.0334415, 0.0231308, 0.0422156, 0.0602309, 0.0122667, 0.0737813, 0.0170942, 0.0100833, -0.0311732, -0.000510923, -0.0172199, 0.00764768, 0.0132501, -0.0257909, -0.0321013, 0.0796632, 0.067046, -0.0333416, -0.0215651, -0.00104435, 0.0155422, 0.0324979, 0.030697, 0.0837536, -0.0344353, -0.0424191, 0.0111709, -0.0293047, 0.0267499, 0.0616173, -0.0411361, 0.0499394, -0.0116951, -0.00836848, 0.000828098, -0.0684692, 0.111197, 0.00731113, -0.00771284, -0.0382143, -0.0321161, 0.00989469, -0.00377731, -0.0778771, 0.0959833, 0.0446514, 0.080555, -0.0255768, -0.0278929, 0.0931012, 0.041316, 0.00292452, -0.0289458, -0.0229812, 0.00773472, -0.0289911, 0.0225057, -0.0492751, 0.00311916, 0.0516089, -0.00994367, 0.00113946, -0.0828893, 0.000337855, 0.0424442, 0.0789304, -0.0401392, 0.0441109, 0.017744, 0.0292694, 0.0534281, -0.00817017, 0.0198031, 0.0660888, 0.0148299, 0.0451551, -0.037787, 0.0344815, -0.0338134, 0.00250226, 0.019186, -0.0350872, -0.0186, 0.010252, -0.0118191, 0.0476712, -0.0104346, -0.0245091, -0.0632311, 0.0266219, -0.0331654, 0.00239462, -0.0341966, 0.00783478, 0.0213774, -0.015501, -