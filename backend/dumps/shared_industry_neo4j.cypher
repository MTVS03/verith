MERGE (c:`Chunk` {`id`: '086520-0063-2fc1a7e1'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 재무위험관리\n1) 재무위험관리요소\n회사가 노출되어 있는 재무위험 및 이러한 위험이 회사의 미래 성과에 미칠 수 있는 영향은 다음과 같습니다.\n위험\n노출 위험\n측정\n관리\n시장위험 - 환율\n미래 상거래\n기능통화 이외의 표시통화를 갖는 금융자산 및 금융부채\n현금흐름 추정\n민감도 분석\n통화선도\n시장위험 - 이자율\n변동금리 장기 차입금\n민감도 분석\n이자율스왑\n신용위험\n현금성자산, 매출채권, 파생상품, 채무상품\n연체율 분석\n신용등급\n은행예치금 다원화, 신용한도\n유동성위험\n차입금 및 기타 부채\n현금흐름 추정\n차입한도 유지\n위험관리는 이사회에서 승인한 정책에 따라 재무부서의 주관으로 이루어지고 있습니다. 재무부서는 영업부서들과의 긴밀한 협조하에 재무위험을 식별하고 평가하고 관리합니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 재무위험관리', `idx`: 63} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0100107, -0.0162559, 0.0396345, -0.0084457, -0.0910141, 0.00127158, 0.0167947, 0.0301131, 0.00075793, 0.049233, -0.0637614, -0.0189458, 0.0205712, 0.0441199, 0.0147203, -0.0107878, 0.0336228, -0.00751012, -0.012265, 0.00825905, -0.0151887, -0.0551626, -0.0171453, -0.0358561, 0.0261176, 0.00389886, -0.0436478, -0.0272605, 0.0274017, 0.0950677, -0.000602234, 0.0304713, -0.0666149, -0.0101147, 0.00123254, -0.00160659, -0.0225397, 0.0445777, -0.0331773, 0.0379106, 0.0194413, 0.0305871, 0.0648618, -0.0151244, 0.0343739, -0.0340972, -0.00417145, -0.0384021, -0.0418158, -0.0364072, -0.093832, -0.0328793, 0.00950636, 0.016337, 0.000783294, -0.0126833, -0.00921235, -0.0416069, -0.00949972, 0.0210083, 0.0386396, -0.0449817, 0.0587166, -0.0309411, 0.0254957, -0.041966, -0.020337, -0.00133371, 0.00231792, 0.0448663, 0.0241144, 0.00975056, 0.0279557, 0.0293824, -0.0441032, 0.0234005, -0.0230705, 0.0399432, 0.0607834, 0.0281692, -0.0457697, -0.00777282, -0.00331073, 0.0190378, -0.00264458, 0.104199, -0.0341688, -0.0127672, -0.0174862, -0.0495072, -0.0438574, -0.0633413, -0.00830607, -0.0256403, 0.0532974, 0.00548099