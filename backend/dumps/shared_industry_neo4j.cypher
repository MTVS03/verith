MERGE (c:`Chunk` {`id`: '086520-0132-8af28dad'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [환경산업 특징] > 라. 국내외 시장 여건\n수처리 사업은 정부의 물환경관리 법률 및 정책 기준 강화 및 산업별 맞춤형 수처리 수요에 따라 변화가 발생합니다. 이차전지 산업 공정에서 발생하는 고농도 ·염폐수 처리 등의 폐수 처리 공정에 대한 시장의 관심과 요구가 지속적으로 증가하는 추세입니다. 정부의 물환경 보존을 위한 폐수배출시설 및 배출의 엄격하고 복잡한 규제가 지속됨에 따라 환경 규제 준수를 위한 고객사의 수처리 설비 시설 투자가 구조적으로 증가함에 따라 대한 꾸준한 미래 수요가 예상됩니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [환경산업 특징] > 라. 국내외 시장 여건', `idx`: 132} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.036769, -0.0323544, -0.000489562, -0.0317846, -0.0136264, -0.00657147, -0.0879166, 0.125558, -0.0785825, 0.0205712, 0.0225676, 0.0110824, 0.00332945, -0.000460353, 0.0254225, -0.0237718, 0.0363108, 0.00456137, -0.0140841, -0.0151213, 0.000625287, -0.0285448, 0.0161192, -0.0632997, -0.0237809, 0.0710547, -0.0801064, -0.0463284, -0.0269682, 0.0150316, 0.00504638, 0.0771129, 0.0155615, -0.0259874, 0.0272412, -0.00979289, -0.00306244, -0.0338661, -0.048113, 0.0348672, 0.0756559, -0.0123907, -0.0103753, 0.00511076, -0.00633645, -0.0178849, -0.0638958, 0.0109706, -0.0397887, 0.0424534, -0.0819354, -0.00906948, 0.00482343, -0.0503921, 0.0248487, 0.0423, -0.0247166, 0.0330744, -0.0180395, 0.0187001, -0.00376492, 0.00179978, 0.0501042, -0.0056206, 0.0994548, -0.031959, 0.0301185, -0.0479488, -0.0318285, -0.00312451, 0.0408358, 0.0125175, 0.0381956, -0.00276078, 0.0379139, 0.00743932, -0.0216235, 0.0230157, 0.0528566, 0.0318841, -0.064698, -0.0690726, 0.0574025, 0.0430234, -0.00294667, -0.0510519, -0.00508512, -0.0409752, -0.0274088, -0.0824166, 0.0409228, -0.056101, -0.0304386, 0.0028634, 0.0365992, -0.00939146, -0.0764863, -0.00764086, -0.0639866, -0.00609339, -0.06335, -0.00168541, -0.00230752, -0.0191067, -0.0544446, 0.000146708, 0.039989, 0.00018269