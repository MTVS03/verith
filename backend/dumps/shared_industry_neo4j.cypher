MERGE (c:`Chunk` {`id`: '348370-0010-c0f96999'}) SET c += {`text`: '[엔켐] 4. 매출 및 수주상황 > 나. 판매경로 및 판매방법 등\n1) 판매경로\n당사의 주요 매출처는 글로벌 2차전지 배터리 제조사 및 EDLC 제조업체등이며, 당사에서 거래처에 제품을 직접 생산.공급하고 있습니다.\n2) 판매 방법 및 조건\n당사는 전해액 등을 직접생산하여 내수 및 수출 판매를 하고 있으며, 현금등으로 대금을 결제 받고 있습니다.', `company`: '엔켐', `stock_code`: '348370', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260326001049&dcmNo=11183261&eleId=9&offset=70916&length=79058&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 나. 판매경로 및 판매방법 등', `idx`: 10} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0251007, 0.00821586, 0.0323474, -0.00565689, -0.0362054, 0.0379447, -0.00826339, 0.0379124, -0.0228184, 0.056123, 0.0327447, 0.0644756, -0.00747808, -0.0305694, -0.0198987, 0.023727, 0.00361941, -0.010311, -0.037375, -0.0270365, -0.0231703, 0.0241088, 0.050781, -0.0147746, 0.0738177, -0.0222416, -0.0380261, 0.00136223, -0.0662857, -0.0357867, 0.00176148, 0.00929955, -0.0381614, -0.00981919, -0.0350742, 0.0269144, 0.0119863, 0.0366948, -0.0588676, 0.0356941, 0.0546636, -0.00912419, 0.0426813, -0.0316462, -0.0108383, -0.00714829, -0.0293809, -0.0556503, 0.044173, -0.0060226, -0.0882522, 0.0118806, 0.0215279, 0.0212845, 0.0415436, 0.0542287, -0.10891, -0.0156829, -0.024549, 0.0371545, 0.0342949, -0.0173724, 0.000287233, 0.047185, -0.0355016, 0.0120883, -0.00203496, -0.0343993, -0.0336788, 0.022027, -0.0309432, -0.0370117, -0.0249963, -0.0417874, -0.00380716, 0.0402613, 0.00689132, 0.0244803, 0.0483718, -0.0934961, -0.0376837, -0.0543242, -0.0173944, -0.0132726, -0.0205282, 0.00667686, -0.0227741, 5.83241e-05, -0.0389526, -0.0468473, -0.0211766, -0.029539, -0.0303074, 0.0140784, 0.0329967, 0.010443, -0.0413026, -0.00878047, 0.00215309, -0.00420195, -0.0423387, 0.0522184, 0.0209827, 0.0243127, 0.00825071, 0.0273803, -0.0508433, 0.010164, -0.0591444, 0.0437467, 0.0130768, -0.0316752, 0.0379677, -0.00888531, -0.0290084, -0.0602672, -0.045785, -0.00388605, 0.00539