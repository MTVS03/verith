MERGE (c:`Chunk` {`id`: '247540-0009-5988c11b'}) SET c += {`text`: '[에코프로비엠] 3. 원재료 및 생산설비 > 나. 생산 및 설비\n129,780\n493,268\n182\n9,397\n23,873\n증감\n44,418\n14,065\n37,296\n10,682\n(16,799)\n(54)\n(1,854)\n1,082\n기말\n1,008,585\n85,944\n273,084\n140,462\n476,470\n128\n7,542\n24,955\n주) 주요 물적자산에 관한 시가 등의 정보는 객관적인 자료를 파악할 수 없어 기재를 생략하였습니다.\n3) 향후 투자계획\n당사는 시장 변화에 유연히 대응하고, CRMA 및 TCA와 같은 지정학적 리스크를 최소화하기 위해 국내를 넘어 유럽 현지 내 양극재 생산시설을 확보하고자 하며, 시장 수요에 맞춰 보다 유연한 생산능력을 갖출 계획입니다. 이에, 당기에는 헝가리 등 해외 양극재 공장을 완공하였으며 향후 수요에 맞추어 추가 증설할 계획입니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > 나. 생산 및 설비', `idx`: 9} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0303509, -0.00402459, 0.00386069, -0.00552448, -0.0552662, -0.016299, -0.0618642, 0.0683756, -0.0536222, 0.0246258, 0.0501689, 0.0596437, 0.024324, -0.00733146, 0.0417279, -0.062286, 0.0338637, -0.0523977, -0.0475938, -0.00126989, -0.000764283, 0.00763372, 0.0338501, -0.038042, 0.0446902, -0.000955514, 0.0352925, 0.0245882, 0.00780633, 0.0656414, 0.00407275, 0.00559335, -0.0311601, 0.0478937, 0.0607573, -0.00801504, -0.0176815, -0.0173997, -0.0386339, 0.0434833, 0.0339166, 0.0150909, 0.053153, -0.021649, 0.00948705, -0.0473397, -0.0262249, -0.0331476, 0.0123952, -0.0576649, -0.0690637, 0.00973786, 0.01011, -0.0101289, -0.00127108, 0.0348345, -0.129746, -0.0340019, -0.0102741, 0.0477466, -0.0522926, -0.0292998, 0.00138451, -0.0281868, 0.0849395, -0.0620172, 0.000236435, 0.0153352, -0.00813782, -0.00916969, 0.0225171, 0.0576536, -0.0163492, -0.0420899, 0.00192961, -0.0544424, -0.0547836, -0.0515652, 0.0521938, -0.0378508, 0.0529073, -0.016095, 0.0017156, 0.0161389, 0.0386478, -0.0237669, -0.0556123, 0.00174429, -0.0299837, -0.052002, -0.0382793, -0.0323212, -0.0118823, -0.00138904, 0.0345224, 0.00058