MERGE (c:`Chunk` {`id`: '247540-0026-0a161de5'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > 가. 지적재산권 보유현황\n당사는 이차전지 양극소재 사업과 관련하여 다음과 같은 지적재산권을 보유하고 있습니다.\n구 분\n특허 총계\n등록\n157\n출원\n-\n합계\n157\n※ 이차전지 양극재 사업의 관심집중에 따른 기술, 정보유출 우려 등을 감안하여 특허 출원에 관한 세부 내용은 기재를 생략합니다.\n※상세 현황은 \'상세표-4. 지적재산권 보유현황(상세)\' 참조', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 가. 지적재산권 보유현황', `idx`: 26} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0416739, 0.00785973, 0.000110488, -0.0404288, -0.0400195, -0.0553039, -0.0244699, 0.0614699, -0.00130599, 0.00218548, -0.00393277, 0.0431934, 0.0293933, 0.024175, -0.052848, -0.0247219, 0.0092031, -0.0145912, -0.0601233, -0.0317364, 0.0536553, -0.040426, 0.0270161, -0.0103944, 0.0337905, -0.00630388, -0.0199226, 0.0297374, -0.0231585, 0.0345931, -0.0260819, -0.0248044, -0.0187868, -0.0267672, -0.0648267, 0.00878983, -0.0303377, -0.0402373, -0.0149935, 0.035711, 0.00720632, 0.0301233, 0.0370497, -0.0577154, 0.0206705, -0.0413665, 0.00751579, -0.0432797, 0.0228547, 0.000974556, -0.0417791, -0.00904585, 0.0158395, -0.0192941, 0.000244439, 0.00784134, -0.0715898, -0.0119846, 0.0149879, -0.0368486, -0.0280385, -0.0652668, -0.0283611, -0.0638314, 0.0246162, 0.0126481, 0.0345228, 0.023951, 0.0345733, 0.0322472, 0.00370511, -0.00990844, 0.00654338, -0.0586665, 0.0269476, 0.00243041, -0.0112719, -0.0153956, 0.0389893, 0.0249366, 0.0481468, -0.0244879, -0.0309148, 0.0534415, 0.0378101, -0.0409804, -0.0771741, 0.0181396, -0.0167014, -0.01632, -0.065169, -0.0601838, 0.0244261, 0.0260118, 0.0766651, 0.0110366, -0.0429901, -0.0075093, 0.0318955, 0.0377375, -0.048488, 0.0326411, -0.0297197, 0.000762447, -0.00600773, -0.00789741, 0.0359131, 0.0122081, 0.0184889, 0.0299012, -0.0641133, -0.0741232, 0.0633447, 0.0184047, -0.0110216, -0.02327