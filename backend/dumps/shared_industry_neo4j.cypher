MERGE (c:`Chunk` {`id`: '066970-0001-8f1068a6'}) SET c += {`text`: '[엘앤에프] 1. 사업의 개요\n연결회사는 양극활물질 사업부문 총 1개의 사업부 체제로 운영되고 있습니다.\n사업부문\n주요 제품\n구체적 용도\n매출비중\n양극활물질\n양극활물질 등\n2차전지용 양극활물질\n100.00%', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 사업의 개요', `idx`: 1} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0362497, 0.050882, 0.0211005, -0.00970823, -0.00533737, 0.0056492, 0.0200589, 0.068532, -0.0282431, -0.00212036, 0.00976081, 0.0327544, 0.0298389, 0.0144701, -0.0135191, -0.000655687, 0.0239104, -0.0334622, -0.000454039, -0.0450703, 0.00557058, 0.0120858, -0.0251362, 0.0516513, -0.0170169, -0.0172615, -0.0260307, 0.00121156, -0.0867245, 0.008014, -0.0365072, -0.0453424, -0.0816603, -0.00500207, 0.0434713, -0.0187223, 0.00496191, 0.0375463, -0.0559123, -0.0163695, -0.00381386, 0.0317927, -0.0127486, -0.0493502, -0.0274939, -0.000574385, -0.00295897, -0.0244065, -0.00526297, 0.00544733, -0.0561524, 0.0267949, -0.0247084, 0.0127455, 0.00190076, 0.0172355, -0.113008, -0.0519189, -0.0316021, 0.0148599, 0.00507533, 0.0142008, 0.0667284, 0.0256445, 0.021603, -0.0414634, -0.0228454, 0.027119, -0.00175746, -0.00177455, -0.0320471, 0.00738578, 0.0125643, 0.0231414, 0.0406616, 0.0522258, -0.0108985, -0.0648411, 0.0548271, 0.0156201, -0.016429, 0.0139352, -0.0499493, 0.0294529, 0.0332397, -0.0168919, -0.0653536, 0.0466036, -0.0461965, -0.0672911, -0.0490833, -0.0276683, 0.0121407, 0.0551677, 0.0204945, 0.0585684, -0.0337227, 0.00602648, 0.0605473, -0.0133997, -0.00242148, -0.00177051, -0.0219979, -0.00593028, -0.00876807, 0.0135511, -0.031385, 0.0156804, 0.0073785, -0.0586469, -0.00872663, -0.0139715, 0.0355822, 0.0319577, -0.0349136, -0.0180139, -0.032499, 0.0241718, 0.0493838, -0.0100493, -0.0527884, 0.00170773, -0.0156601, 0.0187134, -0.031335, -0.1