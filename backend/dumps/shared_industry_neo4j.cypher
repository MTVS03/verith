MERGE (c:`Chunk` {`id`: '096770-0015-4bf198cb'}) SET c += {`text`: '[SK이노베이션] 2. 주요 제품 및 서비스 > [SK아이이테크놀로지㈜] > 나. 주요 제품 등의 가격 변동 추이\n- 당사 주요 제품의 가격은 고객사와의 계약에 따라 결정되어 영업기밀에 해당됩니다. 따라서 동 사항에 대한 세부 내용을 공시할 경우 당사의 영업에 현저한 영향을 미칠 수 있다고 판단하여 세부 내역은 기재하지 않았습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 주요 제품 및 서비스 > [SK아이이테크놀로지㈜] > 나. 주요 제품 등의 가격 변동 추이', `idx`: 15} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0410465, 0.0407817, -0.0721846, -0.00840856, -0.023652, -0.0504188, 0.0021559, 0.0491342, -0.00426002, 0.00788529, 0.0604585, 0.0209503, 0.012599, -0.0282468, -0.00563473, 0.0188565, 0.0217897, 0.0175738, -0.0465635, -0.0197063, -0.00592083, -0.0141164, -0.015799, 0.0750169, 0.117657, -0.0150142, -0.0369713, -0.0166361, 0.00824448, 0.0208354, 0.0657567, 0.00213457, -0.0405752, -0.030895, -0.0307283, -0.00420928, -0.000188174, 0.0292692, -0.0242162, 0.0858017, 0.0296132, 0.052801, 0.0500544, -0.0304717, 0.0519389, -0.0289949, -0.0220168, -0.00835837, 0.00143574, -0.00408724, 0.0263933, -0.0923867, 0.0341308, -0.00473527, 0.0605614, 0.0695056, -0.0554171, -0.0413541, -0.0151893, 0.0734069, -0.0307891, -0.00739712, 0.0472622, -0.0081517, 0.0392914, -0.0191738, 0.0482423, 0.0188334, -0.0272509, 0.000763935, -0.0212002, 0.0323352, 0.0202166, 0.0890654, -0.0287782, 0.0865168, -0.0129357, 0.057744, 0.00659875, 0.00916202, -0.0466898, 0.019173, -0.0294408, 0.0121266, 0.00268185, 0.0463734, -0.0172098, -0.00896081, 0.0514768, -0.0052315, 9.72541e-05, -0.0463099, -0.0146838, 0.0479333, 0.0565409, -0.0125512, -0.0739958, 0.0103661, -0.0268136, -0.00728005, -0.0449086, 0.00845934, 0.0814295, -0.0921941, 0.0400701, 0.039722, -0.0262326, 0.061048, 0.00996899, 0.0385404, -0.0171358, 0.00725477, -0.0226386, 0.0246594, 0.0376337, -0.0132384, -0.00943026, 