MERGE (c:`Chunk` {`id`: '096770-0171-f092f9d2'}) SET c += {`text`: '[SK이노베이션] 6. 화학 사업 > [회사의 현황- SK지오센트릭㈜]\n⑨ SK Geo Centric Singapore Pte. Ltd.\n- SK Geo Centric Singapore Pte. Ltd.는 동남아시아 지역 화학 제품 Trading 및 도매 업무를 수행하고 있습니다.\n⑩ Sino-Korea Green New Material（JiangSu）Ltd.\n- Sino-Korea Green New Material（JiangSu）Ltd는 기능성 접착 수지인 에틸렌 아크릴산(EAA)의 중국 내 생산 및 판매를 목적으로, 중국 장쑤성 롄윈강시 석유화학 단지 내에 웨이싱화학(STL)과 JV를 체결하여 설립되었습니다.\n(다) 사업부문별 주요 재무정보 비중(연결기준)\n① 매출비중\n(단위 : 백만원)\n구분\n제15기\n(2025년)\n제14기\n(2024년)\n제13기\n(2023년)\n금액\n비율\n금액\n비율\n금액\n비율\n기초유화사업\n9,279,718\n71.59%\n10,530,366\n76.80%\n10,626,169\n75.39%\n화학소재사업\n3,682,870\n28.41%\n3,180,164\n23.20%\n3,468,911\n24.61%\n계\n12,962,588\n100.00%\n13,710,530\n100.00%\n14,095,080\n100.00%\n연결조정\n(1,461,206)\n-\n(964,308)\n-\n(1,079,458)\n-\n연결합계\n11,501,382\n-\n12,746,222\n-\n13,015,622\n-\n② 영업이익 비중\n(단위 : 백만원)\n구분\n제15기\n(2025년)\n제14기\n(2024년)\n제13기\n(2023년)\n금액\n비율\n금액\n비율\n금액\n비율\n기초유화사업\n(130,577)\n86.14%\n204,055\n-663.03%', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '6. 화학 사업 > [회사의 현황- SK지오센트릭㈜]', `idx`: 171} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0278062, 0.00557781, -0.0436057, -0.0738911, -0.022419, 0.030748, -0.0261214, 0.0453861, 0.0104732, 0.0784649, 0.0696046, 0.0842726, 0.0486244, 0.0272583, -0.0103397, -0.00189723, 0.00482532, 0.0168769, -0.0262429, 0.067349, -0.0249947, -0.0135034, -0.0244407, 0.0114126, 0.0614489, -0.0157804, -0.00113071, 0.0295973, -0.0494787, 0.0132998, -0.00636537, 0.000597346, -0.063849, -0.0302079, -0.013419, -0.00202696, 0.0280734, -0.0035137, -0.0987372, 0.0379014, 0.0313805, 0.023671, 0.0348591, -0.00600447, 0.0393381, 0.0174335, -0.0424009, 0.0224872, 0.00888119, 0.039463, -0.0474756, 0.019556, 0.0119814, 0.0355114, 0.0463642, 0.013757, -0.0575183, 0.0066