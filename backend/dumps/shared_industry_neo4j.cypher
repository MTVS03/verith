MERGE (c:`Chunk` {`id`: '086520-0105-d0fa177d'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [ESS 시장]\nSNE리서치에서 발표한 자료에 따르면  따르면 글로벌 ESS 연간 시장규모는 2024년307Gwh에서 2030년 920Gwh까지 증가할 것으로 전망하고 있습니다. 특히 신재생 발전 확대로 전력망 안정화를 위한 Grid용 시장이 전체 85%를 점유하며 시장을 주도하고, AI 확대에 따른 Data Back-up용 UPS 시장도 급성장 추세에 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [ESS 시장]', `idx`: 105} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0143481, 0.0518968, 0.0226069, -0.0339483, -0.0460792, -0.0374596, -0.0446135, 0.0137182, -0.0219101, 0.0549317, 0.0649853, -0.0138004, 0.0230063, 0.000573033, -0.0273336, -0.0323643, 0.0104429, -0.0625187, -0.0712931, -0.0636864, 0.0397086, 0.0312673, 0.02016, -0.00555407, 0.055337, 0.0297159, -0.00339204, 0.0380678, -0.0253377, 0.0556878, -0.0266234, 0.0113789, 0.0344712, 0.06687, -0.0156548, 0.0340282, -0.00740445, -0.0496917, -0.031824, -0.0621791, -0.0336918, -0.0579923, 0.0595599, -0.0316932, -0.0399456, -0.0106174, -0.0381959, -0.00676981, -0.0487099, 0.00291849, -0.0432505, -0.0211598, 0.0218754, 0.0631102, 0.071181, 0.0925596, 0.00409915, 0.0160587, -0.00443405, 0.0210183, -0.0485524, -0.00966449, 0.0079195, -0.00674813, 0.0500281, -0.044877, 0.0915541, 0.0274266, 0.0379076, 0.0322031, 0.00559787, 0.0398635, 0.0456462, 0.0490783, 0.00231438, -0.0204151, 0.0243448, -0.0622424, 0.0136502, -0.0254217, 0.0120967, -0.0100286, -0.0312484, 0.0115326, -0.0881916, -0.074695, -0.0245749, 0.00266081, -0.00232789, -0.0494761, -0.0183593, -0.0421001, -0.0128255, 0.0224313, -0.0180378, 0.048428, -0.0175493, -0.0455531, -0.0505139, 0.0252281, 0.029015, -0.0144875, -0.00549528, 0.0361633, -0.0282708, -0.0168192, 0.0191123, -0.02088, -0.0184968, -0.0262847, -0.0395744, -0.0405336, 0.0226268, 0.0476434, -0.0441886, -0.0291232, 0.04481, 0.004953