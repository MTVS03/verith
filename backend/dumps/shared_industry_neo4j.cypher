MERGE (c:`Chunk` {`id`: '096770-0033-75af6706'}) SET c += {`text`: '[SK이노베이션] 3. 원재료 및 생산설비 > [SK아이이테크놀로지㈜] > 가. 주요 원재료\n(1) 주요 원재료 등의 현황\n(기준일 : 2025년 12월 31일)\n(단위 : 백만원)\n사업 부문\n매입 유형\n품목\n구체적\n용도\n제7기\n(2025년)\n제6기\n(2024년)\n제5기\n(2023년)\n매입액\n매입액\n매입액\nLiBS\n원재료\n매입\nPE\n분리막\n생산\n11,202\n10,421\n51,586\n코팅원료\n7,605\n14,187\n38,225\n윤활기유\n9,884\n8,175\n23,523\n(2) 주요 매입처\n품목\n매입처\n특수관계 여부\nPE, 코팅원료 등\n대한유화 등\n미해당\n윤활기유\nSK온(주)\n해당\n(주1)\n주요 원재료인 PE는 대한유화 등 복수의 공급업체로부터 안정적으로 매입하고 있습니다.\n(주2)\n윤활기유는 SK온(주) (舊 SK엔무브(주)) 계열로부터 상당부분 공급 받고 있습니다.\n(주3)\n윤활기유 공급자인 SK엔무브(주)는 2025년 11월 1일 자로 SK온(주)와 합병하였습니다.\n(3) 주요 원재료의 가격변동추이\n- 당사 주요 원재료의 가격은 고객사와의 계약에 따라 결정되어 영업기밀에 해당됩니다. 따라서 동 사항에 대한 세부 내용을 공시할 경우 당사의 영업에 현저한 영향을 미칠 수 있다고 판단하여 세부 내역은 기재하지 않았습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [SK아이이테크놀로지㈜] > 가. 주요 원재료', `idx`: 33} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0201754, 0.030054, -0.0228122, 0.00194004, -0.0368758, -0.0604016, -0.00814715, 0.0129922, -0.0161265, 0.0209336, 0.0281807, 0.0175085, 0.0295485, 0.0313497, -0.0307882, 0.00545914, 0.018066, -0.0385401, -0.0210712, 0.022495, 0.0196634, -0.0246435, -0.00819645, 0.0347959, 0.116819, -0.0503335, -6.74776e-05, 0.0115718, -0.00767642, 0.0208404, 0.00472087, 0.0478045, -0.0647401, -0.00129989, 0.00815315, -0.043179, 0.0323499, 0.024283, -0.0321409, 0.0621218, -0.0375683, 0.024667, 0.0537452, -0.0332333, 0.0361045, 0.00226742, -0.027559, 0.0166754, -0.0190541, -0.0501867, -0.0366533, -0.00571485, 0.0381384, -0.0399304, 0.0875081, 0.0273109, -0.0629884, 7.84436e-05, 0.029792, 0.0650044, -0.0684392, 0.0250164, 0.0710019, 0.0121237, 0.0441659, -0.0485682, 0.00358296, 0.0552051, -0.0208669, -0.00249584, -0.053061, 0.088514, 0.0354081, 0.0466203, -0.0299613, -0.0155513, 0