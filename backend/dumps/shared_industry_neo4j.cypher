MERGE (c:`Chunk` {`id`: '361610-0024-3d24a805'}) SET c += {`text`: '[SK아이이테크놀로지] 7. 기타 참고사항 > [연도별 특허 및 실용신안 등록 건수]\n(단위 : 건)\n국가\n2025년\n2024년\n2023년\n2022년\n2021년\n한국\n33\n6\n5\n17\n34\n해외\n41\n40\n37\n19\n15\n- 또한 당사는 ENPASS 등 제품 및 서비스 브랜드 가치 향상 등을 위해 상표권을 보유 중입니다. 당기말 현재 당사가 보유하고 있는 국내외 상표권은 총 15건이며, 최근 등록되어 유지되고 있는 상표권 건수는 아래와 같습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [연도별 특허 및 실용신안 등록 건수]', `idx`: 24} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.017494, 0.0510659, 0.000716889, 0.00621982, -0.0292612, 0.0204302, -0.0125413, -0.0281676, -0.0260924, 0.011681, 0.0225021, 0.0460419, -0.016944, 0.0431777, -0.0205688, -0.0509486, -0.0142366, -0.0368604, -0.0743454, -0.0303621, 0.0965899, 0.0023259, -0.00224672, 0.00656566, 0.0493512, -0.0199924, -0.0174514, 0.0175357, -0.0451605, -0.0229257, 0.0237394, 0.012635, -0.0473364, -0.00453953, -0.015626, -0.0266291, 0.015976, -0.0353734, -0.0430791, 0.0361794, 0.0199359, -0.00694588, 0.0515628, -0.0629379, -0.00529476, 0.0306124, 0.00826888, 0.025686, 0.027311, -0.000120935, 0.0533606, -0.023248, 0.0122142, 0.005764, 0.00487595, 0.0358035, -0.0588591, 0.0588403, -0.0327681, 0.0583419, -0.0486039, 0.0193048, -0.0165375, -0.0825629, 0.0047917, -0.063359, 0.0473264, 0.00226651, -0.0509849, 0.00337027, 0.0531761, 0.00402467, -0.0135765, -0.00736803, -0.0674104, -0.0298862, -0.00871399, 0.0262371, 0.0310442, -0.0486516, 0.00348918, 0.040276, 0.0192238, 0.083772, 0.0314725, -0.0406619, -0.0273484, -0.0285875, 0.0489881, 0.0397282, -0.0214741, 0.0490924, -0.0591192, 0.0136029, -0.00671509, -0.021739, -0.0842549, 0.0222777, 0.0215788, -0.0533924, 0.025329, 0.0504378, 0.0111419, -0.00275513, 0.00860632, 0.0631592, 0.0118068, 0.038512, -0.0239102, 0.0547051, -0.0581281, 0.0208343, 0.02381