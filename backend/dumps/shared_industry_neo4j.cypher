MERGE (c:`Chunk` {`id`: '247540-0013-3ac42e32'}) SET c += {`text`: '[에코프로비엠] 4. 매출 및 수주상황 > 다. 수주상황\n당사의 수주 진행은 크게 2가지 유형으로 진행 됩니다. 구체적인 방식은 고객사와의 중장기 공급계약을 확약하고 계약 기간 중 확약된 계약 물량을 바탕으로 거래가 진행되는 방식, 그리고 수요업체와 기본 거래계약을 체결하고 1개월 전에 예상 구매량을 통보 받아 생산 납품하는 형식을 취하는 방식이 있습니다. 당사는 공시대상 기간 중 진행 기준 수익을 인식하는 수주계약 거래는 없습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 다. 수주상황', `idx`: 13} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0380352, -0.0275271, 0.00761331, 0.000534555, 0.000480287, 0.0452184, -0.00830743, 0.0671576, 0.011294, 0.0197554, 0.0398085, 0.0372668, 0.0376062, -0.00132821, -0.0209236, 0.0449597, 0.0281079, -0.0279231, -0.00496777, -0.0199016, 0.0200482, 0.0389309, 0.0554218, 0.0100437, 0.0617431, -0.0343755, -0.0287631, -0.00339512, -0.0320088, 0.0737347, 0.0272943, 0.0356507, 0.0043686, -0.0484932, 0.00388149, 0.00838134, 0.0161442, -0.0022424, 0.00232459, 0.0721122, 0.0133043, -0.0364358, 0.0416869, -0.0539932, 0.0388446, -0.0468841, -0.0154689, -0.0646479, -0.0214771, 0.0386812, -0.0492606, 0.006598, 0.027656, -0.0114207, 0.0391432, 0.0363523, -0.0374853, -0.0470778, 0.0195128, 0.0268055, -0.0507172, -0.031326, 0.0539812, 0.0335661, -0.00577553, -0.0607542, 0.00924523, 0.0342372, 0.00932706, -0.0203966, -0.033815, -0.0261405, -0.0218264, -0.00144774, -0.0111297, -0.0137521, -0.00507377, -0.00902256, 0.0162159, -0.0025404, -0.0484095, -0.0254435, -0.00140722, -0.0259323, 0.0208218, -0.0449191, -0.00638596, 0.00877322, -0.0702892, 0.0169485, 0.03976, -0.0728743, 0.0151943, -0.0219108, 0.0468768, -0.0511483, -0.10511, -0.0344496, -0.00645597, -0.0129906, -0.0605097, -0.0407982, 0.0519227, -0.0963229, -0.00222464, 0.0338246, 0.0400444, 0.0051637, -0.0363449, 0.0284129, 0.0149348, 0.00515464, 0.0691887, 0.0189151, -0.00732681,