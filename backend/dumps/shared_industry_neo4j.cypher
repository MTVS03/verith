MERGE (c:`Chunk` {`id`: '361610-0032-8c23a577'}) SET c += {`text`: '[SK아이이테크놀로지] 7. 기타 참고사항 > [연도별 상표권 등록 건수] > 라. 시장여건 및 영업의 개황 등\n- 이에 더하여, 당사는 회사의 사업 포트폴리오 확장 및 지속적인 발전을 위해 당사 보유 역량과 연계하여 에너지 저장, 로봇/휴머노이드 등 신규 성장 시장, 차세대 배터리 분야 등 유망 영역을 대상으로 다양한 기회를 검토 중입니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [연도별 상표권 등록 건수] > 라. 시장여건 및 영업의 개황 등', `idx`: 32} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0259703, 0.0653983, 0.000559605, -0.0195165, -0.032838, -0.0318735, -0.052958, -0.00289602, 0.00667355, -0.0459833, 0.085696, 0.00336636, -0.0421728, -0.00926409, 0.00371407, -0.0514931, 0.0233801, 0.0213253, -0.0726451, -0.049004, 0.0617287, 0.00379891, -0.0104072, 0.0275691, -0.0158338, -0.0288166, -0.0579777, -0.0020044, -0.00640627, 0.0254142, 6.20163e-05, 0.0291524, -0.045049, -0.0273576, 0.04166, -0.0614597, -0.0460389, -0.0183471, -0.0472563, 0.0342615, -0.00682669, 0.0369068, 0.100183, -0.077493, -0.00780512, -0.0370647, -0.0173211, -0.00192587, -0.0139468, -0.0179404, -0.0533152, -0.0326411, -0.0180591, 0.057013, -0.00366604, -0.00868566, -0.0604797, -0.0118617, -0.00490416, 0.0863173, -0.0404709, 0.0109535, 0.0253248, -0.0477015, -0.0348039, -0.0788277, 0.0517002, 0.0131247, -0.010445, 0.00234535, 0.048052, 0.00909646, -0.0227422, 0.00688755, -0.0764071, 0.0332029, -0.0418325, 0.00305397, 0.0417738, -0.0314407, -0.0473762, -0.00713481, -0.0142422, 0.0115081, 0.0264771, -0.0127408, -0.0591395, -0.00450846, 0.0648693, -0.00968717, -0.0260957, 0.0285114, 0.00617323, 0.0319427, -0.0366351, 0.0159788, -0.081571, 0.00356928, -0.0627785, -0.00377128, -0.0377998, 0.0500453, 0.0165188, -0.0265887, -0.0174278, 0.0358222, -0.00266878, 0.0477684, -0.0434148, 0.0187814, -0.0193244, 0.000923121, 0.0566285, 0.0663994, 0.00951176, -0.0203712