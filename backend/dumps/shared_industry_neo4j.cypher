MERGE (c:`Chunk` {`id`: '361610-0010-d281a543'}) SET c += {`text`: '[SK아이이테크놀로지] 4. 매출 및 수주상황 > 다. 수주상황\n- 당사는 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2023.06.02 단일판매 공급계약체결 공시 참고\n) 경영상의 비밀유지로 계약상대방, 계약금액 및 주요 계약조건등의 공시는 유보하였습니다.\n- 당사는 계열회사인 에스케이온(주)와 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2023.07.26 단일판매 공급계약체결 공시 참고\n) 경영상의 비밀유지로 계약금액 및 주요 계약조건 등의 공시는 유보하였습니다.\n- 당사는 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2025\n.02.05\n단일판매\n공급\n계약체결\n공시\n참고\n) 경영상의 비밀유지로 계약상대방 등의 공시는 유보하였습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 다. 수주상황', `idx`: 10} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0311274, 0.0715516, -0.00109397, -0.0083392, -0.0220077, -0.0221383, -0.0336403, 0.0765837, -0.00377866, 0.0331454, 0.0877095, 0.0185821, -0.0271495, 0.0159169, -0.0380799, -0.023286, 0.0505922, 0.0342048, -0.0685393, 0.00390397, 0.0299446, 0.0306823, -0.00704964, 0.0381005, 0.0502992, -0.088293, -0.0337043, 0.0350663, -0.00184274, -0.00426757, 0.0387105, 0.0325821, -0.0526954, -0.0610286, 0.0353767, -0.0136545, -0.00562891, -0.0256566, -0.0381328, 0.0686596, -0.0291588, 0.0405264, 0.0302609, -0.0883949, -0.0086017, -0.0296446, -0.0703672, 0.00264377, -0.0246864, 0.0159148, -0.0384756, -0.024876, 0.0234294, 0.0295802, 0.105357, -0.0087439, -0.0570378, 0.0124866, 0.0109963, 0.0625382, -0.0513902, -0.0316401, 0.0846977, 0.0155241, 0.0576895, -0.0309162, 0.0511759, 0.0403055, -0.00960677, 0.00648747, 0.0395291, 0.00705941, 0.0217754, 0.0208517, -0.0487665, -0.00935923, -0.0339287, 0.0592572, 0.0577659, -0.0398213, 0.0126785, -0.0053167, 0.000588491, -0.00954599, -0.0335984, -0.0207477, -0.0494829, 0.0267637, -0.0550742, 0.0121504, -0.000569769, 0.00230983, 0.00643545, 0.0563717, 0.0420565, -0.04686, -0.0420951, 0.0254045, -0.0301008, -0.0470073, -0.0545815, -0.0217558, -0.012345