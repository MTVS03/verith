MERGE (c:`Chunk` {`id`: '096770-0067-3eea1c25'}) SET c += {`text`: '[SK이노베이션] 4. 매출 및 수주상황 > [기유 사업 본부]\n당사는 고객이 원할 때 적시에 공급이 가능한 물류 체계 확보를 위해 해외 주요 거점에 물류터미널 및 탱크를 확보하고 재고를 보유하고 있습니다. 해외에서의 재고보유에 따른 비용 증가 및 운전자본 증가에도 불구하고 \'고객에게 일관된 품질의 기유를안정적으로 공급한다’는 전략 아래 현 체계를 지속적으로 유지하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [기유 사업 본부]', `idx`: 67} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00285777, 0.00560223, 0.0298429, -0.0224074, 0.00970477, 0.00820598, -0.0202924, 0.0453275, -0.0176146, 0.0534071, 0.098602, -0.0060315, -0.0523411, 0.0636248, -0.00484756, 0.0371858, 0.0600882, 0.00803275, -0.0793179, -0.0192737, 0.0292512, -0.0752538, 0.0161179, 0.00544266, 0.0362094, -0.0270546, -0.0110765, 0.0514948, -0.025719, 0.0338538, 0.024976, 0.0589438, -0.0444716, 0.028586, 0.0187986, -0.0465068, -0.0257104, 0.0401605, -0.0271162, 0.0824144, -0.000564724, 0.0310441, 0.0662142, -0.0430213, 0.0226719, -0.0052487, -0.0398306, 0.0111499, -0.0813686, 0.0111705, -0.0212469, 0.0213665, -0.00349427, 0.0668192, 0.0409096, 0.0036942, -0.0701436, -0.020039, 0.0633268, 0.0894849, -0.0408225, -0.0132133, 0.0128692, -0.0258284, -0.00987962, -0.0314657, 0.0326824, -0.0165946, -0.0416967, 0.0237862, 0.0165086, 0.0217925, -0.0130961, 0.0324512, -0.0495847, -0.0101648, 0.00474851, -0.0449112, 0.052739, -0.0947235, 0.0120608, 0.0388303, -0.0324736, 0.0708385, -0.013623, -0.0399892, 0.0128523, -0.00437056, 0.0347901, 0.00764187, -0.0408894, -0.0505398, -0.13196, -0.0133829, 0.0429102, -0.0121804, -0.0707871, 0.0236648, 0.0186079, -0.0607637, 0.0279635, 0.00978628, 0.0324731, -0.0728725, 0.0408807, 0.066075, 0.0392075, 0.0175189, -0.0830115, -0.00741267, 0.00937638, -0.0128959, 0.0100976, 0.00450346, -0.0417476, -0.0561998, -0.0319194, -0.0460139, 0