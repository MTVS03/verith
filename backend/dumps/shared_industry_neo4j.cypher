MERGE (c:`Chunk` {`id`: '096770-0100-d0f34762'}) SET c += {`text`: '[SK이노베이션] 4. 매출 및 수주상황 > [SK아이이테크놀로지㈜]\n- 당사는 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2023.06.02 단일판매 공급계약체결 공시 참고\n) 경영상의 비밀유지로 계약상대방, 계약금액 및 주요 계약조건등의 공시는 유보하였습니다.\n- 당사는 계열회사인 에스케이온(주)와 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2023.07.26 단일판매 공급계약체결 공시 참고\n) 경영상의 비밀유지로 계약금액 및 주요 계약조건 등의 공시는 유보하였습니다.\n- 당사는 이차전지용 분리막 장기공급계약을 체결하였으며 (\n2025\n.02.05\n단일판매\n공급\n계약체결\n공시\n참고\n) 경영상의 비밀유지로 계약상대방 등의 공시는 유보하였습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [SK아이이테크놀로지㈜]', `idx`: 100} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0429905, 0.0728239, -0.00436364, -0.00415445, -0.0215752, -0.027041, -0.0285817, 0.0851868, -0.00774966, 0.0230636, 0.0906471, 0.0277254, -0.0174401, 0.015029, -0.0391386, -0.0103706, 0.0488359, 0.0248313, -0.0706941, 0.00307443, 0.0284082, 0.0166129, -0.00446204, 0.0513332, 0.0715958, -0.0924507, -0.0343031, 0.0385275, -0.0037699, -0.0136168, 0.0306008, 0.0247131, -0.059471, -0.0577783, 0.0304754, -0.0169274, 0.0016929, -0.0143265, -0.0381776, 0.0696038, -0.0378209, 0.0547137, 0.0380527, -0.0805607, -0.00369281, -0.019311, -0.0821131, 0.00176761, -0.0201499, 0.0185545, -0.0151868, -0.0220935, 0.0201436, 0.0362283, 0.109594, -0.0122695, -0.0594226, 0.0183524, 0.0123693, 0.0645848, -0.0431478, -0.0242581, 0.0764867, 0.0161417, 0.0492761, -0.0257482, 0.0568485, 0.041365, -0.0131189, 0.0131754, 0.0328269, 0.0191356, 0.0252008, 0.0226167, -0.0479031, -0.0117519, -0.0369632, 0.0604245, 0.0546186, -0.0405985, 0.0165316, -0.00266522, -0.00499977, -0.00790573, -0.0341452, -0.025697, -0.0530989, 0.0317425, -0.0422364, 0.00737568, -0.0127264, -0.00384976, -0.00514855, 0.0614449, 0.0393889, -0.04208, -0.0351397, 0.0215228, -0.031208, -0.0449555, -0.0507435, -0.00876382, 0.00856