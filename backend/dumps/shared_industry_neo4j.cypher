MERGE (c:`Chunk` {`id`: '086520-0034-be871aa0'}) SET c += {`text`: '[에코프로] 4. 매출 및 수주상황 > [환경사업부문] > 다. 주요 매출처\n당기 중 회사 매출액의 10% 이상을 차지하는 주요 매출처는 다음과 같습니다.\n(단위: 백만원)\n구  분\n2025년\n2024년\n매출액\n비중\n매출액\n비중\n주요거래처(A)\n15,618\n11.1%\n91,695\n39.1%\n주요거래처(B)\n15,793\n11.2%\n59,915\n25.6%\n주요거래처(C)\n30,353\n21.5%\n25,576\n10.9%\n※ 상기 매출액 및 비중은 공시대상기간의 누계 금액을 기준으로 산정하였습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [환경사업부문] > 다. 주요 매출처', `idx`: 34} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.017215, 0.0245031, 0.0179041, -0.0292335, -0.0218505, 0.0296343, -0.0331819, -0.0250854, -0.0620633, 0.0544409, 0.0304693, 0.0252876, 0.0433021, -0.0169341, 0.00357096, -0.00306369, 0.0566438, -0.0421552, -0.00812224, -0.032792, -0.0203432, -0.00204746, -0.0176873, -0.00326066, 0.0499028, -0.0275019, -0.0279651, 0.0168412, -0.109201, 0.0611811, -0.0273382, 0.0126781, 0.00336276, -0.0314784, 0.0368213, 0.0293982, 0.0305312, -0.0231466, -0.0408311, 0.00131441, 0.00819772, 0.00747196, 0.00109441, -0.0642652, -0.0239722, -0.0631254, -0.0237895, -0.0176578, -0.0253349, 0.0248824, -0.0669321, -0.0225094, 0.0450152, -0.0391664, -0.0284436, 0.0649939, -0.0479085, -0.000406407, 0.0181175, -0.0143972, -0.0291279, -0.0111072, 0.0751613, -0.0115728, 0.0410547, -0.0329925, 0.0197298, 0.0367184, 0.00329165, 0.0893949, -0.0428972, 0.00601837, 0.0565228, -0.0312291, 0.0200849, -0.00381118, 0.0240314, -0.0050451, 0.0330249, -0.048963, 0.00398563, -0.0447419, 0.0220177, -0.029874, -0.0400056, 0.0185363, -0.0660291, 0.0160697, -0.0407213, 0.0192916, -0.0388467, -0.0827215, -0.0493131, 0.0776185, 0.0273805, 0.0270191, -0.0855431, -0.0287816, -0.0251566, 0.00662369, -0.00453159, 0.0205944, 0.0538969, 0.0206338, 0.006539, -0.00638841, -0.00580427, 0.0302565, -0.02894, 