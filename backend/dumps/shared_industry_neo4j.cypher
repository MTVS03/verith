MERGE (c:`Chunk` {`id`: '096770-0107-36617b46'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [SK이노베이션㈜ 연결 기준] > 가. 파생상품계약 체결 현황\n(1) 당기말 및 전기말 현재 파생상품자산 및 부채는 다음과 같습니다.\n(단위: 백만원)\n구분\n당기말\n전기말\n자    산\n부    채\n자    산\n부    채\n현금흐름위험회피회계 적용 파생금융상품:\n상품파생 (주1)\n321\n5,250\n38,360\n109\n통화선도 (주1)\n-\n81\n-\n-\n통화스왑 (주1)\n206,086\n32,401\n193,928\n104,723\n이자율스왑 (주1)\n21,083\n18,597\n71,582\n10,165\n소    계\n227,490\n56,329\n303,870\n114,997\n위험회피수단으로 지정되지 않은 파생금융상품:\n상품파생 (주2)\n8,260\n8,706\n4,026\n3,877\n통화선도 등 (주2)\n133,358\n87,972\n184,529\n21,469\n통화스왑 (주2)\n-\n-\n-\n16,379\n소    계\n141,618\n96,678\n188,555\n41,725\n주식옵션 (주3,4,5)\n165,878\n631,102\n15,217\n569,507\n합    계\n534,986\n784,109\n507,642\n726,229\n(주1)\n당기말 및 전기말 현재 연결실체는 재고의 매입, 제품 및 상품의 예상 매출에 대한 현금흐름의 변동위험을 회피하기 위하여 장내 및 장외 파생금융상품을 이용하고 있습니다. 또한, 연결실체는 제품 및 상품의 예상매출에 대한 환율변동 위험과 변동이자부 차입금에 대한 이자율변동 위험을 회피하기 위하여 파생금융상품을 이용하고 있습니다.\n(주2)', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [SK이노베이션㈜ 연결 기준] > 가. 파생상품계약 체결 현황', `idx`: 107} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0322126, 0.0192367, -0.022082, 0.0145681, -0.0391373, 0.061761, 0.0563968, 0.0585373, -0.00422171, 0.0223592, 0.0682608, 0.0455135, -0.0145209, 0.0404629, -0.0383654, 0.0173693, 0.0192219, -0.0200328, 0.00582958, 0.00506673, 0.0521852, 0.0271499, -0.00647297, 0.0641102, 0.0710763, -0.0251415, -0.0485077, -0.00127903, 0.00320229, 0.0111579, 0.0252297, 0.0469703, -0.0715637, 0.000601218, -0.0108188, -0.0265575, -0.0468028, 0.0338327, -0.010572, 0.0222823, -0.0320757, 0.0519055, 0.0458536, -0.0551895, 0.0759043, -0.00441899, -0.0220845, -0.0218239, 0.0268185, -0.0375782, -0.0179866, -0.0227995, 0.00324511, 0.00306879, 0.0567193, -0.00879607, -0.0640281, 0.022553, 0.0220204, 0.0014078, 0.0253412, 