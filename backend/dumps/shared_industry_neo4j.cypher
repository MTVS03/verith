MERGE (c:`Chunk` {`id`: '361610-0012-a5d9a471'}) SET c += {`text`: '[SK아이이테크놀로지] 5. 위험관리 및 파생거래 > 가. 주요 시장위험\n830,378\n합   계\n962,282\n(전기말)\n(단위 : %,백만원)\n구분\n이자율유형\n이자율\n금액\n차입금\n변   동\n1YLPR +0.2~0.4\n22,387\n차입금\n변   동\n3MSOFR +1.5~1.9\n1,019,975\n합   계\n1,042,362\n당기 및 전기 중 다른 모든 변수가 일정하고 이자율이 변동할 때 당기 법인세비용차감전순이익(손실)에 미치는 영향은 다음과 같습니다.\n(단위 : 백만원)\n계정과목\n당   기\n전   기\n이자비용\n100bp상승시\n(9,623)\n100bp상승시\n(10,424)\n(나) 환위험\n- 환위험은 환율의 변동으로 인하여 금융상품의 공정가치가 변동될 위험입니다. 연결실체는 해외영업활동 등으로 인한 환위험에 노출되어 있습니다. 연결실체는 내부적으로 원화환율 변동에 대한 환위험을 정기적으로 측정하고 있으며, 특히 외화매출채권 등의 환율변동위험을 회피하기 위하여 통화선도계약을 체결하여 관리하고 있습니다.\n- 당기말 및 전기말 현재 연결실체의 통화별 주요 외화금융자산ㆍ부채의 내역은 다음과 같습니다.\n(단위 : 백만USD, 백만JPY, 백만EUR, 백만CNY, 백만PLN, 백만원)\n구    분\n화폐단위\n당기말\n전기말\n외화금액\n원화금액\n외화금액\n원화금액\n외화금융자산\nUSD\n74\n106,746\n44\n64,695\nJPY\n-\n-\n459\n4,300\nEUR\n-\n327\n1\n832\nPLN\n14\n5,596\n31\n11,046\n외화금융부채\nUSD\n598\n857,982\n717\n1,054,034\nJPY\n76\n698\n275\n2,569\nEUR\n1\n991\n1\n1,715\nCNY\n22\n4,516\n16\n3,227', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 가. 주요 시장위험', `idx`: 12} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0148127, 0.0071078, -0.00918277, -0.0014283, -0.0401707, 0.040361, 0.0235045, 0.0344844, -0.005284, 0.0152933, 0.0436282, -0.00798482, -0.0162873, 0.0204605, -0.0179868, -0.0126778, 0.0117433, 0.0415384, -0.0373518, 0.00450315, 0.0296073, -0.00952548, -0.0417036, -0.0166768, 0.0184848, 0.013902, -0.0612953, -0.0123603, 0.0186195, 0.0201628, 0.0239532, 0.06771, -0.0278527, 0.0176608, -0.0171948, 0.0185608, -0.0177299, 0.0645432, -0.0427431, 0.0525754, 0.00519097, 0.0119465, 0.0479312, -0.0285307, 0.0161995, -0.0189353, 0.0096498, -0.0207362, 0.019334, -0.026359, -0.0170422, -0.0992472, 0.00742408, -0.0107051, 0.0535284, -0.0103856, -0.040391, 0.065