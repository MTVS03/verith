MATCH (a)-[r]->(b)
WHERE type(r) IN ['SUPPLIES', 'COMPETES_WITH', 'OWNS_STAKE', 'BELONGS_TO', 'BENEFITS_FROM']
  AND (a:`Company` OR a:`Industry` OR a:`Product` OR a:`Policy` OR a:`Person`) AND (b:`Company` OR b:`Industry` OR b:`Product` OR b:`Policy` OR b:`Person`)
  AND a.`name` IN names AND b.`name` IN names
DELETE r;

