// verith 산업 그래프 스냅샷 (자동 생성 — 손으로 편집하지 말 것)
// 복원: cypher-shell < 이 파일   (뉴스 스냅샷을 쓴다면 restore_news 를 먼저 돌린다)

// ── DDL ──
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Industry`) REQUIRE n.`name` IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Policy`) REQUIRE n.`name` IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:`Product`) REQUIRE n.`name` IS UNIQUE;
CREATE CONSTRAINT chunk_id IF NOT EXISTS FOR (c:`Chunk`) REQUIRE c.`id` IS UNIQUE;
CREATE INDEX IF NOT EXISTS FOR (n:`Company`) ON (n.`name`);
CREATE INDEX IF NOT EXISTS FOR (n:`Person`) ON (n.`name`);
CREATE VECTOR INDEX chunk_embedding IF NOT EXISTS FOR (c:`Chunk`) ON (c.`embedding`) OPTIONS {indexConfig: {`vector.dimensions`: 1024, `vector.similarity_function`: 'cosine'}};

// ── 스코프 초기화 (멱등 복원) ──
// :Chunk 는 산업 전용 레이블 → 전량 삭제 안전. FROM_FILING 도 함께 정리된다.
MATCH (c:`Chunk`) DETACH DELETE c;
