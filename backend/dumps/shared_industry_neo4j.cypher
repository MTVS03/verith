MERGE (c:`Chunk` {`id`: '096770-0181-f88f6f80'}) SET c += {`text`: '[SK이노베이션] 7. 기유 및 윤활유 사업 > [API 기유 분류]\n한편, 전세계에 산재한 윤활유 제조공장에 안정적으로 기유를 공급하기 위해 당사는 기유 원료인 미전환 잔사유(UCO)를 외부 확보할 수 있는 모델을 유일하게 구축하고, 생산량 증대 및 UCO 보유 업체와의 합작투자를 통해 세계 주요 지역별 생산기지를 선제적으로 확보하였습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기유 및 윤활유 사업 > [API 기유 분류]', `idx`: 181} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0178628, 0.0179917, 0.0364625, 0.0245249, -0.0417293, -0.014179, 0.0150575, 0.0743759, 0.00824844, -0.00695347, 0.0526304, -0.00392936, 0.0176837, 0.0384603, 0.0159887, -0.000682226, -0.000354126, -0.00154197, -0.0530053, 0.00834411, 0.031496, -0.0248062, 0.0193034, 0.0337819, 0.08884, -0.0505177, 0.0189195, 0.0178119, -0.0665369, -0.0290016, 0.0253762, 0.0544185, -0.0382711, 0.0185903, -0.00503347, -0.0212919, 0.00675897, 0.0558835, -0.0261191, 0.0633979, -0.0122626, 0.0337882, 0.0944468, -0.0548192, -0.0087335, -0.0624921, -0.0155817, 0.0435296, -0.00333939, -0.0119909, -0.0249174, -0.0108555, 0.0408467, 0.0249248, 0.0588931, -0.0196426, -0.0590682, -0.0154553, 0.0165128, 0.0654424, -0.0676751, 0.000301938, -0.00482148, -0.011186, 0.0064518, -0.0566713, -0.0120043, -0.0331651, -0.026771, 0.0134396, 0.0225447, 0.0742883, -0.0113463, 0.0201779, -0.0201218, -0.0359807, 0.00609489, -0.0347202, 0.0504214, -0.0486007, 0.0345175, 0.0327716, -0.0229973, 0.0301177, 0.0199219, -0.0402943, -0.0265892, 0.0261812, 0.0781382, 0.00994411, 0.044227, -0.0692237, -0.0634652, 0.0459807, 0.040617, 0.0177947, -0.023462, 0.0113108, -0.0225744, -0.0202675, -0.00728927, 0.00178309, 0.0290266, -0.122457, 0.0318736, -0.00909026, -0.0368798, 0.0657749, -0.120806, -0.0249683, 0.0263929, -0.0111115, 0.0111305, 0.0258883, -0.0378821, -0.0631129, 0.0449552, -0.0587584, -0.00340483, 0.