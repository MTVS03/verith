MERGE (c:`Chunk` {`id`: '348370-0031-e5820a33'}) SET c += {`text`: '[엔켐] 7. 기타 참고사항 > [2차전지 소재산업]\n당사는 현재까지 신선제품인 전해액 납품을 하면서 단 1차례도 물류상의 문제와 물류로 인한 납기지연 등의 사고가 없었으며, 이는 고객사들이 당사에 대해 굉장히 만족해하는 부분입니다. 또한 당사는 중국, 유럽, 미국에서 현지화하여 제품을 납품할 수 있도록 고객사들로부터 현지화가 가장 잘 되어 있는 업체로 평가받고 있습니다. 향후, 전해액 산업에서 해외 진출 고객 및 신규 해외 고객 대응을 위한 현지화 전략이 가장 중요한 요소이자 사업 성공을 위한 필수적 요구사항이 될 것입니다. 이러한 사유로 당사에서는 적극적인 투자를 단행하여, 전기차 빅마켓인 유럽, 중국, 미국 시장에 현지화를 진행하였으며, 투자된 지역 공장의 Capa 증설, 연구개발 및 신규사업 진출에 재투자하여, 규모의 경제 구축, 전해액 연구개발을 통한 기술 경쟁력 확보, 신규시장 진입(폐NMP 정제)을 통해 고객사와 더욱 긴밀한 사업적 관계를 형성하고자 합니다.\n6) 신규사업 등의 내용\n(1) NMP Recycle 사업', `company`: '엔켐', `stock_code`: '348370', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260326001049&dcmNo=11183261&eleId=9&offset=70916&length=79058&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [2차전지 소재산업]', `idx`: 31} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0298194, -0.0181879, 0.0563298, -0.0255285, -0.00737484, 0.0273326, 0.00424926, 0.0721299, -0.0613587, 0.0363579, 0.109443, 0.0177236, -0.0134284, -0.0143307, -0.00407936, -0.0351277, 0.00575895, -0.000497314, -0.0705069, 0.0251866, 0.0088827, 0.0193504, -0.00650032, -0.060028, 0.015441, 0.0157981, -0.0238277, -0.030317, 0.026876, -0.0672873, -0.0568073, 0.0847843, 0.00703559, 0.00203104, 0.0111417, -0.00325498, -0.0130841, -0.000166861, -0.0426862, 0.0623075, 0.0673536, -0.013468, -0.0010022, 0.0142353, 0.0316564, -0.0467959, -0.0202976, 0.0161841, -0.0196854, -0.00546506, -0.0157522, 0.0330359, 0.01014, 0.0347671, 0.0718348, 0.0340814, -0.0729187, -0.00578872, 0.000890919, 0.0483415, 0.00521139, -0.012204, 0.0558272, 0.0515945, 0.0229638, -0.0238021, -0.0105848, -0.0431826, 0.0148311, 0.0254374, -0.0124526, 0.0341832, -0.00460953, -0.0403071, -0.0428717, 0.0548352, 0.0110611, -0.0179269, 0.0572166, -0.0433962, -0.00807881, -0.07637, -0.0438089, -0.010002, 0.0174665, -0.00948617, -0.0515065, -0.0189773, -0.0133442, -0.0547155, -0.0087551