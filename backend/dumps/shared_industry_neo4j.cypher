MERGE (c:`Chunk` {`id`: '361610-0013-1bc06de7'}) SET c += {`text`: '[SK아이이테크놀로지] 5. 위험관리 및 파생거래 > 가. 주요 시장위험\n-\n459\n4,300\nEUR\n-\n327\n1\n832\nPLN\n14\n5,596\n31\n11,046\n외화금융부채\nUSD\n598\n857,982\n717\n1,054,034\nJPY\n76\n698\n275\n2,569\nEUR\n1\n991\n1\n1,715\nCNY\n22\n4,516\n16\n3,227\n- 당기말 및 전기말 현재 각 외화에 대한 원화환율이 10% 변동시 환율변동이 법인세비용차감전순이익(손실)에 미치는 영향(파생금융상품으로 인한 효과 고려)은 다음과 같습니다.\n(단위 : 백만원)\n외화\n당  기\n전  기\n10% 상승시\n10% 하락시\n10% 상승시\n10% 하락시\nUSD\n(28,246)\n28,246\n(46,312)\n46,312\nJPY\n(70)\n70\n173\n(173)\nEUR\n(66)\n66\n(88)\n88\nCNY\n(413)\n413\n(224)\n224\nPLN\n473\n(473)\n363\n(363)\n(다) 기타 가격위험\n- 기타 가격위험은 이자율위험이나 환위험 이외의 시장가격의 변동으로 인하여 금융상품의 공정가치나 미래현금흐름이 변동될 위험입니다. 연결실체의 경영진은 당기말 현재 기타 가격위험이 재무제표에 미치는 영향은 중요하지 않다고 판단하고 있습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 가. 주요 시장위험', `idx`: 13} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00927322, -0.0251797, -0.0135621, -0.00808822, -0.0495423, 0.0312401, 0.00649492, 0.0323977, 0.00268226, -0.00171072, 0.026242, 0.0244855, -0.00676761, 0.0229432, -0.0151006, -0.0177563, 0.00517952, 0.0343216, -0.0327714, 0.0191791, 0.00365046, -0.00385758, -0.0518447, 0.012662, 0.00925929, 0.00936478, -0.0372469, -0.00434358, 0.0179783, 0.055898, 0.0171866, 0.0614975, 0.00301712, 0.0305954, -0.00292926, 0.0308009, -0.022297, 0.069281, -0.0359717, 0.0333809, 0.0186456, 0.00700565, 0.0497639, -0.0408599, 0.0184857, -0.0119327, -0.00297006, 0.00899848, -0.0102535, -0.0693077, -0.00635658, -0.106369, 0.0231472, -0.0313526, 0.0510296, -0.00942529, -0.0119706, 0.0324624, -0.00328203, 0.0254436, -0.0171425, -0.0304877, 0.0091558, -0.0630803, 0.0542718, -0.021869, -0.0441498, 0.0464807, -0.0196867, 0.0344061, -0.0230108, 0.0301525, 0.0833655, 0.0635121, -0.0606903, 0.0356522, -0.04