MERGE (c:`Chunk` {`id`: '096770-0109-adb8ac11'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [SK이노베이션㈜ 연결 기준] > 나. 파생상품 계약에 따른 손익내역\n당기 및 전기 중 파생금융상품계약으로 인해 연결포괄손익계산서에 반영된 손익의 내역은 다음과 같습니다.\n(당기)\n(단위: 백만원)\n구    분\n금융손익으로 인식한 금액(세전금액)\n기타포괄손익(세후금액)\n평가이익\n평가손실\n거래이익\n거래손실\n평가이익\n평가손실\n현금흐름위험회피회계 적용 파생금융상품\n-\n-\n-\n-\n90,967\n(107,716)\n위험회피수단으로 지정되지 않은 파생금융상품\n223,271\n(228,270)\n1,362,259\n(1,547,032)\n-\n-\n주식옵션\n165,877\n(602,124)\n-\n-\n-\n-\n합    계\n389,148\n(830,394)\n1,362,259\n(1,547,032)\n90,967\n(107,716)\n(전기)\n(단위: 백만원)\n구    분\n금융손익으로 인식한 금액(세전금액)\n기타포괄손익(세후금액)\n평가이익\n평가손실\n거래이익\n거래손실\n평가이익\n평가손실\n현금흐름위험회피회계 적용 파생금융상품\n-\n-\n-\n-\n104,711\n(86,416)\n위험회피수단으로 지정되지 않은 파생금융상품\n186,182\n(63,101)\n1,303,079\n(1,482,380)\n-\n-\n신주인수권\n381\n(3,947)\n-\n(486)\n-\n-\n주식옵션\n6,256\n(141,881)\n-\n-\n-\n-\n합    계\n192,819\n(208,929)\n1,303,079\n(1,482,866)\n104,711\n(86,416)\n한편, 당기 및 전기 중 현금흐름위험회피 회계와 관련하여 기타포괄손익에서 당기손익으로 재분류된 거래손익(순액)은 각각 28,817백만원 및 199,635백만원입니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [SK이노베이션㈜ 연결 기준] > 나. 파생상품 계약에 따른 손익내역', `idx`: 109} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.00121879, 0.0299651, -0.0377547, -0.0138791, -0.047727, 0.0491211, 0.0517857, 0.0481666, 0.0356058, 0.0342219, 0.0869573, -0.00637698, 0.0198882, 0.054336, -0.0285837, -0.00658783, -0.0038092, -0.0439474, -0.0185919, 0.00690626, 0.0639883, 0.0257311, -0.0385639, 0.0938411, 0.0595151, 0.00791395, -0.0151564, -0.0489262, 0.00129505, -0.000807206, 0.0364112, 0.0151256, -0.102232, -0.0183723, -0.0192705, -0.0324964, -0.0137039, 0.0302537, 0.0087535, 0.0120602, -0.0294652, 0.0565253, 0.0639687, -0.100634, 0.102212, -0.000958453, -0.0241956, 0.00243682, 0.0219101, 0.0112127, 0.0121411, -0.0262173, 0.039373, -0.0235265, 0.04534