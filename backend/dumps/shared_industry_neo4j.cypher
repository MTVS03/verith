MERGE (c:`Chunk` {`id`: '096770-0120-8089307f'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [위험회피수단으로 지정되지 않은 파생상품] > 다. 리스크 관리에 관한 사항\n연결실체는 환율변동 위험에 노출되어 있는 Position으로부터 발생 가능한 손실을 관리하기 위하여 환 Risk 관리정책을 수립하여 실행하고 있습니다. 이에 따라 당사가 감내 가능한 범위의 목표 익스포져를 설정하여 그 안에서 익스포져를 관리 중이며, 한도를 벗어나는 과도한 Position에 대해서는 헷지를 실시하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [위험회피수단으로 지정되지 않은 파생상품] > 다. 리스크 관리에 관한 사항', `idx`: 120} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00539116, -0.0378603, -0.000757511, 0.035267, -0.064039, 0.0620048, 0.0422059, 0.0525177, 0.0485276, 0.00810545, 0.0245843, 0.0673013, -0.0344889, 0.0408702, 0.0413586, -0.0130792, 0.0343637, -0.00545011, -0.0114148, 0.034291, -0.000530031, -0.0389426, 0.0174011, 0.067368, 0.00882695, 0.00926169, -0.0496954, 0.021094, -0.00928834, 0.0399944, 0.0193518, 0.044093, -0.056323, 0.00606162, 0.0220987, 0.00515782, -0.0381071, -0.010749, -0.0166748, 0.0973299, 0.00330861, 0.0343143, 0.0803272, -0.000546786, 0.065579, -0.01949, -0.0181669, -0.0030232, -0.0410088, 0.0128272, -0.0435745, -0.044132, -0.00487619, 0.0608926, 0.0411737, 0.013324, -0.00366132, -0.0214425, 0.0692194, 0.00519733, 0.0335896, -0.0276466, 0.01124, -0.0352244, 0.0269977, -0.00750756, 0.0269303, 0.0922595, 0.0212674, 0.0267943, 0.0215255, 0.0522274, 0.0120096, 0.0502885, -0.106829, 0.0330034, -0.0139364, -0.0116822, 0.0929425, 0.0367678, 0.0572109, 0.041659, 0.013556, 0.0393032, 0.0364846, 0.0574324, -0.0202859, -0.0461445, 0.035281, -0.0369403, 0.000261887, -0.017608, -0.0147255, 0.00498698, -0.0200499, -0.0262427, -0.0346978, 0.0410589, 0.0387961, 0.0177663, 0.030169, 0.0103699, 0.0213424, -0.033334, 0.00608172, 0.023491, -0.0546782, 0.0156845, -0.0292132, 0.0136063, -0.0346537, -0.0123753, 0.0706282, 0.