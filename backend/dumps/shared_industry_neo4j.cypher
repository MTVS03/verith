MERGE (c:`Chunk` {`id`: '096770-0230-87569bed'}) SET c += {`text`: '[SK이노베이션] 17. 수소 사업 > [연도별 특허 및 실용신안 등록 건수]\n(단위 : 건 수)\n구분\n2025년\n2024년\n2023년\n2022년\n2021년\n한국\n343\n198\n165\n165\n194\n해외\n579\n591\n360\n201\n124\n또한 당사는 유공, MY SUNI, 하모니아 등 서비스 브랜드 가치 향상 등을 위해 상표권을 보유 중입니다. 당기말 현재 당사가 보유하고 있는 국내외 상표권 및 디자인권은 총 136건이며, 최근 등록되어 유지되고 있는 상표권/디자인권 건수는 아래와 같습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '17. 수소 사업 > [연도별 특허 및 실용신안 등록 건수]', `idx`: 230} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0184744, 0.0398301, -0.0239827, -0.0114315, -0.0638719, 0.0131194, -0.00192489, -0.0406448, -0.00655815, -0.0407267, 0.0611029, 0.051987, 0.0358508, 0.0273046, -0.0554074, -0.0164801, 0.0300693, -0.0556771, -0.0947588, -0.00372833, 0.091622, 0.0135517, 0.034701, 0.0516683, 0.0601432, 0.00324704, -0.0119113, 0.0416701, -0.0550047, 0.0360741, -0.0097582, 0.0248551, -0.0396979, -0.0400529, -0.0437876, -0.0823666, -0.0207808, 0.00119007, -0.0338157, 0.0185146, 0.00526161, 0.00842496, 0.0504548, -0.0258178, 0.0284143, 0.0228816, -0.0141685, 0.0180505, -0.0098104, 0.0154091, 0.047851, -0.00121739, 0.0261261, 0.0416712, -0.00349316, 0.0259136, -0.0658829, 0.0461046, -0.0440913, 0.0694427, -0.0565396, 0.00967237, -0.0159042, -0.0638783, 0.00656441, -0.0462148, 0.0670562, -0.0294166, -0.00883124, 0.0192004, 0.033065, 0.0365897, 0.00738506, -0.0274838, -0.0715011, -0.0317136, -0.0173945, 0.0308544, -0.00745748, -0.0714105, 0.0445376, 0.0656085, 0.0137199, 0.0324146, 0.0458772, -0.0526171, 0.0160068, -0.0126745, 0.0774374, 0.0219734, 0.012104, 0.0428715, -0.0623439, 0.0159098, 0.00388026, -0.0108057, -0.0930142, 0.00154849, 0.021968, -0.0435065, 0.0419297, 0.0738641, 0.0632637, -0.0138812, -0.0296477, 0.0347051, 0.0116684, 0.0286362, -0.0626298, 0.0164963, -0