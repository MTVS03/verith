MERGE (c:`Chunk` {`id`: '348370-0027-42b761b2'}) SET c += {`text`: '[엔켐] 7. 기타 참고사항 > [2차전지 소재산업]\n1) 산업의 특성\n2차전지는 양극재, 음극재, 전해액, 분리막 등 크게 4가지로 핵심소재로 구성되어 있으며, 그중 전해액은 리튬이온 2차전지의 충방전 시 리튬이온의 이동 기능을 담당하는 핵심소재입니다. 또한 전해액은 그 소재 구성에 따라 리튬2차전지의 수명, 충방전 속도, 열안정성 등 특성을 결정하는 소재로, 전지 성능 향상에 핵심 물질이라 할 수 있습니다.  현재 전기차 시장의 확대와 2차전지산업이 성장하면서 전기차의 주행거리 향상, 2차전지의 에너지밀도, 안전성 개선을 위해 4대 핵심소재의 기술 개발이 활발히 진행되고 있습니다.\n최근 2차전지 시장은 소형 IT용 Application 시장에서 전기차, ESS 시장으로 확대해 나가고 있습니다.\n2차전지 소재산업은 전방산업의 수요에 민감한 산업의 특성으로, 전기차와 ESS 시장은 각국의 정책 및 규제로 인해 시장의 지형 변화가 불가피합니다. 특히, 미국은 중국의 2차전지 공급망 지배력을 견제하기 위한 목적으로 재정된 인플레이션 감축법(IRA)에 따라 북미 시장에서의 현지 공장에서 생산된 전해액의 수요가 높아짐에 따라 수혜가 기대되고 있습니다.\n소형 2차전지 전해액은 낮은 투자비용과 기술난이도로 중국 업체들이 주로 공급하고 있는 시장으로, 기술개발보다 출하량에 기준이 맞추어진 시장으로 파악됩니다. 전기차와 ESS용 중대형 2차전지 전해액 사업은 높은 투자비용과 기술적인 특성을 가져 진입장벽이 높습니다.', `company`: '엔켐', `stock_code`: '348370', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260326001049&dcmNo=11183261&eleId=9&offset=70916&length=79058&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [2차전지 소재산업]', `idx`: 27} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0403661, 0.0292043, 0.0474493, -0.0390236, -0.0260855, -0.0300604, -0.0468444, 0.12917, -0.0329516, 0.00510213, 0.0436931, 0.0619533, 0.00527669, 0.0462306, -0.0232645, -0.0125516, -0.0116637, -0.00120994, -0.0547012, -0.0199668, -0.00969595, -0.0492097, -0.0157749, -0.0521983, -0.016502, 0.0280837, -0.0198288, 0.0125503, 0.0285856, 0.00164225, -0.0236221, 0.0489307, -0.0245035, 0.0520207, -0.00314392, 0.082159, -2.85522e-05, -0.0198745, -0.0508262, 0.0359741, 0.00109028, -0.0380992, 0.0531369, 0.0410885, 0.0137951, -0.0302264, -0.0187332, -0.0346454, 0.010516, -0.0198316, -0.0542542, -0.00556726, 0.0503673, 0.00789124, 0.105453, 0.0013458, -0.0662348, -0.0257891, -0.0579426, 0.0086158, 0.0255014, 0.0217292, 0.0709853, -0.00462721, 0.0525429, -0.0576352, 0.0216757, -0.0419732, 0.0835447, -0.0311509, 0.0165717, 0.033193, -0.0282