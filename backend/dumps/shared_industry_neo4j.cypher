MERGE (c:`Chunk` {`id`: '066970-0020-19e645f5'}) SET c += {`text`: '[엘앤에프] 1. 시장위험\n당기말과 전기말 현재 대여금및수취채권의 거래대상별 신용위험에 대한 최대 노출정도는 다음과 같습니다.\n(단위 : 원)\n구  분\n제26(당)기말\n제25(전)기말\n최종제조업체\n319,278,561,980\n189,529,791,649\n중간제조업체\n12,771,306,364\n34,637,025,094\n금융기관\n2,322,054,108\n2,856,612,321\n기타\n11,066,959,548\n6,135,441,243\n합  계\n345,438,882,000\n233,158,870,307\n(2) 손상차손\n당기말과 전기말 현재 현금및현금성자산을 제외한 상각후원가측정 금융자산의 연령 및 각 연령별로 손상된 채권금액은 다음과 같습니다.\n(단위: 천원)\n구  분\n당기말\n전기말\n채권잔액\n손상된 금액\n채권잔액\n손상된 금액\n만기일 미도래\n327,481,638\n-\n196,582,288\n(43,628)\n0~30일\n11,606,567\n-\n7,285,044\n(7,284,516)\n31일~120일\n6,341,041\n-\n28,924,157\n(4,475,117)\n1년 이내\n43,835\n(43,628)\n-\n-\n1년 이상 경과\n11,769,062\n(11,759,633)\n170,642\n-\n합  계\n357,242,143\n(11,803,261)\n232,962,131\n(11,803,261)\n손실충당금은 연결회사가 자산금액을 회수할 수 없다는 것을 확신하기 전까지 손상차손을 기록하기 위하여 사용됩니다.\n2) 유동성위험', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 시장위험', `idx`: 20} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0178867, 0.0508048, 0.000363788, -0.0484515, -0.0558949, 0.0651317, 0.0356288, 0.0667301, -0.0361117, -0.0165074, 0.0405502, 0.0430298, 0.0121088, -0.00227372, 0.000728337, -0.0488168, -0.00896798, -0.0211823, -0.000946904, -0.0293678, -0.0429653, 0.0154667, -0.079913, -0.0126464, 0.00984167, -0.00166459, 0.0360283, -0.0140469, 0.0306563, 0.0134263, -0.0209306, 0.0290599, -0.0279275, 0.059381, 0.0313572, 0.0253779, -0.0182421, 0.034073, -0.00142102, 0.0526164, -0.019795, 0.0267134, 0.0536718, -0.040935, -0.0449407, -0.0509865, 0.0288776, -0.0444012, 0.0565689, -0.0319157, 0.0302744, -0.0470302, 0.0206563, 0.0328646, 0.0274545, 0.0200397, -0.0487898, 0.016182, 0.0158068, 0.0303431, 0.0102972, -0.00423562, -0.0357296, -0.00611563, 0.0419329, -0.0343607, 0.00459994, 0.0391963, 0.0247498, 