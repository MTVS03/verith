MERGE (c:`Chunk` {`id`: '247540-0032-ab574020'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > [주요 양극소재별 특성]\n2) 산업의 성장성\n시장조사기관 SNE리서치에 따르면 2차전지 시장의 대표적인 제품인 리튬이온전지의 수요가 2035년 6,205GWh에 달할 것으로 전망하고 있습니다. 특히 EV 시장은 전세계적 전기차 보급 확대 정책에 힘입어 2030년 2차전지의 시장 수요의 약 90% 이상이 EV 및 ESS 수요로 예상됩니다. 이외에도 전동공구, E-bike 및 모바일, E-모바일 등 소형분야에서도 2차전지 시장 규모가 커지면서 수요는 함께 증가할 것으로 전망하고 있습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [주요 양극소재별 특성]', `idx`: 32} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0288401, 0.0668093, 0.0205624, -0.0845399, -0.0217816, -0.0357764, -0.0808917, 0.0328567, -0.0580884, 0.0136141, 0.00489346, 0.0408506, 0.0111986, -0.00840558, -0.0432486, -0.0139051, 0.0309205, -0.0282257, -0.0502823, -0.05016, 0.0312571, 0.0131441, 0.0256185, 0.0395561, 0.030363, -0.0310163, -0.071532, 0.00475343, 0.0184692, 0.0277514, -0.0134532, -0.0010847, -0.00229117, 0.0495678, -0.00948861, 0.0304959, -0.0403929, -0.0149778, -0.0415276, -0.0105101, -0.0272122, -0.0280394, 0.0502882, -0.0297987, -0.0563634, -0.0423059, -0.0562925, -0.0554325, -0.00945017, -0.0522929, -0.0671982, 0.00138013, 0.00815719, 0.0360966, 0.020352, 0.0686425, -0.00365617, -0.0281765, -0.0830977, -0.00478129, -0.0276, 0.0138682, 0.0396587, 0.022306, 0.047201, -0.0885891, 0.0279666, 0.0226043, 0.06101, -0.0157466, -0.0186903, 0.0607954, 0.0273293, 0.043965, 0.011515, -0.00643681, -0.0277384, -0.00629405, 0.0187392, 0.0165699, -0.00255867, -0.0354765, -0.0426727, -0.0316193, -0.0314321, -0.0566631, 0.0158915, -0.0236341, -0.0704808, -0.0282102, -0.0764912, -0.0143173, 0.0458488, 0.0399702, 0.0321856, 0.0154032, -0.082291, 0.00440969, -0.0147522, 0.0435104, -0.0402574, -0.0096351, -0.0356066, -0.0022074, -0.0697081, 0.0216446, 0.00744925, -0.0488577, -0.0756509, 0.0192572, -0.058442