MERGE (c:`Chunk` {`id`: '086520-0023-dde738a4'}) SET c += {`text`: '[에코프로] 3. 원재료 및 생산설비 > [환경사업부문] > 나. 생산 및 설비\n합계\n토지\n건물\n구축물\n기계장치\n차량운반구\n공기구비품\n연구기자재\n기초\n70,956\n15,639\n40,139\n5,690\n4,275\n74\n501\n4,638\n증감\n36,764\n-\n12,565\n(121)\n22,982\n13\n1,184\n141\n기말\n107,720\n15,639\n52,704\n5,569\n27,257\n87\n1,686\n4,779\n※ 주요 물적자산에 관한 시가 등의 정보는 객관적인 자료를 파악할 수 없어 기재를 생략하였습니다.\n4) 향후 투자계획\n(1) 이차전지 부소재 및 유기 전자재료 사업\n당사는 현재 이차전지 부소재 및 유기 전자재료 신사업을 본격적으로 추진하고 있습니다. 이차전지 부소재로는 양극재 도판트, 도가니, 전해액 첨가제 등 양극재에 필요한 이차전지 핵심 부재료를 개발하였으며 그룹 내 전지재료 사업과의 긴밀한 공급망을 구축하여 안정적인 이차전지 시장 진출을 계획 중에 있습니다. 또한 전자재료 소재 사업은 고객사와의 협력 및 산학협력을 통해 활발하게 연구개발을 진행하고 있습니다. 일부 아이템들은 고객사의 POR (Process of Reference)로 선정되어 순차적인 물량 공급을 계획하고 있습니다.\n(2) 탄소배출권 사업(SDM 사업)', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [환경사업부문] > 나. 생산 및 설비', `idx`: 23} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0497619, 0.0329688, 0.0225224, -0.0110461, -0.0533161, -0.0325522, -0.0706867, 0.0418332, -0.0543257, -0.0087002, 0.0523325, 0.062852, 0.02724, -0.0238273, 0.0176762, -0.0201672, 0.0672274, -0.0249783, -0.000220667, -0.0159887, 0.0129051, 0.00224597, 0.0495951, 0.00504783, 0.0289434, -0.0121726, 0.0442962, -0.020188, -0.0349637, 0.101085, -0.00812251, -0.0148989, -0.0290243, 0.0565535, -0.0547248, 0.0365898, 0.00979622, -0.0279098, -0.0708703, 0.0689613, 0.015338, 0.0303325, 0.0272439, -0.047899, -0.0154208, -0.0674386, -0.0214489, -0.0387012, -0.0554977, -0.0584329, -0.0594289, 0.001557, -0.00904343, -0.0487437, 0.0314041, -0.00258615, -0.159111, -0.00776675, -0.0260908, 0.0419634, -0.0346826, -0.041008, 0.0373253, -0.0408364, 0.0366056, -0.0683616, -0.00378133, -0.0112512, 0.0595943, 0.0484592, 0.0106213, 0.00836879, -0.00134509, -0.0514723, 0.0332371, 0.00782251, 0.0166699,