MERGE (c:`Chunk` {`id`: '066970-0015-2668a37a'}) SET c += {`text`: '[엘앤에프] 1. 매출실적\n국외\n엘앤에프 → Cell 제조업체 등\n2) 판매방법연구개발 및 Order 수주 => 당사 생산 => 고객사 납품으로 판매가 이뤄지며, 매출채권은 당월 마감 후 익월에 구매승인서로 회수 또는 직수출에 따른 T/T, L/C로 회수됩니다.\n3) 주요 매출처매출액의 10% 이상을 차지하는 외부고객은 다음과 같습니다.\n구분\n전체 매출에서 차지하는 비중\n제26(당)기\n제25(전)기\n외부고객1\n88%\n85%\n외부고객2\n12%\n10%', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 매출실적', `idx`: 15} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0421992, 0.00591252, 0.0131072, -0.00125855, -0.0158814, 0.0291647, 0.0191158, 0.0495782, -0.0616246, 0.0458884, -0.0247459, 0.100363, -0.0175674, 0.0222465, -0.0186101, -0.0193239, -0.00881175, -0.0200044, -0.0184559, -0.0136749, -0.00384401, 0.0374937, -0.017897, -0.00456951, 0.0359648, -0.0349454, -0.017175, 0.00401487, -0.0613252, 0.00611833, -0.0360534, -0.00648254, -0.0331634, -0.0337913, -0.00185944, 0.00192857, 0.00107723, 0.0468826, -0.0602211, 0.0675922, -0.0113868, 0.044556, 0.0127817, -0.0807737, -0.0315715, -0.0409625, 0.0057055, -0.0132308, 0.0314152, 0.0496, -0.0291219, 0.0625775, 0.0107343, 0.0436025, 0.0134608, 0.0821675, -0.0290697, -0.0114654, 0.043162, 0.0528771, -0.0157654, -0.00656374, -0.0211292, 0.031453, 0.00440522, -0.0408577, 0.00548944, 0.0140424, -0.0206143, 0.0602782, -0.0244419, 0.0236312, 0.0322843, -0.00357687, -0.0318271, 0.0363446, 0.0235681, 0.0332633, 0.0524898, -0.065443, -0.0384351, -0.0205944, -0.0839359, -0.038936, -0.015246, -0.0452387, -0.037152, -0.00123531, -0.0427683, -0.0101363, -0.0301781, -0.0442546, -0.0219812, -0.012789, 0.0544246, -0.0102481, -0.0771559, 0.0255692, 0.0137054, 0.016345, 0.0332715, -0.00373366, 0.0693489, -0.031547, 0.0324411, 0.0118043, -0.0743356, 0.00689565, -0.0165311, -0.0167949, -0.0096692, -0.0166265, 0.0663529, 0.0508254, 0.0370