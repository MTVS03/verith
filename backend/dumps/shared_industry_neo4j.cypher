MERGE (c:`Chunk` {`id`: '086520-0024-7173f96a'}) SET c += {`text`: '[에코프로] 3. 원재료 및 생산설비 > [환경사업부문] > 나. 생산 및 설비\n(2) 탄소배출권 사업(SDM 사업)\n당사는 경쟁력 높은 온실가스 저감 기술력을 확보 하고 있으며 이를 바탕으로 탄소배출권 사업(SDM 사업)에 진출, 미래성장동력을 확보 하고자 합니다. 해당 사업은 해외 기업에서 온실가스 저감 기술을 지원하여 가스 배출량을 감축 하고 이를 UNFCCC 기구로부터 인정 받아, 한국의 탄소배출권 시장에 판매하는 구조 입니다. 당사는 중국 내 다수의 질산 제조 기업에게 N2O 제거 기술 및 처리설비를 제공하고 감축을 통해 인정 받은 탄소배출권을 판매 하고자 합니다. 이를 위한 설비 투자를 계획하고 있으며 자세한 내용은 이사회 결의 등을 통해 투자계획이 확정되는대로 관련 공시를 제출할 예정입니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [환경사업부문] > 나. 생산 및 설비', `idx`: 24} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0938265, -0.00131103, -0.0071842, -0.0205276, -0.0520732, -0.00033905, -0.040636, 0.0354495, -0.0640852, 0.0573383, 0.0078625, -0.00511151, 0.0210132, 0.0217413, 0.0183396, -0.0142857, 0.0369656, -0.0526719, 0.0182583, 0.0587582, 0.0623617, -0.0187169, 0.0394448, -0.00961694, 0.071123, -0.0204234, 0.0476356, -0.0420712, -0.00133057, 0.0347658, -0.0521119, 0.0554849, -0.0180573, -0.00269424, -0.0343883, 0.021701, 0.027846, 0.0173047, -0.0223017, 0.0611542, 0.0463146, -0.000443694, 0.0694686, -0.0523339, -0.0053928, -0.00871055, -0.0505291, 0.0100856, -0.0569052, -0.0111647, -0.0462748, 0.00900028, -0.0227758, -0.00706001, -0.0100058, -0.0459602, -0.0631087, -0.0315423, -0.0320858, 0.0783614, 0.00213719, -0.0587672, 0.0123546, -0.0440979, -0.0106616, -0.0390292, 0.0669689, -0.0335793, 0.00369628, 0.0234082, 0.0329423, -0.0316097, -0.0528593, -0.0871771, -0.00513403, -0.0203586, -0.0470879, -0.00347517, 0.0687858, -0.0469906, -0.0181111, 0.0262443, -0.0386815, 0.00105576, 0.00863767, -0.0315866, -0.000697856, 0.0574185, -0.0344625, -0.0234786, -0.00528567, -0.0280778, -0.0243534, 0.021793, 0.027584, 0.0151822, -0.0791433, 0.00720137, -0.00298917, -0.0