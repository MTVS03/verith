MERGE (c:`Chunk` {`id`: '086520-0071-693fb7dc'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > [전지재료사업부문] > 바. 파생상품\n회사는 환위험을 회피할 목적으로 파생상품 계약을 체결하고 있으나 위험회피회계는적용하지 않습니다.\n당기말과 전기말의 파생금융상품의 내역은 다음과 같습니다.\n(단위: 천원)\n구    분\n당기말\n전기말\n파생상품부채\n통화선도부채\n-\n1,957,620\n□ 에코프로이노베이션(연결)', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [전지재료사업부문] > 바. 파생상품', `idx`: 71} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0343996, -0.0211899, 0.0169114, -0.0330766, -0.0585562, 0.0425927, 0.0789648, 0.0645108, -0.0489683, 0.0612055, 0.0333661, 0.0280592, 0.0279744, 0.0138006, -0.0366149, 0.00446276, 0.0200251, -0.0243011, 0.00182521, -0.0221149, -0.0180423, 0.000260618, 0.00746167, 0.0101381, 0.0290884, -0.0409991, -0.0621336, -0.00922327, -0.0159987, 0.0404219, 0.0134782, 0.0436795, -0.0444736, 0.0116698, 0.0122328, 0.0481646, -0.0290306, 0.0317209, 0.000421076, 0.010537, 0.0256345, 0.0117469, 0.0153043, -0.0721353, 0.0281228, -0.042951, -0.0467579, -0.0418192, 0.0305566, -0.0283338, -0.0349563, -0.0685117, 0.053478, -0.0284733, 0.037501, -0.00200304, -0.0500519, 0.0173028, 0.0443853, -0.0281266, 0.0783823, -0.080877, 0.0277515, -0.0799694, 0.0238867, -0.0211841, -0.0273078, 0.00148148, 0.0425151, 0.0604285, 0.0104801, 0.0561331, -0.0132607, 0.0563673, -0.0116035, 0.0569889, -0.0171337, 0.0307732, 0.0809544, 0.0854809, 0.0788185, -0.018461, -0.0275684, 0.00983465, 0.0329097, 0.0170529, -0.0300058, -0.04051, -0.00370269, 0.00622618, -0.0339146, -0.0774072, 0.0388847, -0.0101594, -0.0121078, -0.0293099, -0.0548621, 0.00877506, -0.000446151, -0.00918383, 0.0343458, 0.0280847, 0.0545488, -0.0355867, -0.0257814, -0.0114251, -0.0537393, 0.0352393, 0.00032282, -0.0326927, -0.00468482, 0.01387, 0.0402494, 0.00555703, 0.0118312, 0.00827646, -0.0481564, -0.0116478, 