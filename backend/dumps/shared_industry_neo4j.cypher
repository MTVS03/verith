MERGE (c:`Chunk` {`id`: '003670-0048-9f8ca0ef'}) SET c += {`text`: '[포스코퓨처엠] 7. 기타 참고사항 > [(주)퓨처그라프] > 사. 신규사업\n최근 AI데이터센터 투자확대에 따른 ESS 수요 급증에 따라 흑연 음극재 필요량도 크게 늘어나고 있습니다.\n이에 당사는 구형흑연의 안정적 확보를 위해 새만금산업단지 내 구형흑연 생산설비 건설을 추진중에 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [(주)퓨처그라프] > 사. 신규사업', `idx`: 48} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0371271, 0.0445069, -0.0397765, -0.0310354, -0.0718133, -0.00172877, -0.0162484, 0.0765387, -0.0199063, -0.0311906, 0.0345377, -0.0448812, -0.00959622, 0.0140998, 0.0310009, -0.0303806, 0.0703223, -0.000164029, -0.0152807, 0.0225355, 0.0261552, 0.00663766, 0.0166303, -0.0335411, 0.0123354, 0.0393149, -0.0400569, 0.0220116, 0.0224943, -0.00235785, 0.0301985, 0.0341786, 0.0207033, -0.00144991, 0.0173439, 0.0108136, 0.0237618, 0.0236582, -0.0352791, -0.0222839, 0.0103313, 0.0285195, -0.00342294, -0.0367045, 0.00853903, -0.0273134, -0.0333678, -0.0518834, 0.0405629, -0.0200012, 0.00555309, 0.0677344, 0.000953191, 0.0249459, 0.0401107, 0.0256741, -0.0789474, -0.0287921, 0.0812021, 0.0297706, -0.0746813, -0.0534511, 0.0190121, -0.0574342, 0.05725, -0.0737217, 0.0329619, 0.00539349, -0.00598626, 0.0183526, -0.000691674, 0.0304955, 0.00962426, 0.0260628, -0.00978673, -0.00953623, 0.0199188, -0.0785454, 0.00385838, -0.0125662, 0.0652692, -0.0233903, -0.0370233, 0.014555, -0.0371745, -0.0244044, -0.0363315, 0.0369015, 0.000448415, -0.050038, 0.0132921, -0.0766233, -0.0550687, 0.0428373, -0.0183499, -0.0259537, 0.0400517, -0.0229642, -0.05119, -0.00235188, -0.010916, -0.035506, -0.0279365, -0.0108967, -0.00737303, 0.0496283, -0.0332234, 0.00518414, -0.0759074, 0.014049, -0.00963874, 0.0497995, 0.0419067, 0.0270958, -0.0281855, -0.0489837, 0.0152628, 0.0340124, 0.0508568, -0.0203686, -0.0749689,