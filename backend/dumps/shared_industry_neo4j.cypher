MERGE (c:`Chunk` {`id`: '086520-0057-dfa31674'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 시장위험과 위험관리 (연결기준)\n연결회사는 미사용 차입금 한도를 적정 수준으로 유지하고, 영업 자금 수요를 충족시키기 위해 차입금 한도나 약정을 위반하는 일이 없도록 유동성에 대한 예측을 항시 모니터링하고 있습니다.\n유동성 위험 분석에서는 연결회사의 다음의 금융부채를 계약상 만기별로 구분하였습니다.\n- 모든 비파생 금융부채\n- 순액 및 총액 결제 파생상품 중 계약상 만기가 현금흐름의 시기를 이해하기 위해 필요한 경우\n유동성 위험 분석에 포함된 금액은 계약상의 할인되지 않은 현금흐름입니다. 금융보증계약 이외의 12개월 이내 만기가 도래하는 금액은 현재가치 할인의 효과가 중요하지 않으므로 장부금액과 동일합니다. 금융보증계약은 즉시 지급을 요구받을 수 있으므로 계약금액 총액이 3개월 미만 구분에 포함되어 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 시장위험과 위험관리 (연결기준)', `idx`: 57} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0250275, 0.0274945, -0.00185274, -0.0302424, -0.0650341, 0.015142, 0.0726489, 0.0555615, -0.0155561, 0.0247819, 0.0332651, -0.0122843, 0.0645652, 0.0215094, -0.00738723, -0.00593212, 0.00739051, 0.0256423, -0.0135181, 0.00892503, 0.00183451, -0.024997, -0.0163315, -0.017569, 0.0230245, -0.0177496, -0.090364, -0.0500882, 0.0351167, 0.0786113, 0.0471743, 0.0610698, -0.0329641, 0.0130724, 0.0287856, -0.0389007, 0.00114416, -0.0198637, -0.0319371, 0.0779239, 0.0380445, -0.0133633, 0.0293691, -0.0178099, 0.0407456, -0.058353, 0.019112, 0.0233496, -0.0357595, -0.0130466, -0.0260963, -0.0751245, 0.0366658, -0.0172869, 0.0631191, -0.0052753, -0.0439052, -0.0016127, 0.0842979, 0.0142858, 0.0350355, -0.0584641, -0.00409281, 0.00105603, 0.067469, -0.0870261, 0.0462137, -0.0443592, 0.0438539, 0.0147088, 0.0249815, 0.0118532, 0.0180082, -0.00280161, -0.00735176, 0.0274499, -0.0324921, -0.0182267, 0.0499926, -0.00690135, 0.0361502, -0.0148085, -0.00158922, 0.0127957, -0.0375719, 0.050367, -0.0425071, -0.0209801, -0.0118121, 0.0205301, 0.00148928, -0.0362172, 0.0407935, 0.0285746, -0.00750627, -0.0234469,