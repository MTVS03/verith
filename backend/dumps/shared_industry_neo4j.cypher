MERGE (c:`Chunk` {`id`: '096770-0041-84aa17e9'}) SET c += {`text`: '[SK이노베이션] 3. 원재료 및 생산설비 > [SK온㈜] > 가. 생산능력 및 생산능력의 산출 근거\n미국 제 1공장은 2021년 3분기말부터 부분 가동을 시작한 후, 단계별 증설을 거쳐 현재  10.3GWh/년의 생산능력을 확보하였으며, 미국 제 2공장은 2022년 3분기 가동을 시작하여11.7GWh/년의 생산능력을 확보하였습니다.\nBlueOval SK(SK온 Ford 합작 법인) 켄터키 1공장은 2025년 3분기 부분 가동을 시작하여,전체 생산능력의 8.3%인 3.1GWh/년의 생산능력을 확보하고 있습니다.\n*** 중국 창저우 공장(법인명 : Beijing BESK Technology Co., Ltd.)과 중국 후이저우 공장(법인명 : Huizhou EVE United Energy Co., Ltd) 경우 당사의 실질적 생산 거점이지만, 회계상 공동기업으로 분류하고 있어 상기 생산능력에서 제외하였습니다.\n② 최대생산능력의 산출 상세\n▶ 기말 최대 생산능력(GWh/년)을 기준으로 하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [SK온㈜] > 가. 생산능력 및 생산능력의 산출 근거', `idx`: 41} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0211207, 0.0573414, 0.0232699, -0.00110626, -0.0982263, 0.0494644, -0.0275331, 0.0613464, 0.0637308, 0.020118, 0.0668633, 0.00861074, 0.0390814, 0.00200578, -0.0129646, -0.0154004, 0.00890381, 0.00913815, -0.0722195, 0.0126267, 0.0558351, -0.0117253, 0.0345697, 0.0425907, 0.0877219, -0.0482694, 0.0110907, 0.0495472, -0.0162378, 0.0201294, 0.050066, 0.0292726, -0.0125633, -0.0151973, 0.0471948, -0.0226558, -0.0330284, 0.0905289, -0.0420926, 0.0596847, 0.0174258, -0.0263291, 0.0776963, -0.0321083, -0.0116038, -0.0448942, -0.0278645, 0.00771401, -0.0545389, 0.0265334, 0.0330092, -0.0225145, 0.024618, 0.0379701, 0.100347, 0.0315855, -0.0350278, 0.0196587, -0.0114299, 0.0537473, -0.0902823, 0.0614593, -0.00986432, -0.0981267, 0.0427694, -0.0958276, -0.019512, 0.0348943, 0.0174678, 0.0584284, -0.0163942, 0.0593759, -0.0104034, -0.0650346, 0.00456103, 0.00585576, 0.000381404, -0.00870172, 0.0272726, -0.0299194, 0.0102189, -0.0234168, 0.000902136, -0.0349846, 0.0213098, -0.0893638, -0.00163421, 0.00616749, -0.0512041, -0.0115679, -0.01