MERGE (c:`Chunk` {`id`: '096770-0117-734c537f'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [SK에너지㈜] > 가. 파생상품계약 체결 현황\n(1) Commodity 파생상품계약 체결 현황\n당기말 현재 연결기업은 원유의 예상 매입 및 제품의 예상 매출에 대한 현금흐름의 변동위험을 회피하기 위하여 장내 및 장외 파생상품을 이용하고 있습니다. 또한, 연결기업은 석유제품 및 원유의 시장가격 변동위험을 회피하기 위하여 석유제품 스왑계약을 체결하고 있습니다. 한편, 관련 파생금융상품에서 발생한 손익은 유동성보증금에 반영하여 조정하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [SK에너지㈜] > 가. 파생상품계약 체결 현황', `idx`: 117} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00187449, 0.0261404, -0.0314361, 0.0175497, -0.0491621, 0.00532797, 0.0965903, 0.0632265, 0.0537738, 0.0155232, 0.0530268, 0.0179138, 0.0016226, 0.00969324, 0.0191706, -0.00277623, 0.0775805, -0.0385821, 0.00969853, 0.0204706, 0.00807532, -0.0113349, 0.0186873, 0.023209, 0.0633007, -0.0200046, -0.0278583, 0.00125808, -0.0201791, 0.0382582, 0.068573, 0.0501241, -0.0879368, -0.0168833, 0.0116941, -0.00968841, -0.0282035, 0.0687346, 0.00588435, 0.00866267, -0.0300201, 0.00820364, 0.082447, -0.0764816, 0.0717747, -0.0363026, -0.0159276, -0.0163668, 0.0260024, -0.00803193, -0.0517566, -0.0145743, 0.039731, 0.00725993, 0.0470662, -0.0335396, -0.0502213, 0.0084581, 0.0280657, -0.00711673, -0.00336404, -0.0511571, 0.0162149, -0.0629477, 0.0200553, -0.0423177, 0.0319576, 0.0406581, -0.0678111, 0.0217869, 0.00463617, 0.0523008, 0.00179336, 0.0535205, -0.0303935, 0.0666695, 0.0298256, -0.0243268, 0.09831, -0.0136646, -0.0130946, 0.0500756, -0.000431611, 0.0278447, -0.0189463, 0.019169, -0.0146106, -0.0147487, 0.0211541, 0.0318132, -0.00678612, -0.0569974, -0.000629738, -0.000306952, 0.00919617, -0.0249717, -0.0464296, 0.0266375, -0.024757, -0.0215926, -0.0222945, -0.0228458, 0.0565145, -0.0837032, -0.000399606, 0.0490727, -0.0216744, 0.0939075, 0.00206428, -0.0355497, 