MERGE (c:`Chunk` {`id`: '247540-0034-c2d38142'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > [EV 시장]\n2024년에 EV 시장은 중국 내수 시장의 탄탄한 기반과 정책 지원을 바탕으로 전년 대비 높은 성장을 이어갔습니다. 2024년 글로벌 전기차 판매량은 총 1,766만대로 2023년 판매량인 1,401만대 대비 26% 증가하였습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [EV 시장]', `idx`: 34} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0303978, -0.0672216, 0.0692631, -0.0218338, -0.034423, 0.0437288, -0.0315173, 0.0140454, -0.072025, 0.0627391, -0.0137384, 0.0143273, 0.0434517, 0.0389303, -0.0413322, -0.0548007, -0.00986717, -0.0577719, -0.071249, -0.0326175, -0.0114276, -0.00331743, 0.0568258, -0.0196313, 0.0295193, -0.0185222, -0.00774473, 0.033867, -0.0578872, 0.0332815, -0.0603445, -0.00766994, 0.0278275, 0.0231227, -0.00842264, 0.0666223, -0.0067861, -0.0469051, -0.0518134, 0.00672873, -0.0119599, -0.0252268, 0.0780878, 0.0117403, -0.0639832, -0.0727035, -0.0719647, -0.00505223, -0.00810795, -0.00323656, -0.028662, -0.00266217, 0.00467144, 0.0991166, 0.0457524, 0.0725026, -0.00809052, 0.0359953, -0.0200663, -0.00527528, -0.0660447, 0.0124664, 0.0561906, -0.0217816, 0.0321911, 0.00159253, 0.0154717, -0.00853985, 0.0161047, 0.0507843, 0.033514, 0.0215879, 0.0534043, 0.0309178, 0.0383244, -0.00660406, -0.0164369, 0.0105057, 0.0475395, -0.0356801, -0.025574, -0.0257934, 0.0185864, -0.0405301, 0.00147908, -0.085692, -0.00736212, 0.0256792, -0.0506576, -0.00449828, -0.0828586, -0.0254675, 0.0638137, -0.0453459, -0.0204612, 0.00344549, 0.00215201, -0.0262142, -0.0424593, 0.000971036, 0.0286133, 0.0307543, -0.00110692, -0.00456923, 0.013131, 0.00369203, 0.0099428, -0.00594482, -0.062797, 0.00150118, -0.0432074, -0.0832992, 0.0158103, 0.0148968, -0.000543324, -0.0097068, -0.0106679, 0.0121919, 0.00815977, -0.0267059, -0.0563283, -0.03