MERGE (c:`Chunk` {`id`: '361610-0028-234d0803'}) SET c += {`text`: '[SK아이이테크놀로지] 7. 기타 참고사항 > [연도별 상표권 등록 건수] > 다. 환경물질의 배출 또는 환경보호와 관련된 정부규제의 준수 여부\n(3) 폐기물 관리\n- 당사에서 발생하는 모든 폐기물은 적법한 폐기물 처리전문업체를 통해 위탁처리 하고 있습니다. 당사는 2022년 7월 기업의 자원재활용 수준을 평가하는 ZWTL (Zero Waste To Landfill) 인증 Gold 등급을 획득 및 지속 갱신하는 등 폐기물의 재활용율을 높이기 위한 노력을 지속하고 있으며, 폐기물 최소화에 중점을 두고 \'2030년 액상/고상 Zero Waste(재활용 100%)\' 목표를 수립하여 생산활동에서 발생하는 폐기물은 최소화하고, 재활용률을 향상시키는 다양한 방안을 실행 중입니다. 또한 소셜 벤처 사업 등을 통해 폐배터리 분리막을 의류 소재로 활용하는 등의 폐기물 업사이클링도 실천하고 있습니다.\n(4) 화학물질 관리', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [연도별 상표권 등록 건수] > 다. 환경물질의 배출 또는 환경보호와 관련된 정부규제의 준수 여부', `idx`: 28} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0512845, 0.0247242, -0.0131931, -0.00991408, -0.0553021, -0.00823728, -0.015637, -0.0105101, -0.0988632, 0.0503513, 0.0405484, 0.0864821, -0.00514677, 0.0467597, 0.0614073, -0.0292692, -0.0419271, 0.0266543, -0.0147384, 0.000725783, 0.0357956, -0.0466079, 0.0341785, 0.0042084, 0.0287659, -0.0217483, -0.0364488, -0.0463928, 0.00211845, 0.00590305, 0.0579158, 0.0586335, -0.0678359, -0.0190315, -0.00420267, -0.0554534, -0.00343537, 0.00864258, -0.0178693, 0.0484202, -0.0181142, -0.0217636, 0.0762286, -0.0448807, 0.00218245, -0.0283947, -0.0171479, 0.0208512, -0.0262512, -0.0136882, 0.00285296, -0.00135457, 0.0402091, 0.0205378, 0.0259722, 0.0402516, -0.0662812, 0.00985554, 0.0333879, 0.0345138, -0.0176644, -0.0030836, 0.0968544, -0.0147119, -0.0384025, -0.0808576, 0.000705906, 0.00525533, -0.0236284, 0.0158295, 0.0541056, 0.0578823, 0.0218458, -0.0441458, -0.0605142, -0.0316015, -0.0733018, -0.00629016, 0.0662411, 0.0167604, 0.0213025, 0.0129257, 0.0452413, 0.0578352, 0.00447953, 0.0416076, -0.0523062, -0.0133112, 0.00683337, -0.0346586, -0.0120836, 0.0227664