MERGE (c:`Chunk` {`id`: '066970-0006-58d4e10d'}) SET c += {`text`: '[엘앤에프] 2. 부문별 연결재무정보\n당기 및 전기의 일반정보와 재무현황은 다음과 같습니다.\n(단위 : 원)\n구분\n제26(당)기\n제25(전)기\n매출액\n2,154,938,965,103\n1,907,478,512,809\n영업손익\n(156,849,943,423)\n(558,685,355,192)\n영업외수익(비용)\n(410,902,715,058)\n39,178,251,751\n법인세차감전순이익\n(567,752,658,481)\n(519,507,103,441)\n재고자산\n594,884,184,426\n574,563,984,034\n유ㆍ무형자산\n1,340,342,140,096\n1,276,832,070,484\n총자산\n3,134,104,265,112\n2,799,831,517,733\n총부채\n2,457,280,374,466\n2,076,483,586,372\n주요재화 및 용역\n2차전지용 양극활물질 외\n2차전지용 양극활물질 외\n주1) 당사와 연결대상 종속회사는 2차전지용 양극활물질관련 사업을 영위하고 있습니다.\n주2) 한국채택국제회계기준(K-IFRS)에 따른 연결재무제표기준으로 작성하였습니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 부문별 연결재무정보', `idx`: 6} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.000547326, 0.0412281, 0.0250441, -0.0375352, -0.0454114, 0.00790001, 0.0400405, 0.0173093, -0.0403822, 0.00279509, 0.0386846, 0.0272438, 0.00375634, 0.0243063, -0.0151349, -0.0275093, 0.0517127, -0.0453871, -0.0428746, -0.0483165, -0.0049596, 0.0103507, -0.00438211, 0.00538543, -2.60968e-05, 0.00909976, 0.00186233, -0.0389308, -0.0371029, -0.00776603, -0.0397884, -0.0134006, -0.0706865, -0.00175447, -0.000346733, -0.00271741, -0.0201233, 0.0639434, -0.0896578, 0.00219935, -0.016361, 0.0293747, 0.0491204, -0.0391528, 0.0105249, 0.0174247, 0.01097, 0.017361, 0.0123216, 0.0202267, -0.0401711, -0.0089776, 0.0430445, -0.0467587, 0.0109741, 0.0189237, -0.116402, 0.00230683, -0.00178547, 0.0434182, -0.0178114, 0.00650368, 0.0480645, -0.0251175, 0.049568, -0.0269383, -0.0311214, 0.0410539, 0.01239, 0.0374084, -0.0134154, 0.0035175, 0.0418394, 0.0106687, 0.0130148, 0.0444606, 0.0089544, 0.024579, 0.0831989, -0.0521353, 0.0257034, 0.0312066, -0.043945, -0.00945316, -0.00067313, 0.0130655, -0.0277447, 0.0