MERGE (c:`Chunk` {`id`: '066970-0008-85d57872'}) SET c += {`text`: '[엘앤에프] 2. 주요 제품 가격변동추이\n당사의 주요 제품은 2차전지 양극활물질입니다. 당사의 가격경쟁력 제고 및 경쟁사에 대한 정보유출 우려 등을 감안하여 상세한 표기는 하지 않을 예정이며, 원자재의 대부분을 광물자원에서 추출함에 따라 국제 광물자원 수급에 따라 가격변동 요인이 있습니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 주요 제품 가격변동추이', `idx`: 8} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0535755, 0.00423068, -0.0473095, -0.0177003, -0.0704741, -0.0857727, 0.0249967, 0.0661643, -0.0325957, -0.011034, -0.000963944, 0.0418096, -0.0656705, -0.0496851, -0.0177333, 0.0212151, 0.0376521, -0.00726848, -0.0205277, -0.0410754, -0.0594508, -0.00111957, 0.01329, 0.00656436, 0.0564263, 0.0266731, -0.0173254, 0.00161514, -0.0284063, 0.029501, -0.0230065, 0.0413207, -0.0585377, -0.00885668, -0.0123158, 0.0370998, 0.011505, 0.0298178, -0.0318555, 0.0488087, -0.0315978, 0.0363667, 0.0334287, -0.0069342, -0.00642368, -0.0185348, -0.0257425, -0.0634321, 0.0147703, -0.0588253, -0.0137932, -0.0212777, 0.0173987, -0.0110699, 0.0619573, -0.00241172, -0.0929781, -0.0134062, -0.0238924, -0.0117016, -0.0122911, -0.00608023, 0.01556, -0.000279983, 0.0175722, -0.0118363, 0.0391318, 0.00995129, -0.0128799, -0.0219013, -0.0277199, 0.0326822, -0.00362691, 0.0372672, 0.0444157, 0.0525921, 0.0248319, -0.0332342, 0.0371864, 0.0392375, 0.0290989, 0.026248, -0.0465868, -0.0100222, 0.0332284, -0.0182617, 0.00031961, -0.0434253, -0.0530643, -0.0412809, -0.0460617, -0.0342997, 0.02557, 0.0548066, 0.025468, 0.03593, -0.0561202, -0.00342308, 0.0224277, 0.0108208, -0.00757788, 0.0415104, -0.00447048, -0.0179697, 0.0986936, 0.0145333, -0.0144924, 0.063217, -0.0416636, 0.0446311, -0.0278113, -0.00740593, 0.0130562, -0.00346906, -0.0113053, -0.0165797, -0.0390149, 0.00992233, 0.0782945, 0.00658238, -0.0593847, -0.046462, -0