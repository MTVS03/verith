MERGE (c:`Chunk` {`id`: '247540-0001-520446d0'}) SET c += {`text`: '[에코프로비엠] 1. 사업의 개요\n당기 중 NCA/NCM을 포함한 당사 양극활물질은 연결기준 약 2조 5,316억원의 매출성과를 달성하였으며, 당사 및 종속회사의 사업의 내용은 동일합니다. 당사는 전지재료 계열사와 함께 원가, 품질 및 가격 경쟁력 확보를 위한 업스트림 밸류 체인을 확대하여 시장 내 차별화된 지위를 확고히 할 것입니다.\n* 출처 : 한국IR협의회, NICE디앤비 에코프로비엠기술분석보고서, 당사 재구성', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 사업의 개요', `idx`: 1} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.046475, -0.0123681, 0.0235933, -0.0422162, -0.0230994, -0.00593355, -0.00361577, 0.0291886, -0.055519, 0.0631269, 0.0830797, 0.0437688, -0.00728187, -0.0202766, -0.0254964, -0.0105362, 0.0323978, -0.0343595, -0.0272537, -0.0499816, -0.032817, 0.00208445, 0.0309149, 0.0220172, 0.0423992, -0.0251758, 0.0494672, 0.0179949, -0.0257533, 0.0412988, -0.0204407, -0.0217648, -0.0351258, -0.00993249, 0.0232221, 0.0370472, -0.0175129, 0.0117597, -0.0260672, 0.0651629, 0.0403349, 0.0315015, 0.00506836, -0.0388645, 0.0137313, -0.0261805, 0.022636, -0.0301427, -0.0103634, -0.0524054, -0.0229791, -0.0221852, 0.0291375, 0.0298609, 0.0309692, 0.0349699, -0.100299, -0.0229769, -0.00770094, 0.0312192, 0.0635049, -0.0416157, 0.0518251, -0.0164385, 0.0345748, -0.0210549, -0.013602, -0.00864039, 0.0417958, -0.00313804, 0.0141864, 0.0194101, 0.0204024, -0.0600715, 0.0199203, -0.0181185, -0.00558466, -0.0441897, 0.0823007, 0.0137028, 0.0120846, 0.0233909, -0.0397842, -0.0126226, 0.00403387, 0.0452198, -0.0611885, -0.0103068, 0.00576683, -0.0798234, -0.0377509, -0.0435227, -0.00639446, 0.0212626, 0.0386139, 0.00444914, -0.0484662, -0.0542139, 0.0579617, -0.00227697, 0.0136215, 0.0573123, 0.0289302, -0.00652866, 0.00139152, -0.044395, -0.0576109, 0.0127507, -0.0725427, -0.0241714, 0.0134533, -0.0475151, 0.00320051, 0.00550005, -0.018516, -0.033086, -0.00310298, 