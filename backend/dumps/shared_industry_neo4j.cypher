MERGE (c:`Chunk` {`id`: '361610-0004-d90fad90'}) SET c += {`text`: '[SK아이이테크놀로지] 3. 원재료 및 생산설비 > 가. 주요 원재료\n(1) 주요 원재료 등의 현황\n(기준일 : 2025년 12월 31일)\n(단위 : 백만원)\n사업 부문\n매입 유형\n품목\n구체적\n용도\n제7기\n(2025년)\n제6기\n(2024년)\n제5기\n(2023년)\n매입액\n매입액\n매입액\nLiBS\n원재료\n매입\nPE\n분리막\n생산\n11,202\n10,421\n51,586\n코팅원료\n7,605\n14,187\n38,225\n윤활기유\n9,884\n8,175\n23,523\n(2) 주요 매입처\n품목\n매입처\n특수관계 여부\nPE, 코팅원료 등\n대한유화 등\n미해당\n윤활기유\nSK온(주)\n해당\n(주1)\n주요 원재료인 PE는 대한유화 등 복수의 공급업체로부터 안정적으로 매입하고 있습니다.\n(주2)\n윤활기유는 SK온(주) (舊 SK엔무브(주)) 계열로부터 상당부분 공급 받고 있습니다.\n(주3)\n윤활기유 공급자인 SK엔무브(주)는 2025년 11월 1일 자로 SK온(주)와 합병하였습니다.\n(3) 주요 원재료의 가격변동추이\n- 당사 주요 원재료의 가격은 고객사와의 계약에 따라 결정되어 영업기밀에 해당됩니다. 따라서 동 사항에 대한 세부 내용을 공시할 경우 당사의 영업에 현저한 영향을 미칠 수 있다고 판단하여 세부 내역은 기재하지 않았습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > 가. 주요 원재료', `idx`: 4} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0121394, 0.0333958, -0.0243502, -0.00279212, -0.0392361, -0.0628242, -0.0111566, 0.0105267, -0.0168443, 0.0272953, 0.0231668, 0.0179715, 0.0309477, 0.0317158, -0.0324018, -0.00415852, 0.0158436, -0.0296922, -0.0196275, 0.0154223, 0.0229188, -0.025026, -0.0114059, 0.0279689, 0.107091, -0.0489452, 0.000835172, 0.00850504, -0.00597122, 0.020389, 0.00617702, 0.0442588, -0.062961, 0.00262685, 0.0200718, -0.0403594, 0.0256765, 0.0233709, -0.0320238, 0.0691941, -0.0338443, 0.0194328, 0.0517057, -0.0402131, 0.0344532, -0.000976732, -0.0242513, 0.023682, -0.0186529, -0.052436, -0.0448255, -0.00889699, 0.0392819, -0.0523776, 0.0823631, 0.0282887, -0.0614338, 0.00311131, 0.0299469, 0.0630452, -0.0716138, 0.0213565, 0.075509, 0.00997077, 0.0472392, -0.0502687, 1.04144e-05, 0.0539889, -0.0216902, -0.0071917, -0.0494081, 0.0792872, 0.0339711, 0.0468028, -0.0282411, -0.0172592, 0.0414168, 0.0273394, 0.00