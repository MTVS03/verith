MERGE (c:`Chunk` {`id`: '086520-0060-a80ab696'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 본 사채를 소유한 자가 전환청구를 하기 전에 발생회사가 시가를 하회하는 발행가격으로 (i) 유상증자 또는 주식관련사채를 발행하거나 (ii) 무상증자, 주식배당, 준비금의 자본전입 등을 하는 경우에는 전환가액을 아래의 산식에 따라 조정하기로 한다.\n조정후 전환가액 = 조정전 전환가액 × [{A+(B×C/D)} / (A+B)]\nA : 기발행주식수\nB : 신발행주식수\nC : 1주당 발행가격\nD : 1주당 시가', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [전지재료사업부문] > 가. 본 사채를 소유한 자가 전환청구를 하기 전에 발생회사가 시가를 하회하는 발행가격으로 (i) 유상증자 또는 주식관련사채를 발행하거나 (ii) 무상증자, 주식배당, 준비금의 자본전입 등을 하는 경우에는 전환가액을 아래의 산식에 따라 조정하기로 한다.', `idx`: 60} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0104925, -0.00514887, 0.0269306, -0.0454227, -0.027842, 0.0298211, 0.0328046, 0.0712849, -0.00222399, 0.0122123, 0.0127056, 0.0592814, 0.01712, 0.00426116, 0.00778036, -0.0326278, -0.0124686, -0.00121183, -0.0116656, -0.0251449, -0.0401048, -0.0208794, 0.0719476, 0.0162223, 0.0529919, -0.00861239, -0.033238, -0.014766, 0.0292856, 0.0213615, 0.0177916, 0.0421791, -0.0532658, -0.062771, 0.0161688, -0.00654544, -0.0163309, 0.0225866, -0.0318641, 0.0545723, 0.0246805, 0.000393422, -0.00861395, -0.0507484, 0.0365105, -0.00486082, 0.0297046, -0.0230287, 0.00414385, -0.0478484, -0.0296788, 0.00658646, 0.0391423, 0.0466475, 0.0670157, -0.0364091, -0.0674052, -0.00302922, 0.00441928, -0.0350627, -0.0318731, -0.0671474, -0.00103757, -0.0489876, 0.012947, -0.0375152, 0.036305, 0.0117114, 0.0278185, 0.0720941, -0.0139025, -0.00723892, 0.0661526, 0.0398462, 0.0411808, 0.054332, 0.0507642, -0.0738422, 0.0419971, -0.00197845, 0.00296353, -0.00395297, -0.0643307, -0.0632979, -0.0145854, 0.0178317, -0.0284434, 0.0149989, 0.0105786, -0.0464582, 0.0202678, -0.0676751, -0.0242406, 0.0430109, 0.0654074, 0.0180903, -0.0963666, 0.0357959, -0.0248858, 0.00564672, -0.