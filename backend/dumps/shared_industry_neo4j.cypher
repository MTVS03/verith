MERGE (c:`Chunk` {`id`: '086520-0133-198af1d7'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [환경산업 특징] > 마. 경쟁력 확보 요인 및 회사의 강점\n사업의 경쟁력을 좌우 하는 요인은 대기오염 물질을 저감하는 과정에서 사용되는 전력, 가스 등의 에너지 비용을 최소화 하는 동시에 대기오염 물질 제거율을 높이는 것입니다. 에코프로에이치엔의 대기오염 저감 기술은 전방 고객의 특성을 연구하고, 이를 고려한 촉매 개발을 통해 에너지 비용을 최소화 하는 고효율 운영에 특화 되어 있습니다. 산업 내 경쟁자는 다수 있으나 당사만이 갖춘 기술력을 활용하여 사업의 성장을 지속하고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [환경산업 특징] > 마. 경쟁력 확보 요인 및 회사의 강점', `idx`: 133} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0556009, -0.0122015, 0.0544684, -0.0907242, -0.0575643, -0.0548245, -0.00652719, 0.0439492, -0.0146319, 0.0278602, -0.0261803, 0.00845004, -0.0143349, -0.0181519, 0.0392479, 0.050425, 0.0258774, -0.000128692, -0.0288309, -0.0317335, 0.0119139, -0.0208877, -0.0061879, -0.102995, 0.0559012, -0.00328831, -0.00492232, -0.014979, 0.00179872, 0.0872287, -0.0265232, 0.0765272, 0.0112076, 0.0225527, 0.0247035, 0.0737238, -0.0272326, 0.0567359, 0.0212408, 0.0791201, 0.00779253, 0.0209584, 0.00867897, -0.0223596, -0.0185986, -0.0333884, -0.027384, -0.00781326, -0.0581859, 0.00132768, -0.0353061, -0.05312, -0.0121515, -0.0588394, 0.0399354, -0.0219581, -0.0414912, -0.107239, -0.0271886, 0.0449832, 0.0530109, -0.0148644, 0.0319636, -0.0814992, 0.0224557, -0.00199243, 0.0556423, -0.0314727, 0.035082, 0.0156829, 0.0577054, -0.0221544, 0.000727451, -0.0365315, 0.0288457, 0.0344477, -0.0410328, -0.00275315, 0.00264735, -0.0275304, -0.0109328, -0.00496923, 0.0219713, 0.0448091, 0.0312774, -0.0695175, -0.045411, 0.0234204, 0.0040103, -0.0657186, -0.0215978, -0.0401498, 0.0139608, 0.000269176, 0.0906711, 0.00557017, -0.0766767, 0.00385293, -0.00757013, 0.0205586, -0.0572132, 0.0288191, 0.0451277, -0.0436694, 0.0135247, -0.114686, -0.00629791, 0.031346, -0.02836