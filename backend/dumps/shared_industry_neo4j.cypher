MERGE (c:`Chunk` {`id`: '006400-0026-6bd7c509'}) SET c += {`text`: '[삼성SDI] 6. 주요계약 및 연구개발활동 > 가. 경영상의 주요계약\n공시한 \'단일판매ㆍ공급계약 체결(자율공시)\'을  참고하시기 바랍니다.\n(6) 종속회사의 기타 판매ㆍ공급계약 체결\n당사의 종속회사인 Samsung SDI America, Inc.는 배터리 공급계약을 체결하였으며,\n기타 자세한 사항은 당사가 2026년 1월 30일 전자공시시스템(DART)에 공시한\n\'투자판단 관련 주요경영사항\'을 참고하시기 바랍니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '6. 주요계약 및 연구개발활동 > 가. 경영상의 주요계약', `idx`: 26} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.017741, -0.0213448, -0.00929034, -0.00559269, -0.0962023, -0.019191, -0.00637461, 0.0469983, -0.0101964, 0.0300494, 0.0421776, 0.00579892, 0.0231962, -0.0618518, -0.0214915, -0.0611376, 0.0505338, -0.0126581, -0.0518461, 0.0012656, 0.00843064, 0.0429654, 0.0618575, 0.0524363, 0.0185571, -0.0205765, 0.00268868, 0.0189724, 0.00178496, 0.00203351, -0.0212327, -0.0346308, 0.0168008, -0.0853458, 0.00644864, -0.0260788, 0.0181933, 0.011658, -0.0700287, 0.0256399, -0.0044134, -0.0617107, 0.0688964, -0.0917966, 0.0431515, 0.0131368, -0.0511346, -0.00387507, -0.0126222, 0.0220581, -0.0458778, -0.0259737, 0.00226203, 0.0400028, 0.0638535, 0.0470932, -0.0729999, -0.0325145, -0.0297784, 0.0289665, -0.00298044, -0.0287249, -0.0032074, -0.0967392, 0.0313348, -0.0381673, 0.0707052, -0.0274458, -0.0123243, 0.0259399, 0.0239415, -0.0159293, 0.0227799, 0.0291512, -0.0197031, 0.024073, -0.00165572, 0.0320566, 0.0422479, -0.0657657, -0.0267302, -0.0178016, -0.0257953, -0.00279457, -0.0664657, 0.0425058, -0.0588729, 0.0289267, 0.0147901, -0.00804485, 0.00364307, -0.0523068, 0.0406511, 0.0498234, -0.0190067, -0.0579209, 0.00517768, 0.0429893, 0.00783644, -0.0231331, -0.0340284, -0.0663036, 0.00327907, 0.0270807, 0.0363676, -0.0173514, -0.0429477, -0.00553062, -0.0771194, 0.0177063, -0.0214415, -0.0111735, 0.0208741, 0.0464991, 0