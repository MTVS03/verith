MERGE (c:`Chunk` {`id`: '086520-0053-7b491d0f'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > 나. 파생상품 및 풋백옵션 등 거래 현황\n차액정산 지급기한 및 금액\n- 투자자가 차액정산 청구권을 행사한 경우,대주주는 청구일로부터 1개월 이내 지급\n(만약 대주주가 차액정산기한까지 정산대상차액을 투자자에게 전액 지급하지 아니한 경우, 대주주는 투자자에게 차액정산기한의 다음 날부터 정산대상차액의 지급을 완료하는 날까지의 미지급 금액에 대하여 연 복리 8%의 이율에 따른 지연손해금을 가산하여 지급)\n종속기업인 ㈜에코프로이노베이션은 전기 중 지배기업 및 계열회사임직원에 대한 보통주를 발행 시 신주인수인과 주주간 약정을 체결하였습니다. 연결회사는 본 약정에따라 신주인수인이 지배기업 및 계열회사에서 퇴직하거나, 정직 이상의중징계를받는 경우 ㈜에코프로이노베이션의 기업공개 전까지 신주인수인이 보유한 주식 전부에 대해 보통주 발행가액에 연 3%의 복리를 가산한 금액(신주인수인의 귀책사유에 다른 퇴직 또는 정식 이상의 중징계의 경우 주당 발행가액)으로 콜옵션을 행사할 권리를 보유하고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 나. 파생상품 및 풋백옵션 등 거래 현황', `idx`: 53} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0366251, 0.0136254, 0.0180912, -0.0142837, -0.0573087, -0.0140293, 0.0131929, 0.0622186, 0.0321111, 0.0443478, 0.0682358, 0.0295403, 0.0326777, 0.00238567, -0.0135092, -0.0365639, -0.00374286, -0.0377593, -0.0383923, -0.0309991, 0.00570342, 0.0193618, -0.00161233, 0.0298157, 0.0300712, -0.0524772, 0.0183371, -0.0115957, 0.0429795, 0.0371118, -0.00334639, 0.0946963, -0.00516279, -0.0507601, -0.0286265, -0.0131586, 0.0492951, -0.0604666, -0.0177311, 0.0789596, 0.0249512, 0.0511309, -0.00788159, -0.0352644, 0.0728599, -0.00834032, -0.0352344, 0.0569748, 0.00436018, -0.0377408, -0.000529458, 0.0088031, 0.0375995, 0.0368, 0.0538226, 0.0289045, -0.0464075, -0.0196761, 0.0450823, -0.0055469, -0.0207327, -0.029816, -0.0698508, -0.0660798, 0.00551242, -0.0350687, 0.0368425, -0.0391142, 0.0319766, 0.0739759, -0.00447098, -0.0867478, 0.0348903, -0.0152659, -0.00126175, 0.0434621, 0.0600415, -0.00983335, 0.0443559, -0.0506361, 0.0576004, -0.0342617, 0.0166035, 0.0159588, -0.026149, 0.0145549, -0.0883453, 0.022302, -0.0530769, 0.003541