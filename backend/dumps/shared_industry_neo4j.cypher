MERGE (c:`Chunk` {`id`: '086520-0104-41a03be4'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [글로벌 전기차 시장 전망(~2035)]\n글로벌 전기차 시장 전망\n자료 : SNE리서치 (2024.12)\nSNE 리서치에서 발표한 자료에 따르면, 글로벌 전기차 판매는 2024년 1,650만대에서 2030년 4,199만대, 2035년에는 6,978만대까지 판매될 것으로 전망하고 있으며, EV용 배터리 수요는 2024년 834GWh 수준에서 2030년 2,277GWh, 2035년 4,394GWh까지 확대될 것으로 예상하고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [글로벌 전기차 시장 전망(~2035)]', `idx`: 104} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0321826, 0.0178076, 0.0491582, -0.0195949, -0.0563754, 0.0113773, -0.0764071, -0.036981, -0.0608393, -0.00159584, -0.00201222, 0.0216964, 0.00697522, -0.0263305, -0.0431752, -0.0261017, 0.0320272, -0.0868401, -0.0626809, -0.0445395, 0.0336601, 0.0377864, 0.0104258, -0.0113493, 0.0352836, -0.0167165, -0.0454389, 0.00530518, -0.0322585, 0.0453688, -0.0160812, -0.0071815, 0.0231068, 0.0717587, -0.0280358, 0.0295202, -0.0143638, 6.6858e-06, -0.0337304, -0.0158414, 0.0142917, -0.0659923, 0.0708837, -0.0279811, -0.114919, -0.0011844, -0.0648703, -0.0395934, 0.00191538, 0.0149132, -0.0559285, -0.0127799, -0.0160341, 0.104361, 0.0131363, 0.0872687, 0.0123787, -0.00750935, -0.0770469, 0.0130328, -0.0898916, -0.0035846, 0.0284341, 0.015278, 0.047034, 0.000302968, 0.0444011, 0.0172454, 0.0432872, -0.0119329, -0.0237087, 0.0223255, 0.0704019, 0.0429997, 0.00606112, -0.0345935, -0.0228597, -0.0225616, -0.012774, -0.0593365, 0.0231962, -0.0181199, -0.0214021, -0.0297936, -0.0109575, -0.0511446, -0.000204339, 0.0149331, -0.0437532, 0.0157542, -0.0646042, -0.0235333, 0.0545502, -0.00916283, -0.00721039, -0.0165653, -0.0760283, -0.0537346, -0.0236572, 0.0242348, 0.0109352, -0.00538021, -0.0174636, 0.0416148, -0.0330907, -0.0296078, 0.0172551, -0.0364268, -0.0117164, -0.00865902, -0.0790111, -0.0747