MERGE (c:`Chunk` {`id`: '086520-0102-d2330ffc'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [EV 시장]\n2024년에 EV 시장은 중국 내수 시장의 탄탄한 기반과 정책 지원을 바탕으로 전년 대비 높은 성장을 이어갔습니다. 2024년 글로벌 전기차 판매량은 총 1,766만대로 2023년 판매량인 1,401만대 대비 26% 증가하였습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [EV 시장]', `idx`: 102} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0288692, -0.0640882, 0.0738939, -0.0132752, -0.0466073, 0.0522415, -0.0402717, 0.00660185, -0.0770085, 0.0587937, -0.00993769, 0.011036, 0.0413678, 0.031088, -0.0430661, -0.0526402, -0.00583549, -0.0512971, -0.0621039, -0.0416321, -0.0265719, 0.00187973, 0.0527985, -0.019781, 0.0272881, -0.0132746, -0.00412348, 0.0299147, -0.0569331, 0.0290314, -0.0658955, -0.000824995, 0.0367227, 0.017594, -0.00612632, 0.0689914, -0.000835217, -0.0424275, -0.052578, 0.00465666, -0.0155124, -0.0313985, 0.0839395, 0.01456, -0.0652854, -0.0688271, -0.0731767, 8.20219e-05, -0.0168655, 0.00461589, -0.0384794, -0.00760707, 0.00027943, 0.090133, 0.0362671, 0.0730465, -0.0165061, 0.0413306, -0.0218592, -0.00393773, -0.0678477, 0.0196198, 0.0490982, -0.012353, 0.0264664, 0.00142174, 0.0191077, -0.0170361, 0.0164179, 0.0549985, 0.0375582, 0.0238429, 0.0568173, 0.0367623, 0.0525478, -0.00586568, -0.00753965, 0.00499635, 0.047845, -0.0448779, -0.0310355, -0.0261535, 0.0171264, -0.0387037, -0.00228127, -0.083931, -0.00171073, 0.0267504, -0.0514078, -0.00851877, -0.0863188, -0.0281763, 0.0528872, -0.0340299, -0.0268427, 0.0101295, -0.0010176, -0.0218148, -0.0515749, -0.00439212, 0.0302912, 0.0272939, 0.00311722, 0.00066869, 0.0153681, 0.00888696, 0.0158285, 0.00175661, -0.0567108, -0.0052981, -0.0369446, -0.0804413, 0.00455774, 0.0144839, 0.00887895, -0.0081859, -0.0171227, 0.0177263, 0.0089886, -0.0243293, -0.0528208, -0.0239535,