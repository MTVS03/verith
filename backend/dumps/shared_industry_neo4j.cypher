MERGE (c:`Chunk` {`id`: '066970-0017-9105f926'}) SET c += {`text`: '[엘앤에프] 2. 수주상황\n주4) 상기 2023년 2월 28일 체결 계약의 최초 확정 계약금액은 3,834,738,508,160원 이었으며 공급 물량 변경에 따라 계약금액이 변경되었습니다. 자세한 내용은 2025년 12월 29일 투자판단관련주요경영사항을 참고하시기 바랍니다.\n주5) 상기 2024년 4월 11일 체결 계약의 상대방은 현재 파산 및 제3자 인수가 진행되고 있는 것으로 파악되며, 이로 인해 향후 인수 계약 및 인수자와 협의에 따라 해당 계약의 이행 여부가 결정 될 것으로 예상됩니다. 자세한 내용은 2026년 3월 17일 투자판단관련주요경영사항을 참고하시기 바랍니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 수주상황', `idx`: 17} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0395931, 0.00676056, 0.0319871, 0.00431331, -0.0186001, 0.0626002, 0.0470998, 0.0546253, -0.0353173, 0.0106427, 0.0234354, 0.0267544, 0.0461412, -0.0359383, -0.0074604, -0.000425621, 0.0820179, -0.0647511, -0.00570464, 0.00236899, -0.0236485, 0.0219074, 0.00935176, 0.0135982, 0.0688841, -0.00475876, 0.0337566, 0.0247029, 0.0256722, 0.0352995, -0.0361079, -0.0259657, -0.0364435, -0.0396545, 0.0584229, 0.00622203, 0.06635, 0.00863423, -0.0327887, 0.0596822, -0.0506755, -0.0311224, -0.000741913, -0.0111864, 0.0312502, 0.0207967, -0.0304068, 0.00208141, -0.0357413, 0.0513278, -0.0542787, -0.00012005, 0.00621005, 0.0178361, 0.0591086, 0.00966439, -0.0346205, 0.0432485, 0.0133966, -0.00459736, -0.10545, -0.0191662, 0.0159549, 0.0154169, 0.0643751, -0.0412918, 0.0241082, 0.0189074, -0.00642177, 0.0254365, -0.0261653, -0.0171649, 0.0280468, 0.0459118, -0.0295626, 0.0490802, 0.0300071, 0.0417028, 0.074457, -0.0520075, 0.00761098, 0.00779148, -0.0497856, -0.02919, -0.00275156, -0.0195198, -0.0182425, 0.0267971, -0.0515153, 0.0157113, 0.00277425, 0.0136347, -0.0201665, 0.048784, 0.0229907, -0.0423121, -0.0487293, -0.0348981, 0.0518946, -0.0132506, -0.0263713, -0.0156039, 0.0117876, -0.00660417, 0.0370543, 0.0716572, 0.0266884, 0.0112355, -0.0487662, 0.0