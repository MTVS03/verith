MERGE (c:`Chunk` {`id`: '096770-0127-95abc34d'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > [SK인천석유화학㈜] > 다. 리스크 관리에 관한 사항\n환율변동 위험에 노출되어 있는 Position으로부터 발생 가능한 손실을 관리하기 위하여 환 Risk 관리정책을 수립하여 실행하고 있습니다. 이에 따라 당사가 감내 가능한 범위의 목표 익스포져를 설정하여 그 안에서 익스포져를 관리 중이며, 한도를 벗어나는 과도한 Position에 대해서는 헷지를 실시하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > [SK인천석유화학㈜] > 다. 리스크 관리에 관한 사항', `idx`: 127} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00857551, -0.0361438, -0.0252468, 0.00184965, -0.0585199, 0.00946679, 0.0033615, 0.0277599, 0.0666834, 0.00518228, 0.0688759, 0.0558551, -0.010812, 0.0564115, 0.0654604, -0.0141862, 0.0472822, -0.00892844, -0.0129489, 0.0380386, -0.00871714, -0.0731047, 0.00871357, 0.0525561, 0.00126188, 0.0289124, -0.0181504, 0.0336657, 0.0019399, 0.0376969, 0.0373963, 0.0604317, -0.110388, -0.0346396, 0.0155169, 0.0148567, -0.0155218, 0.00123138, -0.0155791, 0.0948532, 0.0076626, 0.0251674, 0.0461902, 0.0283458, 0.0575537, -0.0217035, -0.0131892, -0.0277088, -0.0427712, 0.0191017, -0.0238772, -0.0355381, 0.00729968, 0.0663467, 0.0440029, -0.00658585, 0.0209162, -0.0198284, 0.054627, 0.05767, -0.00289662, -0.0424659, -0.00645793, -0.0458809, -0.0157491, 0.000527079, 0.031913, 0.0769174, 0.0133721, 0.0200718, -0.0118302, 0.0751014, 0.0155826, 0.0452196, -0.0859067, 0.0122448, 0.00113334, -0.00228163, 0.0716785, 0.0351576, 0.0357504, 0.0421544, 0.0133235, 0.0477886, 0.00203089, 0.0588494, 0.0154701, -0.0736797, 0.0482938, -0.0434461, 0.00227104, 0.0146235, -0.0439492, -0.00387011, 0.0313766, -0.0198238, -0.0389955, 0.047295, -0.0157259, 0.00543349, 0.00262849, -0.033156, 0.0358549, -0.0753442, -0.0032345, 0.0210943, -0.0161261, 0.0592875, -0.0440066, -0.00891925, -0.0396167, 0.0139362, 0.0767938, 0.00962012, -0.05