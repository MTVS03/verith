MERGE (c:`Chunk` {`id`: '066970-0005-8c1b8270'}) SET c += {`text`: '[엘앤에프] 1. 사업부문별 현황\n특히 니켈 및 리튬은 최근 EV용 배터리 수요 증가 등으로 수요 구조 변화가 진행되고 있으며, 주요 생산국의 공급 정책 및 정제 능력 등에 따라 수급 여건이 변동될 가능성이 있습니다.\n한편, 당사는 원재료 조달 안정성 및 공급망 경쟁력 강화를 위해 LS그룹과 전구체 합작법인인 LLBS(㈜엘에스엘앤에프배터리솔루션)를 설립하였습니다. LLBS는 황산니켈 확보 역량과 전구체 공정 설계 및 제조 기술을 기반으로 국내 전구체 생산체계를 구축하고 있으며, 해외 시장 관련 규제 요건을 고려한 공급망 체계 마련을 추진하고 있습니다.\n이를 통해 당사는 전구체 조달 기반을 강화하고 공급망 안정성을 제고하고 있습니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 사업부문별 현황', `idx`: 5} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.035499, 0.0296932, -0.00332286, -0.0152173, -0.0369576, -0.0209139, -0.0157269, 0.0610539, -0.00357263, -0.0383376, 0.0199929, 0.0178568, -0.0275981, 0.0292097, 0.00252823, 0.0122546, 0.0664276, -0.0259685, -0.0486318, -0.0432922, -0.0525372, -0.0224466, 0.0263377, -0.0287744, 0.0334001, 0.0422419, 0.020658, 0.0207096, 0.00382748, 0.00238104, -0.0345987, 0.00224131, -0.0232685, 0.0190443, 0.0433272, -0.0102799, -0.0144871, 0.0620213, -0.0569717, -0.0206284, -0.0195955, -0.0290969, 0.0221347, -0.0451935, -0.0256623, 0.0289423, -0.0188777, -0.00855188, -0.0620786, -0.00982097, -0.0379404, 0.0202729, 0.00223664, 0.0551884, 0.0833648, 0.0323725, -0.0536697, -0.0119622, -0.0343486, 0.0237919, 0.00137585, 0.0142933, 0.0153695, -0.014199, -0.010129, -0.0727971, 0.0088464, 0.0240107, -0.0660348, -0.058749, -0.0212664, 0.0132597, -0.0638516, 0.0194247, 0.0263105, -0.0104118, -0.012601, -0.0387926, 0.0398647, -0.0100294, 0.0226195, 0.0391219, -0.0179555, -0.0184119, 0.0253151, -0.0223535, -0.0149648, -0.0461335, -0.00545179, -0.00995385, -0.0272879, 0.0286351, -0.0979887, 0.0306533, 0.0206011, 0.0151578, -0.0243261, -0.0438775, 0.0494294, -0.0269969, 0.00764483, 0.0211037, -0.0196335, -0.0414172, 0.0176461, 0.0042977