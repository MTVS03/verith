MERGE (c:`Chunk` {`id`: '006400-0001-7d4aeef3'}) SET c += {`text`: '[삼성SDI] 1. 사업의 개요 > [에너지솔루션 사업부문]\n리튬이온 2차전지 산업은 고안전성, 고용량, 고출력 기술 확보를 통해 응용 분야를 지속적으로 넓혀 가고 있습니다.\n자동차용 중형전지는 유럽 등 주요 국가들의 친환경정책, 완성차 업체들의 다양한\n전기차 모델 출시, 전기차의 주행거리 및 경제성 개선으로 중장기적으로 지속 성장을\n하고 있습니다.\n전력저장장치인 ESS용 대형전지도 국내외 국가들의 신재생 발전 확대와 AI 산업\n성장에 따른 전력 수요 증가 속에 높은 성장이 지속되고 있습니다.\n소형전지는 스마트폰, Note PC, 전동공구 등의 휴대 제품 뿐만 아니라 자동차용 전지에도 사용되고 있고, 최근 E-Bike, E-Scooter 등 Micro-Mobility용 및 데이터센터용 BBU(Battery Back-up Unit) 등 다양하게 적용 영역을 넓혀 가고 있습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 사업의 개요 > [에너지솔루션 사업부문]', `idx`: 1} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0170283, 0.0191964, 0.0254635, 0.00584954, -0.0801058, -0.0209353, -0.00627443, 0.0696105, 0.0170207, 0.00692058, 0.0597991, 0.0274263, 0.0164658, -0.00113027, -0.00517738, -0.032309, 0.0323684, 0.0472421, -0.0506981, -0.0480225, 0.0922941, 0.023525, 0.00589766, 0.054612, -0.00963001, -0.0408737, -0.00272705, -0.00188465, -0.00182634, -0.00201292, -0.0504038, 0.0406425, -0.0342979, 0.0437034, -0.0401855, 0.0139132, -0.0718191, -0.0276543, -0.0676837, -0.0023612, 0.00787914, -0.0410404, 0.0669208, 0.013663, 0.00957042, -0.0838616, -0.0164787, -0.00169447, -0.0351779, -0.027827, -0.0131312, -0.0201924, 0.0259171, 0.0270792, 0.0539461, 0.0550568, -0.0427553, -0.00772406, -0.0531482, 0.105075, 0.0280517, 0.0488249, 0.0497446, -0.0314866, -0.0205361, -0.0533575, 0.0519331, -0.0362429, 0.0260925, 0.0104867, 0.024058, -0.0016975, -0.0186426, 0.0109662, 0.00453024, -0.0095791, -0.0395055, 0.0217537, 0.045887, -0.0241789, 0.00602327, 0.0128091, -0.0232424, 0.00872647, -0.00856224, -0.0668555, 0.0494734, -0.000669072, -0.0243479, -0.0502907, -0.0423135, -0.0506062, 0.00392375, 0.0879988, -0.00292413, 0.0473535, 0.0182503, 0.