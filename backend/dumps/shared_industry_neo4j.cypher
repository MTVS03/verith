MERGE (c:`Chunk` {`id`: '066970-0010-fe84861d'}) SET c += {`text`: '[엘앤에프] 2. 생산 및 설비\n1) 생산능력\n2차전지 양극활물질 사업의 관심 집중에 따른 기술, 정보유출 우려 등을 감안하여 상세한 표기는 하지 않을 예정이며, 시설투자 및 기술개발을 통한 안정된 생산능력을 확보하여 고객사에 공급을 확대해 나갈 예정입니다.\n2) 생산설비의 현황 등\n(2025년 12월 31일 기준)\n(단위 : 원)\n사업소\n소유형태\n소재지\n구분\n기초장부가액\n당기증감\n당기상각\n당기장부가액\n증가\n감소\n엘앤에프\n자가\n대구\n토지\n95,038,529,979\n25,397,988,621\n-\n-\n120,436,518,600\n건물\n372,315,001,074\n-\n2,129,188,312\n13,735,824,484\n356,449,988,278\n구축물\n29,441,677,044\n55,000,000\n-\n1,745,583,773\n27,751,093,271\n기계장치\n502,427,596,859\n3,508,583,426\n121,958,273\n52,297,967,103\n453,516,254,909\n공구와기구\n5,925,576,157\n456,143,100\n4,906,270\n1,665,283,607\n4,711,529,380\n비품\n9,726,544,799\n933,221,224\n5,110,379\n2,856,412,904\n7,798,242,740\n차량운반구\n3,219,487,414\n1,119,090\n4,000\n920,485,037\n2,300,117,467\n기타유형자산\n246,700,000\n-\n-\n-\n246,700,000\n건설중인자산\n123,874,112,907\n15,617,708,260\n314,317,268\n-\n139,177,503,899\n사용권자산', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 생산 및 설비', `idx`: 10} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0405021, 0.0468241, 0.0160502, 0.0212848, -0.059512, -0.0210972, -0.0230166, 0.0844834, -0.0572053, -0.0246383, -0.0184416, 0.0586184, -0.00382682, -0.028286, -0.0134607, -0.0632524, 0.0334222, -0.0306107, -0.0677211, -0.0480918, -0.0122036, 0.00437152, 0.0222514, -0.000474229, 0.0405821, 0.00456764, 0.0157643, 0.00173732, 0.0343278, 0.0322548, -0.00398754, -0.0169626, -0.0742177, 0.0368019, -0.00575126, -0.00171751, -0.0052383, -0.0301512, -0.0308654, 0.0668997, -0.0319236, 0.0134533, 0.0142975, -0.0384621, -0.0316908, -0.0171814, -0.0601548, -0.0407493, -0.0240724, 0.021578, -0.0455591, -0.0515305, -0.0210659, 0.0078646, 0.00755524, 0.0292302, -0.115633, -0.019543, 0.0293074, 0.0657109, -0.0