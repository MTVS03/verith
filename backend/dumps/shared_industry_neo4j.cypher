MERGE (c:`Chunk` {`id`: '051910-0090-eba293d0'}) SET c += {`text`: '[LG화학] 7. 기타 참고사항 > 라. 각 사업부문별 주요 재무정보 요약\n③ 자산 비중\n(단위 : 백만원, %)\n구   분\n제25기\n제24기\n제23기\n자산\n비율(%)\n자산\n비율(%)\n자산\n비율(%)\n석유화학 사업부문\n14,475,050\n14.3%\n16,524,141\n17.6%\n15,198,506\n19.6%\n첨단소재 사업부문\n7,787,295\n7.7%\n7,652,487\n8.2%\n7,324,446\n9.5%\n생명과학 사업부문\n2,353,855\n2.3%\n2,455,872\n2.6%\n2,664,518\n3.4%\nLG에너지솔루션\n67,147,953\n66.4%\n60,306,791\n64.3%\n45,399,160\n58.6%\n공통 및 기타부문\n9,297,508\n9.2%\n6,918,471\n7.4%\n6,880,064\n8.9%\n합계\n101,061,661\n100.0%\n93,857,762\n100.0%\n77,466,694\n100.0%\n주) 상기 금액은 연결 및 누계 기준으로 작성되었습니다.\n■ 공통비용 및 공통자산의 배부기준\n공통비용 및 공통자산의 배부는 각 사업부문별 귀속이 명확한 경우에는 직접적으로 귀속시키고, 귀속여부가 불분명한 경우에는 별도의 배부기준 (매출액 비율, 인건비  비율 등)을 적용하여 각 사업부문에 배부하고 있습니다.', `company`: 'LG화학', `stock_code`: '051910', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260313001195&dcmNo=11121928&eleId=9&offset=125016&length=348748&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 라. 각 사업부문별 주요 재무정보 요약', `idx`: 90} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0252867, 0.0369573, 0.0263561, -0.0528817, -0.0742938, -0.0131174, 0.0712747, 0.0320117, -0.0492529, 0.00771238, 0.0603336, 0.0436396, 0.0458232, 0.0392484, 0.0285261, 0.00303425, -0.0141225, -0.00226716, -0.0741554, 0.0114042, -0.0427542, -0.0364747, -0.0389529, 0.0371814, -0.0161095, -0.00476882, -0.0316592, 0.0114498, 0.00378985, 0.0830571, 0.0433294, 0.0242921, -0.0886381, -0.00733122, 0.024232, -0.0429739, 0.00181807, 0.0130818, -0.0320807, -0.0489006, -0.00828406, 0.0803908, 0.00456128, -0.0117015, 0.0275315, -0.0216285, 0.00399701, -0.00447267, -0.0206856, -0.0146039, -0.0214629, 0.0100391, -0.0119981, -0.0418283, 0.00045061, 0.0115142, -0.0818764, 0.0239836, 0.00442598, 0.0306363, -0.0394101, -0.0051238, 0.00142587, -0.0522914, 0.0809556, -0.053548, -0.0275249, 0.0510671, 0.0200871, 0.0646488, -0.0408534, -0.0305442, -0.00347962, -0.00592086, 0.0129958, 0.0318708,