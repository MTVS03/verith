MERGE (c:`Chunk` {`id`: '066970-0018-492061d0'}) SET c += {`text`: '[엘앤에프] 5. 위험관리 및 파생거래\n당사는 2차전지 양극활물질관련 매출이 대부분이며, 관련 중요자재에 대한 수입 원자재구매 결제통화가 대부분 $로 결제되고 있습니다. 매출 결제통화가 대부분 $이기때문에 매출회수, 구매 결제에서 자동 hedge됩니다. 또한 가용달러(매출$-구매$)에 대해서는 연도 중에는 일부 금액을 선물거래를 통하여 위험관리를 하고있습니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래', `idx`: 18} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0190988, 0.0124516, 0.00100145, 0.00159127, -0.032113, -0.00651259, 0.0374918, 0.0821758, 0.0200511, 0.0469069, -0.00123219, 0.0218683, 0.0159478, 0.0293278, -0.011225, -0.062633, 0.0270096, -0.0379665, 0.00151513, -0.0476117, -0.0476819, -0.0250007, 0.0304012, -0.0228596, 0.00152562, 0.032652, -0.0581582, -0.0343806, -0.0095811, 0.0406732, -0.0203848, 0.0148691, -0.0496077, 0.00736495, 0.024708, 0.017407, -0.00404669, 0.0287902, -0.0620097, 0.0293952, -0.01656, 0.00549508, 0.0025277, -0.0627245, 0.0408263, -0.0251246, -0.00633915, -0.0682155, 0.0432862, -0.0219616, -0.0460967, 0.0148892, 0.0623014, 0.00311343, 0.0475362, -0.0126846, -0.047763, 0.0241365, 0.0180256, -0.00509916, 0.00797417, -0.027257, 0.0775972, 0.0335622, 0.00452895, -0.0335835, -0.0123056, 0.025033, -0.054934, 0.0317164, -0.033315, 0.0527537, -0.000156054, 0.0413474, -0.0257774, 0.0294425, 0.0247551, 0.0238066, 0.059608, -0.0244592, 0.0311184, 0.00654976, -0.030389, 0.0133332, -0.0379352, 0.042531, -0.0539494, 0.0276641, -0.0541119, -0.0242179, -0.0322316, -0.0203984, 0.0218122, 0.00915, 0.0223718, -0.0205336, -0.0779918, 0.0372566, 0.0432275, -0.00829341, 0.0570063, 0.0101831, 0.00873826, 0.0117773, 0.0286379, 0.0478733, -0.031903, 0.0309529, -0.0494129, 0.0254376, -0.00871243, -0.021702, 0.0592841, -0.0488289, -0.0242329, -0.0412447, -0.0927344, 0.00818175, 0.0430281, -0.0302257, -0.0919