MERGE (c:`Chunk` {`id`: '086520-0126-3597c388'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [환경사업부문] > 가. 지적재산권 보유현황\n□ 에코프로에이치엔(연결)\n에코프로에이치엔은 영위하고 있는 사업과 관련하여 다수의 지적재산권을 보유하고 있으며, 세부내역은 상세표를 참고해주시기 바랍니다.\n※상세 현황은 \'상세표-7. 지적재산권 보유현황(에코프로에이치엔(연결))\' 참조', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [환경사업부문] > 가. 지적재산권 보유현황', `idx`: 126} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00904102, -0.0109446, 0.0198347, -0.0409368, -0.0454954, -0.0487702, 0.0194259, 0.012317, -0.0249186, 0.0106715, 0.00541434, -0.0109447, -0.0209119, -0.00346076, -0.0443927, -0.0315384, 0.0142419, 0.00565431, -0.0489626, -0.0170931, 0.0706847, -0.0640988, 0.00017272, -0.0195448, 0.0711679, -0.0385608, -0.00852327, -0.0343049, -0.0600365, 0.0107644, -0.0484154, 0.00869929, 0.0183375, -0.0260156, -0.0668674, 0.00515336, -0.0254431, -0.0279905, -0.000976571, 0.0797713, -0.0290782, 0.0309595, 0.0380013, -0.0696523, 0.00422375, -0.000952566, 0.0225861, -0.0240237, -0.0243581, -0.0173245, -0.0423448, 0.00107566, 0.00556899, -0.0554424, -0.0667098, 0.0315671, -0.0319946, -0.0551456, -0.00533961, -0.000182758, -0.0505778, -0.045011, -0.0299624, -0.0675048, -0.0708241, -0.000217538, 0.0627604, 0.0233088, 0.0244195, 0.0390799, -0.016703, -0.0627101, -0.0152105, -0.0465901, 0.0219026, 0.0147921, -0.0327809, 0.00536084, -0.0161466, 0.0318867, -0.0516235, 0.0167662, -0.0106897, 0.0956506, 0.0249009, 0.00417621, -0.110284, 0.034404, 0.0452833, -0.0338315, -0.0677576, -0.0754226, 0.0276177, 0.0179561, 0.0509191, 0.0309566, -0.0767685, -0.0211189, -0.00402956, 0.054454, -0.0512657, 0.0201365, -0.00252408, -0.0168921, 0.0257254, -0.0198551, 0.0188155, 0.00923757, 0.00713275, 0.0249967, -0.0236244, -0.0442947, -0.0166726, 0.108878, 0.00714614, 0.0232259, 0.0107792, 0.0112702, 0.0