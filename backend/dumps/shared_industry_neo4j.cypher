MERGE (c:`Chunk` {`id`: '003670-0025-5974c69b'}) SET c += {`text`: '[포스코퓨처엠] 5. 위험관리 및 파생거래 > 라. 파생상품계약 및 풋백옵션 등 거래 현황\n(2) 연결실체는 제조시설 전력 공급을 위하여 Hydro-Quebec과 장기 전력공급계약을체결하였습니다. 해당 계약은 2026년 4월 1일부터 2045년 3월 20일까지 매년 최소 41,878kW의 전력 사용량을 약정하고 있으며, 미달 시 위약금이 부과됩니다. 본 계약과 관련하여 CAD 20,000천 한도의 Standby L/C를 설정하였으며, CAD 19,602천이발행되어 있습니다. 최소 소비량은 제조시설 운영 상황에 따라 조정될 수 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 라. 파생상품계약 및 풋백옵션 등 거래 현황', `idx`: 25} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0162719, -0.00469737, -0.00381839, -0.0144791, -0.0335939, 0.0449208, 0.0613258, 0.0625711, -0.0201411, 0.00808892, 0.0151372, 0.0117109, 0.0383459, 0.013451, 0.0388628, -0.0374978, 0.0344092, -0.041666, -0.0584849, 0.0249588, 0.0655767, 0.00687158, -0.0268164, 0.0424764, 0.0162363, -0.0761928, 0.00046042, 0.032561, 0.0187292, 0.0764682, 0.0328499, 0.0476965, -0.0126485, -0.0237461, 0.0348337, 0.00968798, 0.0273466, -0.00831744, -0.0275772, 0.032393, -0.0460617, -0.0840524, 0.00191525, 0.0251854, 0.0296347, -0.0555405, -0.0229401, -0.00229166, -0.0610361, 0.0107671, -0.0394486, -0.0124341, 0.0330053, 0.0389348, 0.0534733, -0.025605, -0.0875346, -0.0221217, 0.0124938, -0.020814, -0.0305472, -0.0394113, -0.0142904, -0.0432044, 0.088771, -0.0501816, 0.0527275, 0.00162083, 0.0117683, 0.0324403, 0.00762821, 0.0392984, 0.00233222, 0.0314063, -0.0414679, -0.000527974, -0.0121325, -0.023349, 0.0834547, -0.0269805, 0.0735839, -0.022766, 0.0189409, -0.0248973, 0.0165099, 0.0105317, -0.0850008, 0.00815939, -0.0373396, -0.0376729, 0.0204157, -0.0240564, -0.0575408, 0.0320018, -0.0340694, -0.0390229, -0.0185367, -0.0529096, 0.0612023, 0.010363, 0.00140497, -0.0620603, 0.0186725, -0.028747, -0.0221003, 0.0872721, -0.0462722, -0.0686138, 0.00806258, 0.0