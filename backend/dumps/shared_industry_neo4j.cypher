MERGE (c:`Chunk` {`id`: '066970-0000-6b99de34'}) SET c += {`text`: '[엘앤에프]\nII. 사업의 내용\n당사 및 연결대상 종속회사가 영위하는 사업의 구분은 아래와 같습니다.\n구분\n사업구분\n당사\n(주)엘앤에프\n2차전지 양극활물질\n종속회사\n광미래신재료유한공사\n제이에이치화학공업(주)\n2차전지 양극활물질 관련 소재\n(주)엘앤에프플러스\n이차 전지 소재의 제조, 판매\n주) (주)엘앤에프플러스는 당기 중 신규 설립되었습니다.', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '', `idx`: 0} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0806922, 0.0162824, 0.0206699, 0.00845715, -0.0612042, -0.0234739, 0.0216026, 0.076454, -0.0337478, -0.0223516, -0.0150849, 0.0309621, -0.0270194, -0.0278907, -0.0210594, -0.0459357, 0.0527445, -0.0104441, 0.000977097, -0.0378084, -0.0502295, -0.00156101, 0.00731121, 0.0543597, 0.038865, -0.00317978, -0.0287385, -0.0431056, -0.0378456, -0.0406072, -0.0499776, -0.0645149, -0.0512615, -0.0203972, 0.0582381, -0.025697, 0.002632, 0.0638076, -0.060421, 0.0116473, -6.63612e-05, 0.0439043, -0.00415113, -0.0175131, 0.0174364, 0.041415, 0.00543075, -0.0011667, 0.00718499, -0.0383388, -0.0454911, 0.0482918, -0.00499077, 0.028839, 0.00875046, 0.0074089, -0.100939, -0.0865449, 0.0395208, 0.0290701, -0.0470712, -0.00764698, 0.0824018, 0.0224603, -0.00191556, -0.03298, 0.0089268, 0.0104322, 0.017767, -0.00274999, 0.0167272, 0.0309976, -0.0380149, 0.0243503, 0.0698873, 0.0492066, 0.0205179, -0.0076057, 0.0431039, 0.0177236, -0.02424, 0.00101247, -0.0788381, -0.0162616, 0.0740421, -0.0236176, -0.0758043, 0.000597561, -0.075059, -0.0420376, -0.0581934, -0.0470736, -0.004504, 0.0617297, 0.0577614, 0.0305603, -0.0414537, 0.0200863, 0.0311732, -0.0112061, -0.037026, 0.015834, -0.00445321, -0.0434322, 0.0197842, -0.0330726, -0.0308639, 0.0125356, -0.00833786, -0.019213, 0.0141202, 0.00275153, 0.0371237, 0.0473147, -0.027321, 0.0250245, -0.00398528, 0.0475126, 0.0119824, 0.00453618, -0.0463