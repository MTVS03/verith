MERGE (c:`Chunk` {`id`: '006400-0012-dbd5ec2f'}) SET c += {`text`: '[삼성SDI] 4. 매출 및 수주상황 > 나. 수주상황\n당사는 거래처와 기본공급 계약 체결 후 거래처의 생산계획에 따라 납품하고 있으나,물량이 확정되어 있지 않고 대내외적 경제환경 변화와 그에 따른 수요변화를 정확히 예측할 수 없습니다. 또한 당사는 원가기준 투입법을 적용하여 진행기준수익을 인식하는 수주계약거래는 없습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 나. 수주상황', `idx`: 12} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0263184, 0.0110832, -0.0148857, -0.00723461, -0.0721991, 0.0610009, -0.0197063, 0.0821637, 0.0583613, 0.0130674, 0.0552792, 0.00686605, 0.00960379, -0.0381177, 0.0119079, 0.00848961, 0.0719602, 0.00375344, -0.00493519, -0.0139312, 0.0259758, 0.0106383, 0.0425111, 0.0237931, 0.0577395, 0.0201754, -0.021501, 0.000766228, -0.0054617, 0.0762233, -0.0122678, 0.00732325, -0.0128386, -0.0354979, 0.00832054, -0.04322, -0.0179604, 0.028597, -0.00892612, 0.066433, 0.0427189, -0.0466254, 0.031438, -0.0609763, 0.0711221, -0.0303781, -0.0292115, -0.0359135, -0.0453631, 0.0384617, -0.0624135, -0.00399737, 0.0216454, -0.00412327, -0.00862369, 0.0508036, -0.0276895, 0.0167407, 0.00653268, 0.0287837, -0.0674714, -0.0636296, 0.0182955, 0.0180093, 0.0212842, -0.098053, -0.00166058, -0.0177957, -0.029982, -0.00989427, -0.0331875, -0.0354276, 0.0143933, 0.0276899, -0.049046, 0.022641, 0.00272833, -0.0219439, 0.0426354, -0.108108, 0.0110363, 0.0226555, 0.0208309, -0.0057905, 0.0140022, 0.013271, -0.0099371, 0.020482, -0.0305338, 0.0182683, 0.0466871, -0.014801, -0.0283073, 0.0213821, -0.0253897, -0.0506597, -0.0754495, 0.0555691, -0.01601, -0.0256578, 0.00138679, -0.0314604, 0.0111639, -0.0762305, 0.0777698, 0.00647517, -0.011576, 0.034638, -0.0142057, 0.0787569, -0.00558556, 0.0285445, 0.035556, 0.0274723, -0.0258315, -0.00850519, -0.0322769, 0.0412881, 0.0139166, 0.0308519, -0.0751133, -0.082636