MERGE (c:`Chunk` {`id`: '003670-0004-faebb7ba'}) SET c += {`text`: '[포스코퓨처엠] 2. 주요 제품 및 서비스 > 나. 주요 제품 등의 가격변동추이\n(단위 : 원/톤)\n품 목\n제55기 연간\n제54기 연간\n제53기 연간\n내화물\n972,514\n1,000,776\n991,268\n생석회\n157,992\n141,789\n147,210\n* 에너지소재 제품 가격변동추이는 정보유출 우려 등을 감안하여 미표기\n(1) 산출기준\nㅇ 산출대상 및 선정방법: 내화물 매출(신내화제품 제외) 단가, 생석회 매출단가\nㅇ 산출단위 및 산출방법: 해당제품의 운임을 포함한 대상기간 매출액 기준 평균가격\n(2) 주요 가격변동원인\nㅇ 내화물은 전방산업의 업황 및 원재료비 등을 고려하여 판매가격 변동\nㅇ 생석회는 유틸리티 단가, 원료비 등을 고려 하여 판매가격이 결정\nㅇ 에너지소재는 국제 광물자원 수급에 따라 가격 변동', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 주요 제품 및 서비스 > 나. 주요 제품 등의 가격변동추이', `idx`: 4} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0316435, 0.0193796, -0.0299881, 0.0194088, -0.0599654, -0.0470564, -0.00913726, 0.0236703, -0.0390282, 0.0742942, 0.020348, 0.0419083, -0.0185126, 0.0147568, 0.0208811, 0.0421543, -0.0307642, -0.0273868, -0.0133942, 0.0336425, 0.0176447, -0.00573688, -0.0101111, 0.073956, 0.0273252, -0.0180624, -0.0187447, 0.0307893, 0.0145337, 0.079019, 0.0446398, 0.0245353, -0.046475, -0.0447448, -0.0321942, 0.00883377, 0.000916452, -0.0135498, -0.036114, 0.0149101, 0.00594684, 0.000885277, -0.0200335, 0.0304182, 0.000946482, -0.0377736, -0.0201235, -0.0145402, 0.0179857, -0.0773322, -0.0362205, -0.0527188, 0.024552, -0.0140741, 0.0289123, 0.0243136, -0.10576, -0.000451807, -0.0535591, 0.0292995, 0.0312952, -0.0394003, 0.01709, -0.0145743, 0.0547046, -0.0233226, 0.0316206, 0.0126228, -0.0188624, 0.0562474, -0.0420605, -0.00545166, 0.0272152, 0.043881, -0.0267713, 0.0480439, 0.03677, -0.00127039, 0.0133925, 0.0065078, -0.00304763, 0.0326066, -0.0566494, -0.00528575, 0.0302699, 0.0138785, -0.00745346, -0.0588187, -0.0213721, -0.032547, 0.018, -0.0213001, -0.0393744, 0.104049, 0.00270035, -0.0137466, -0.0440333, -0.0216996, 0.00639039, -0.00678894