MERGE (c:`Chunk` {`id`: '096770-0164-5c3fe1f5'}) SET c += {`text`: '[SK이노베이션] 5. 석유 트레이딩 사업\n또한, 당사는 탱크터미널 사업을 통해 울산에 위치한 SK이노베이션 계열 사업회사들의 원유 및 석유제품의 저장·배합·출하 업무를 안정적으로 지원하며, 국내 최고 수준의 운영 경쟁력을 인정받고 있습니다.\n- 주요 종속회사의 영업의 개황\nㆍSK Energy International Pte. Ltd.는 100% 자회사로 싱가포르에 위치하며, 아시아 지역 에너지 트레이딩 허브 역할을 수행하고 있습니다.\nㆍSK Energy Americas, Inc.는 SK Energy International Pte. Ltd.의 100% 자회사로 북미 지역의 원유 및 석유제품 트레이딩 사업을 담당하고 있습니다.\nㆍSK Energy Europe, Ltd.는 SK Energy International Pte. Ltd.의 100% 자회사로 유럽 지역에서 원유 및 석유제품 트레이딩 및 마케팅 활동을 수행하고 있습니다.\n(2) 신규 사업 등의 내용 및 전망\n당사 석유 트레이딩 사업은 미래 성장 동력으로 바이오 연료 및 SAF (Sustainable Aviation Fuel) 등의 신재생 에너지 제품 거래를 확대하고 있습니다. 또한, 기존 석유 중심의 트레이딩 사업 구조를 넘어 배터리 원소재 트레이딩에도 진출할 예정입니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 석유 트레이딩 사업', `idx`: 164} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0178581, 0.020434, -0.0454606, 0.00209995, -0.0402965, 0.0166536, 0.0030369, 0.015652, 0.0497517, 0.0462663, 0.0863767, -0.0265373, -0.0270463, 0.0518351, 0.00304362, -0.0498706, 0.0879607, -0.024548, -0.0311067, -0.00194645, -0.0127318, 0.0161525, 0.00191948, 0.0281299, 0.0380467, -0.0471116, -0.0492534, 0.058092, -0.0655601, -0.0494961, 0.0593459, 0.0516183, -0.0548887, -0.010745, 0.0142739, -0.0399241, 0.00361262, 0.0421486, -0.059728, 0.0112002, -0.0228669, -0.0588905, 0.0374984, -0.0440875, 0.0252008, 0.025784, -0.0265196, 0.0157938, -0.0200865, -0.0159556, -0.0244382, -0.00113342, 0.00979112, 0.0655411, -0.0162985, -0.000977836, -0.0453855, 0.000300378, -0.0154216, 0.092055, -0.0529201, 0.00173669, 0.0547435, -0.00400129, -0.0261438, -0.0327834, 0.0339533, -0.00984053, -0.0749634, 0.0270829, 0.0163813, 0.0171581, -0.0752846, -0.0384923, -0.0423139, 0.0207291, 0.00119643, -0.0249717, 0.0630285, -0.0559692, -0.0120153, 0.0