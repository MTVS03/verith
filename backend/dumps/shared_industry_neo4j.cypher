MERGE (c:`Chunk` {`id`: '066970-0019-1fa48753'}) SET c += {`text`: '[엘앤에프] 1. 시장위험\n1) 신용위험\n(1) 신용위험에 대한 노출\n금융자산의 장부금액은 신용위험에 대한 최대노출정도를 나타냅니다. 연결회사는 현금및현금성자산을 신용등급이 우수한 금융기관에 예치하고 있어, 금융기관으로부터의 신용위험은 제한적입니다.\n당기말과 전기말 현재 신용 위험에 대한 최대 노출 정도는 다음과 같습니다.\n(단위: 원)\n구분\n제26(당)기말\n제25(전)기말\n현금및현금성자산\n382,851,603,647\n279,512,944,028\n매출채권및기타채권\n339,574,652,892\n214,402,827,986\n기타투자자산\n3,542,175,000\n3,899,430,000\n기타유동금융자산\n2,322,054,108\n2,856,612,321\n당기손익-공정가치측정금융자산\n62,183,142,824\n44,100,000,000\n주) 연결회사의 보고기간 말 현재 현금시재액을 제외한 금액입니다.\n당기말과 전기말 현재 현금및현금성자산을 제외한 상각후원가측정 금융자산의 각 지역별 신용위험에 대한 최대 노출정도는 다음과 같습니다.\n(단위: 원)\n구  분\n제26(당)기말\n제25(전)기말\n국  내\n100,701,130,309\n30,422,626,475\n기  타\n244,737,751,691\n190,736,243,832\n합  계\n345,438,882,000\n233,158,870,307\n당기말과 전기말 현재 대여금및수취채권의 거래대상별 신용위험에 대한 최대 노출정도는 다음과 같습니다.\n(단위 : 원)\n구  분\n제26(당)기말\n제25(전)기말\n최종제조업체\n319,278,561,980\n189,529,791,649\n중간제조업체\n12,771,306,364', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 시장위험', `idx`: 19} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0151616, 0.0112765, -0.00363935, -0.00330176, -0.0883495, 0.045443, 0.0136976, 0.0472703, -0.0244729, -0.0121126, 0.0353728, 0.0333603, 0.00570355, -0.0129685, -0.00544089, -0.00656032, 0.00542531, -0.0261901, -0.0180478, -0.0208954, -0.0546288, 0.0277922, -0.0435888, -0.00783321, -0.00791821, 0.0159376, 0.028689, -0.03286, 0.0159022, 0.0314549, 0.00123017, 0.0146506, -0.00784839, 0.0421091, 0.0383722, -0.00841958, -0.0423366, 0.0399668, 0.00813164, 0.0113571, -0.0324048, 0.0202443, 0.0377426, -0.0156056, -0.0505245, -0.0448658, 0.0383364, -0.0691907, 0.0349349, -0.00135524, -0.00368848, -0.0592031, 0.014032, 0.0206505, 0.0339149, 0.0243498, -0.0499939, -0.0216064, 0.00670827, 0.0216656, 0.0310686, 0.0121608, -0.0029817