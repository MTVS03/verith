MERGE (c:`Chunk` {`id`: '086520-0106-3818bb36'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [Global ESS Battery 시장 전망]\n(단위: GWh)\n글로벌 ess 시장 전망\n자료 : SNE리서치 (2025.04)\n이 중 지역별로 ESS Battery 시장을 구분하면, 2024년기준 중국이 ESS 시장의 54%로 절반 이상을 차지하고 있으며 이는 중국정부의 보조금 확대 정책 및 규제로 급성장한 배경이 있습니다. 북미지역도 신재생에너지 확대 및 전력 설비 노후화로 인한 Grid 안정화 및 AI 확대로 시장이 고속성장을 유지하고 있으며, 기타지역(중동/호주 등)도 본격적으로 ESS 도입을 확대하며 \'24~\'30 CAGR 20%를 전망하고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [Global ESS Battery 시장 전망]', `idx`: 106} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00749603, 0.0290049, 0.0377206, -0.0486263, -0.0447348, -0.00856729, -0.018361, 0.0542215, -0.0257189, 0.0539756, 0.0218831, -0.0228435, 0.0343099, 0.0338823, -0.0192605, -0.037718, 0.0371047, -0.0216381, -0.0751216, -0.0326426, 0.0130799, 0.00124574, -0.00265454, -0.00831595, 0.0401745, 0.0513022, -0.0245853, 0.0289893, -0.0309697, 0.0550347, -0.0553732, 0.0379778, 0.0542813, 0.0749492, 0.0196043, 0.0228931, -0.020909, -0.0589342, -0.0339938, -0.0051566, -0.00111656, -0.0697396, 0.0769194, -0.0450045, -0.00250037, -0.0361931, -0.0798441, -0.0273242, -0.0373902, 0.0161579, -0.0132918, -0.00429374, 0.0246408, 0.0369755, 0.0483112, 0.0882492, 0.000259848, 0.0219083, -0.0324463, 0.0464355, -0.0627974, -0.0297275, 0.0449713, -0.0234277, 0.0423847, -0.0595098, 0.0900256, 0.028951, 0.0116152, 0.0492763, 0.0166869, 0.0230037, -0.0262233, 0.00591864, -0.00490019, -0.0549361, 0.0457911, -0.0255974, 0.0237771, -0.0308402, -0.0174192, -0.0310403, -0.0275439, 0.00761196, -0.0333422, -0.0333321, -0.0207814, -0.00296333, -0.0130508, -0.0640684, -0.0390169, 0.000154551, 0.0106649, 0.0207299, 0.0222027, 0.0812856, -0.00719946, 0.010944, -0.036136, -0.0275118, -0.0290934, -0.0213977, 0.0361835, 0.0499774, -0.0213101, 