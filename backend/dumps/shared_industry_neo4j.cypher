MERGE (c:`Chunk` {`id`: '003670-0028-88df3169'}) SET c += {`text`: '[포스코퓨처엠] 7. 기타 참고사항 > 가. 지식재산권 보유 현황\n- 국내외 지식재산권 출원 및 등록 유지 건수                                        (단위 : 건)\n구분\n국내\n해외\n계\n특허\n(디자인 포함)\n기초소재\n209\n10\n219\n에너지소재\n1,125\n471\n1,596\n상표\n기초소재\n16\n-\n16\n에너지소재\n-\n-\n-\n보유중인 특허는 대부분 이차전지 제품과 이를 제조하기 위한 프로세스 방법 등과 관련된 것으로 당사의 기술과 제품을 보호하고, 시장에서 활용이 가능합니다.\n당사 지식재산권은 전문인력으로 구성된 전담 조직인 IP전략센터에 의해 관리되고 있으며, 지식재산권의 전략수립, 출원 및 등록, 사후관리 및 분쟁 대응 등을 담당하고 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 가. 지식재산권 보유 현황', `idx`: 28} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0139487, -0.0050804, 0.0183763, -0.0262188, -0.00269227, -0.0840724, 0.0191822, 0.0275612, 0.0169583, 0.00859339, 0.017256, 0.0385327, -0.0232382, 0.0736571, -0.0110441, 0.0755458, 0.00188547, -0.0147888, -0.0537884, 0.0170838, 0.0892659, -0.0742632, 0.0203163, 0.0175652, -0.00923862, -0.0230823, -0.0372509, 0.0695787, -0.0129875, 0.0450409, 0.00457646, 0.0350832, 0.0093214, -0.0123599, -0.0363706, 0.00894117, -0.00600764, -0.0768194, -0.0732528, 0.00551196, -0.00184207, 0.000780081, 0.0422943, -0.0100272, 0.0311956, -0.023165, 0.0173881, -0.0317043, -0.0539035, -0.0442062, -0.031143, 0.0128386, -0.00497806, -0.00594173, -0.0151483, 0.0512237, -0.05437, 0.0162069, 0.0578076, 0.0251445, -0.0175236, -0.0319727, -0.0301916, -0.00477584, 0.0189726, -0.0239413, 0.0377778, -0.0137199, -0.0133091, 0.0490474, -0.00687345, -0.0195295, -0.0172287, -0.0476656, -0.069211, 0.0374134, 0.0195993, 0.00354444, 0.00429225, 0.0474408, 0.00165206, 0.0237274, -0.000726156, 0.0630831, -0.012244, 0.00914153, -0.0812425, 0.014016, 0.046661, -0.0524683, -0.0156535, -0.0646859, -0.0722298, 0.00999771, 0.0254155, -0.007298, -0.045787, 0.016195, 0.0238959, 0.0301477, 0.0202096