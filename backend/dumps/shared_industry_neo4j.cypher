MERGE (c:`Chunk` {`id`: '003670-0040-3bd57871'}) SET c += {`text`: '[포스코퓨처엠] 7. 기타 참고사항 > 마. 사업부문별 주요 재무정보\n100.0\n* 공통 판매비와 관리비 및 자산의 합리적 배부 기준 적용\nㆍ 공통 판매비와 관리비의 경우 각 사업부문 매출액, 인원 수, 투자비 등에 비례하여 적절히 배부하고 있습니다.\nㆍ공통자산의 경우 직접귀속이 가능한 자산(재고자산, 고정자산, 투자자산 등)은\n해당 부서에 직접 귀속되나, 전사 공통관리가 필요한 자산 및 자산귀속이 불분명한 자산은 필요한 경우 합리적인 배부 기준(매출액비, 세전이익비 등)에 의거 각 부문에 배부하고 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > 마. 사업부문별 주요 재무정보', `idx`: 40} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.00645296, -0.000119559, -0.0371727, 0.0249955, -0.0401609, -0.0181219, 0.067874, 0.0371246, -0.0184877, 0.0117426, -0.0268308, 0.0402179, 0.0244583, 0.107724, 0.0377613, 0.0145965, -0.018129, 0.0359006, -0.0329281, 0.00678237, 0.0776917, -0.0271055, -0.000198371, -0.00221674, -0.0289538, -0.00425516, -0.0379729, 0.0459784, -0.0177689, 0.0960962, 0.019099, 0.0110768, -0.0209074, -0.0299308, 0.00336747, -0.0499196, -0.0257343, 0.00449155, -0.0237783, 0.0357028, -0.0105045, 0.0491101, -0.00341647, -0.0769255, 0.0223541, -0.0218602, -0.0152169, -0.0228698, -0.048169, -0.0333099, -0.058209, 0.0268843, -0.0347994, -0.0498337, -0.0054178, 0.0610892, -0.0631765, 0.0118117, 0.0340758, -0.00419834, 0.0178699, -0.0755231, -0.0106229, -0.0481232, 0.0561911, -0.0455596, -0.0384373, -0.0308153, 0.0322929, 0.0342712, -0.0450767, -0.0463166, 0.000544505, 0.0137275, -0.0339203, 0.0269682, 0.0133929, -0.0531927, -0.00422046, -0.0209553, -0.0167417, -0.0209382, 0.0503132, 0.0125146, -0.0300452, 0.118461, -0.0270865, 0.00246456, 0.0530369, -0.0794477, -0.0225051, -0.0523335, -0.0259927, 0.00896664, -0.00511667, -0.00339862, -0.0743383, 0.0610325, 0.000947708, -0.0414133, 0.0344755, 0.00133644, 0.031874, -0.068248, 0.0291597, -0.0112937, -0.056384, -0.00357057, 0.0026858, -0.0311685