MERGE (c:`Chunk` {`id`: '247540-0017-13a16fd8'}) SET c += {`text`: '[에코프로비엠] 5. 위험관리 및 파생거래 > 가. 시장위험과 위험관리 (연결기준)\n연결회사는 미사용 차입금 한도를 적정 수준으로 유지하고, 영업 자금 수요를 충족시키기 위해 차입금 한도나 약정을 위반하는 일이 없도록 유동성에 대한 예측을 항시 모니터링하고 있습니다.\n유동성 위험 분석에서는 연결회사의 다음의 금융부채를 계약상 만기별로 구분하였습니다.\n- 모든 비파생 금융부채\n- 순액 및 총액 결제 파생상품 중 계약상 만기가 현금흐름의 시기를 이해하기 위해 필요한 경우\n유동성 위험 분석에 포함된 금액은 계약상의 할인되지 않은 현금흐름입니다. 금융보증계약 이외의 12개월 이내 만기가 도래하는 금액은 현재가치 할인의 효과가 중요하지 않으므로 장부금액과 동일합니다. 금융보증계약은 즉시 지급을 요구받을 수 있으므로 계약금액 총액이 3개월 미만 구분에 포함되어 있습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 가. 시장위험과 위험관리 (연결기준)', `idx`: 17} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0287936, 0.0226059, -0.00212634, -0.0273048, -0.0547915, 0.028207, 0.083961, 0.057957, -0.011013, 0.0332728, 0.0162781, -0.0133159, 0.0586566, 0.0285079, -0.00238437, -0.00668409, -0.009907, 0.0165646, -0.0190701, 0.0206736, 0.00889784, -0.0318625, -0.0229355, -0.0165957, 0.0277072, -0.027243, -0.0926006, -0.0521683, 0.0395519, 0.0777285, 0.0523653, 0.0571784, -0.0409765, 0.0179388, 0.0447273, -0.0444674, -0.00882516, -0.0214119, -0.0289551, 0.0913144, 0.0294836, 0.00461528, 0.0286204, -0.0241022, 0.037465, -0.0571794, 0.0247971, 0.0250876, -0.0396994, -0.0151916, -0.0206616, -0.0703664, 0.0335958, -0.0152086, 0.0700585, -0.00161605, -0.0244345, -0.00778147, 0.0883081, 0.001028, 0.0287426, -0.0635508, -0.0145705, -0.00355991, 0.0730069, -0.0827722, 0.0464068, -0.0381608, 0.0417748, 0.00894133, 0.0282319, 0.00469971, 0.0119633, -0.0140222, -0.0224841, 0.0226733, -0.0329213, -0.0174293, 0.0431898, -0.00698857, 0.0300947, -0.0124371, 0.00704726, 0.0180978, -0.0370795, 0.0434601, -0.0518605, -0.0133359, -0.0110958, 0.0436521, 0.0108571, -0.0229125, 0.0540656, 0.016906, -0.0100367, -0.0316026, -0.0783426, -0.00595593,