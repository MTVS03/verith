MERGE (c:`Chunk` {`id`: '096770-0062-a2969bd4'}) SET c += {`text`: '[SK이노베이션] 3. 원재료 및 생산설비 > [SK이노베이션 E&S CIC] > 가. 생산설비에 관한 사항\n(단위: 백만원)\n구    분\n취득원가\n상각누계액\n손상누계액\n장부금액\n토지\n4,337,014\n-\n-\n4,337,014\n건물\n8,003,480\n(1,158,540)\n(50,794)\n6,794,146\n구축물\n2,506,218\n(1,028,296)\n(17,233)\n1,460,689\n기계장치\n24,377,801\n(11,192,290)\n(249,803)\n12,935,708\n기타유형자산\n12,095,378\n(5,642,734)\n(400,052)\n6,052,592\n건설중인자산\n25,139,466\n-\n-\n25,139,466\n합    계\n76,459,357\n(19,021,860)\n(717,882)\n56,719,615\n※ 주요 유형자산에 대한 객관적인 시가판단이 어려워 기재를 생략함.\n※ 상기 시설 및 설비현황은 연결 기준임.\n(2) 설비의 신설ㆍ매입 계획 등\n① 진행중인 투자\n(단위 : 억원)\n사업부문\n투자 목적\n투자 내용\n향후 기대 효과\n투자기간\n기 지출금액\n비고\n배터리 및 소재 사업\n신/증설\nBattery 국내/해외 설비 투자 및 LiBS 상업라인 신/증설\n제품 생산량 증대를 통한 판매 확대\n2025.01.01~2025.12.31\n21,035\n누적 실적\nPackaging 사업\n신/증설\n중국 내 고기능소재 생산 설비 신설 투자\n아시아 지역 내 신설 통한수요 확대 대응\n2025.01.01~2025.12.31\n782\n누적 실적\n② 향후 투자계획\n- 배터리 사업의 경쟁력 강화를 위한 투자 지속 추진 예정', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '3. 원재료 및 생산설비 > [SK이노베이션 E&S CIC] > 가. 생산설비에 관한 사항', `idx`: 62} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.024691, 0.0642324, -0.0446305, 0.0443545, -0.0213905, 0.0259947, -0.076479, 0.0476989, -0.0275937, -0.0376848, 0.0699717, 0.0481871, 0.000831365, 0.0300977, -0.0343926, -0.0109696, 0.0449371, -0.0418269, -0.0466542, 0.00631305, 0.0562885, 0.00105059, 0.0322872, 0.0485997, 0.0449522, -0.00784559, 0.0596066, 0.038522, 0.00129961, 0.0311284, -0.0189379, 0.00928961, -0.0568536, 0.00587133, 0.00776994, -0.0456307, 0.0418124, -0.00784155, -0.0282621, 0.0892672, 0.00755448, 0.0403868, 0.0650889, -0.02124, 0.0440141, -0.0371586, -0.0451192, -0.0662549, -0.0474526, 0.0289025, 0.0112393, -0.0367031, -0.0325554, -0.013166, 0.0824102, -0.00886429, -0.134664, 0.0239772, -0.00355222, 0.0739853, -