MERGE (c:`Chunk` {`id`: '096770-0188-1e6aa2b4'}) SET c += {`text`: '[SK이노베이션] 7. 기유 및 윤활유 사업 > [윤활유 생산시설 현황]\n(단위 : 배럴/일)\n위치\n생산능력\n대한민국 울산\n4,200\n중국 천진\n2,500\n과거 당사는 기유의 안정적 확보 및 효율적 공장운영을 위해 자사 공장의 생산능력을 증대시키는 것에 집중하였으나, 해외시장에서 의미있는 성장을 함에 따라 해외 임가공을 늘려가는 등 유연한 생산전략을 취하고 있습니다.\n(3) 주요 종속회사 및 공동영업 회사의 현황\nㆍSK Enmove Americas Inc.는 미국 휴스턴에 1997년 6월 SK E&P Company란 이름으로 설립, 2003년 기유 판매를 시작하였으며 2009년 10월 타 사업부분을 분사시키고 윤활유 전문 기업으로 전환하였습니다.\nㆍSK Enmove Europe B.V.는 2009년 8월 네덜란드 암스테르담에 설립되어 유럽 고객 대상으로 당사의 기유를 판매하고 있습니다.\nㆍSK Enmove (Tianjin) Co., Ltd.는 중국에서의 윤활유 제조 및 윤활유/기유 판매를 목적으로 2003년 3월 중국 천진에 설립되었으며, 이후 2012년 4월부터 자체 윤활유공장을 가동하고 있습니다.\nㆍPT. Patra SK는 기유 제조 및 판매를 목적으로 2006년 11월 인도네시아에 설립되어 2008년 5월부터 본격적인 기유 생산 및 판매를 개시하였습니다. 또한 제품 Portfolio 최적화, 고부가 제품 판매 증진 등을 목적으로 투자를 지속하고 있습니다.\nㆍ유베이스매뉴팩처링아시아(주)는 기유 제조 및 판매를 목적으로 2010년 9월에 울산에서 설립된 후 2012년 5월부터 상업생산을 시작하였습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기유 및 윤활유 사업 > [윤활유 생산시설 현황]', `idx`: 188} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00677818, 0.00956648, 0.0180216, 0.0310957, 0.000965666, 0.00215629, -0.0435859, 0.0591509, 0.0323443, 0.068667, 0.0417698, 0.0479098, 0.000525772, 0.0177262, 0.0453459, -0.022979, 0.0462298, 0.0254704, -0.0591706, 0.0203901, 0.0571255, 0.00402471, 0.0466457, 0.041933, 0.041136, -0.080459, 0.00858001, 0.0611756, -0.0232622, -0.0701868, 0.0114803, 0.0506794, -0.0860881, 0.0169839, 0.0232014, -0.0378453, -0.0671032, 0.0206182, -0.0544151, 0.0191537, 0.0639514, -0.0177293, 0.0679922, 0.0251701, 0.00100941, 0.0527676, -0.0391592, 0.0368877, -0.0366853, 0.0403518, -0.0165315, 0.0103214, -0.0185652, -0.0076981, 0.0515375, -0.0258301, -0.0960354, -9.01972e-05, 0.039713, 0.0763228, -0.110912, 0.0389316, 0.000425568, 0.0127389, 0.0327343, -0.0163596, 0.0317