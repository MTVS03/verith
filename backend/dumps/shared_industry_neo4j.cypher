MERGE (c:`Chunk` {`id`: '247540-0038-ad756cdf'}) SET c += {`text`: '[에코프로비엠] 7. 기타 참고사항 > [Global ESS Battery 시장 전망]\n(단위: GWh)\n글로벌 ess 시장 전망\n자료 : SNE리서치 (2025.04)\n이 중 지역별로 ESS Battery 시장을 구분하면, 2024년 기준 중국이 ESS 시장의 54%로 절반 이상을 차지하고 있으며 이는 중국정부의 보조금 확대 정책 및 규제로 급성장한 배경이 있습니다. 북미지역도 신재생에너지 확대 및 전력 설비 노후화로 인한 Grid 안정화 및 AI 확대로 시장이 고속성장을 유지하고 있으며, 기타지역(중동/호주 등)도 본격적으로 ESS 도입을 확대하며 \'24~\'30 CAGR 20%를 전망하고 있습니다.', `company`: '에코프로비엠', `stock_code`: '247540', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001622&dcmNo=11144261&eleId=9&offset=109202&length=79351&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [Global ESS Battery 시장 전망]', `idx`: 38} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00917615, 0.0228577, 0.0358467, -0.0551822, -0.0385963, -0.0176192, -0.0130665, 0.0583855, -0.0226118, 0.0574224, 0.0163828, -0.018667, 0.0358479, 0.0419807, -0.0173876, -0.0407714, 0.0378155, -0.0275291, -0.0833439, -0.0247321, 0.025996, -0.0042704, -2.67255e-05, -0.00898718, 0.0415744, 0.0472291, -0.0268586, 0.0316199, -0.0318674, 0.0561324, -0.0515699, 0.0287932, 0.0496628, 0.0749375, 0.0191972, 0.0228898, -0.0274993, -0.0624117, -0.0335619, -0.00445292, -0.000124647, -0.066672, 0.0744976, -0.0457823, -0.000282261, -0.0397867, -0.0802366, -0.0302946, -0.0282375, 0.00992835, -0.00810354, -0.000570061, 0.0276374, 0.0465672, 0.0557315, 0.0893829, 0.00323767, 0.0211198, -0.0329843, 0.0457786, -0.0624573, -0.0366647, 0.0493956, -0.0318115, 0.043688, -0.0575465, 0.0878898, 0.0353466, 0.0098717, 0.0482005, 0.0144678, 0.0224672, -0.0258368, 0.00123079, -0.0163304, -0.0515648, 0.0382155, -0.0209199, 0.0241929, -0.0249902, -0.0131127, -0.0319867, -0.024325, 0.00702762, -0.0300215, -0.0331813, -0.0298333, -0.00414866, -0.0113066, -0.0617162, -0.0380196, 0.00266623, 0.0172258, 0.0117751, 0.0278349, 0.0758131, -0.00333397, 0.00566423, -0.0311591, -0.0217933, -0.029119, -0.0171365, 0.0360879, 0.0454689, -0.02