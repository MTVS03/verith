MERGE (c:`Chunk` {`id`: '096770-0195-71cf1097'}) SET c += {`text`: '[SK이노베이션] 9. 소재사업\n- 이에 더하여, 당사는 회사의 사업 포트폴리오 확장 및 지속적인 발전을 위해 당사 보유 역량과 연계하여 에너지 저장, 로봇/휴머노이드 등 신규 성장 시장, 차세대 배터리 분야 등 유망 영역을 대상으로 다양한 기회를 검토 중입니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '9. 소재사업', `idx`: 195} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0233003, 0.0518563, 0.00441883, -0.0448993, -0.0299722, -0.00324702, -0.0345372, 0.0278557, 0.00184004, -0.0597828, 0.121998, 0.042972, -0.0179588, -0.000259879, 0.00678914, -0.0179414, 0.0594923, -0.0147743, -0.036961, -0.022815, 0.0165152, -0.0316129, -0.0173161, 0.0503604, 0.00908754, -0.0499426, -0.0378553, 0.028857, -0.0281607, 0.0648823, -0.0434715, 0.022524, -0.0367664, -0.0346535, -0.00925485, -0.0836241, 0.0143898, -0.0169491, -0.0312375, 0.0439319, -0.0320687, 0.025066, 0.0802809, -0.0338486, 0.00325378, -0.0439276, -0.0413833, -0.00995359, -0.0251339, -0.0273754, -0.0443796, -0.00549934, -0.0388158, 0.0621184, 0.0516508, -0.0105219, -0.068819, -0.0486134, -0.0153847, 0.137426, -0.0234658, 0.0206102, 0.0326103, -0.00136636, 0.00386132, -0.0566269, 0.0282197, 0.0249754, 0.00120952, 0.0240172, 0.0379855, 0.0262461, -0.0396586, -0.00212596, -0.0405721, 0.0118595, -0.0336764, -0.0212611, 0.0242079, -0.0055709, -0.0418916, 0.00184997, -0.0382254, -0.000369161, 0.0236198, -0.0322639, -0.0420533, 0.0373966, 0.0631062, -0.00975395, -0.038164, -0.0144123, -0.00391431, -0.0128436, -0.0392213, 0.046095, -0.0688597, -0.00176168, -0.0987755, 0.00987115, -0.0380722, 0.0378468, 0.0284419, -0.0410495, -0.0256211, -0.0041309, -0.0432072, 0.062004, -0.0705184, -0.050053, 0.00695387, 0.0176643, 0.0653306, 0.0680413, -0.0390497, 0.00170397, 0.0545434, 0.0243175, 0.00660848, 0.0578482, -0.00911142, 0.00191305, 0.0446194, -0.0594381