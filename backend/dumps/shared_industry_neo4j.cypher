MERGE (c:`Chunk` {`id`: '006400-0011-6b9d3296'}) SET c += {`text`: '[삼성SDI] 4. 매출 및 수주상황 > 가. 매출\n(1) 공시대상기간 중 매출실적\n(단위: 억원)\n사업부문\n매출유형\n품 목\n제56기\n제55기\n제54기\n에너지솔루션\n제품\n기타매출\n소형전지 등\n수 출\n108,782\n136,744\n182,125\n내 수\n15,059\n20,168\n21,936\n합 계\n123,841\n156,912\n204,061\n전자재료\n제품\n기타매출\nEMC 등\n수 출\n7,786\n7,921\n9,078\n내 수\n1,040\n1,089\n1,229\n합 계\n8,826\n9,010\n10,307\n합 계\n수 출\n116,568\n144,665\n191,203\n내 수\n16,099\n21,257\n23,165\n합 계\n132,667\n165,922\n214,368\n※ 상기 금액은 연결기준으로 작성되었습니다.\n※ 수출금액에는 로컬수출이 포함되어 있습니다.\n※ 전자재료 부문의 편광필름 사업 양도에 따라  편광필름 사업관련 매출액은\n중단영업으로 제외하고 작성되었습니다.\n(2) 판매경로 및 판매방법 등\n① 판매경로\n당사의 주요 매출처로는 Bayerische Motoren Werke ("BMW"), Volkswagen Group\n("VWG"), 삼성전자, Stellantis, AES 등 입니다.\n에너지솔루션 부문의 경우 당사에서 거래선에 직접 공급하는 비중이 97%이고,\n대리점을 경유하는 비중은 3%이며, 전자재료 부문의 경우 거래선에 직접 공급하는 비중이 93%이고, 대리점을 경유하는 비중은 7%입니다.\n② 판매방법 및 조건\n판매방법은 판매경로에 기재된 방법으로 공급하고 있으며, 거래선과의 계약에 따라 여신 및 현금 등의 조건으로 거래하고 있습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 가. 매출', `idx`: 11} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00699715, -0.0179271, 0.0334438, -0.00454045, -0.0652199, 0.018076, -0.0112461, 0.0132274, 0.0443782, 0.0496681, 0.052568, 0.0521052, -0.0060145, 0.0319705, 0.00734766, -0.037576, 0.0411145, 0.00118825, -0.0240028, -0.0156074, 0.0351076, 0.0506917, 0.0201202, 0.0258795, 0.00580862, -0.0264811, 0.00136903, -0.0125966, -0.0341563, 0.0205854, -0.0519025, 0.0285441, -0.00303556, -0.0348524, -0.0609606, -0.0162982, -0.0158171, 0.0055404, -0.064492, -0.0259807, 0.0262735, 0.0162326, 0.0511948, -0.0811896, 0.0266172, -0.0290792, -0.058538, -0.0354256, -0.000940047, -0.00839527, -0.0623578, -0.0181279, 0.0208742, -0.0183132, 0.0225953, 0.0657159, -0.0763418, -0.00452942, -0.014592, 0.0706022, -0.0182534, -0.020431