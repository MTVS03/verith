MERGE (c:`Chunk` {`id`: '096770-0089-594acfa6'}) SET c += {`text`: '[SK이노베이션] 4. 매출 및 수주상황 > [SK인천석유화학㈜] > 나. 판매 경로 및 판매 방법 등\n(1) 주요 판매 경로\n당사의 주요 거래 구조는 다음과 같으며, 자체 판매를 지속 확대해 나갈 예정입니다.① 석유 제품\n(수출) 당사 → 도매점 → 소비자\n(내수) 당사 → 도매점 → 대리점/ 주유소 → 소비자\n② 석유화학 제품\n당사 → 도매점 → 소비자\n(2) 판매 방법 및 조건\n당사는 수출 및 내수 판매를 하고 있으며, 현금 등으로 대금을 결제 받고 있습니다.\n(3) 주요 판매 경로별 매출액 비중\n경로\n수출\n내수\n도매점\n도매점\n비중\n46.5%\n53.5%\n(4) 주요 매출처와 매출 비중당사의 주요 매출처는 SK에너지㈜, SK지오센트릭㈜,\nSK Energy International Pte., Ltd.이며, 이들에 대한 당사의 매출 비중은 약 96.3% 수준입니다.\n주요 매출처\n비중\nSK에너지㈜\n52.8%\nSK지오센트릭㈜\n23.4%\nSK Energy International Pte., Ltd.\n20.1%\n(5) 판매전략\n국내외 시장 동향을 신속하게 파악하여 판매 전략을 수립하고, 석유 및 화학시장\n환경 변화에 대한 선제적 대응을 추진하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [SK인천석유화학㈜] > 나. 판매 경로 및 판매 방법 등', `idx`: 89} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00990957, 0.0121768, -0.0192281, -0.00756702, 0.00662828, -0.0036023, -0.0278012, 0.0129994, 0.0374126, 0.0432101, 0.114756, 0.0497623, 0.000449155, 0.0353486, 0.0122542, 0.0468902, -0.00592107, 0.0106721, -0.0296006, 0.0305367, -0.0358766, 0.0329087, -0.0284345, 0.0172739, 0.0523544, -0.0286965, -0.0117814, 0.0573488, -0.0720764, 0.0521167, 0.0663302, 0.0427339, -0.0691631, -0.0186051, -0.00387214, -0.059594, 0.0258534, 0.0318989, -0.0424133, 0.0314286, -0.0019218, 0.0162112, 0.0436851, -0.0397384, -0.0013044, -0.0129124, -0.021163, -0.022235, 0.03989, -0.00611055, -0.0730271, 0.0353708, 0.0103063, 0.0754246, 0.0112137, 0.0194209, -0.039982, 0.0118016, 0.00337969, 0.0600111, -0.034408, 0.0211201, 0.00547055, 0.0434654, -0.0335964, -0.00154521, 0.024687, -0.00289184, -0.0516149, 0.0552947, -0.0208037, 0.0263362, -0.0111916, 0.00345915, -0.00526619, 0.0162043, 0.0492292, -0.000682279, 0.035067, -0.0261005, -0.0421252