MERGE (c:`Chunk` {`id`: '003670-0016-dcd8d064'}) SET c += {`text`: '[포스코퓨처엠] 4. 매출 및 수주상황 > 다. 수주상황\n당기말 현재, 포스코퓨처엠의 수주잔고 10억원 이상인 계약의 수주잔고 총액은 약 30,175백만원입니다.\n(기준일 : 2025.12.31)\n(단위 : 백만원 )\n품목\n수주\n일자\n납기\n수주총액\n기납품액\n수주잔고\n수량\n금액\n수량\n금액\n수량\n금액\n광양 2고로 2차개수\n2025-03-04\n2026-03-31\n-\n10,700\n-\n13\n-\n10,687\n현대제철 당진제철소 CDQ 신설공사\n2022-11-17\n2027-04-30\n-\n18,373\n-\n12,360\n-\n6,013\n광양 전기로 신설공사\n2025-11-17\n2026-05-31\n-\n5,211\n-\n314\n-\n4,897\n포항 3FINEX 부분개수\n2025-02-01\n2026-01-31\n-\n43,500\n-\n41,110\n-\n2,390\nGS칼텍스 2026년 VGOFCC팀 T/A 내화물 공사\n2025-12-18\n2026-06-30\n-\n2,239\n-\n-\n-\n2,239\n포항 2열연 5가열로 신설공사\n2024-09-05\n2026-02-28\n-\n8,259\n-\n6,200\n-\n2,059\n포항 6기 CDQ Chamber 기둥연와 개선교체\n2025-12-18\n2026-06-30\n-\n1,890\n-\n-\n-\n1,890\n합 계\n-\n90,172\n-\n59,997\n-\n30,175\n당사의 에너지소재사업은 주로 거래처와 중장기 공급계약 체결후 납품하고 있으나, 공급물량 등이 고객의 실제주문 및 향후 시장상황에 따라 유동적이며, 대내외적 경제변화와 그에 따른 수요변화를 정확히 예측할 수 없습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > 다. 수주상황', `idx`: 16} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0158041, 0.0263407, -0.0061134, -0.014223, -0.0115224, 0.0154088, -0.0169262, -0.00860385, -0.0580885, -0.000867202, 0.0432289, 0.0314105, -0.000644812, 0.0165367, -0.0152787, 0.00797573, 0.0479278, -0.0055475, -0.0314209, 0.053398, 0.0947805, 0.025364, -0.00610658, 0.0343794, 0.0355202, -0.0142367, 0.0359962, 0.0490254, -0.00146584, 0.0691994, 0.0124209, 0.0430884, -0.0203758, -0.0596503, -0.00332708, -0.0331936, 0.0737844, -0.0259232, -0.042146, 0.00177539, -0.0234926, -0.0229469, -0.0500892, -0.0438724, 0.00065717, -0.0502725, -0.0169285, -0.0132944, -0.0267377, -0.00478502, -0.0601355, 0.00179582, -0.0107796, 0.0244691, 0.041135, 0.00784423, -0.103187, 0.00199511, 0.0429515, 0.0399368, -0.014219, -0.0363798, 0.0