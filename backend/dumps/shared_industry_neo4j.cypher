MERGE (c:`Chunk` {`id`: '361610-0026-074a34ae'}) SET c += {`text`: '[SK아이이테크놀로지] 7. 기타 참고사항 > [연도별 상표권 등록 건수] > 나. 법률/규정 등에 의한 규제사항\n- 당사는 2025년 12월 31일 현재 "독점규제 및 공정거래에 관한 법률" 상 「상호출자제한기업집단」으로 지정되어 있어서, 계열회사간 상호출자 및 채무보증이 금지되는 등 관련규정에 따른 규제를 적용 받고 있습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [연도별 상표권 등록 건수] > 나. 법률/규정 등에 의한 규제사항', `idx`: 26} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0367396, 0.0699862, -0.0513025, 0.030555, -0.0661206, 0.0433616, -0.0173357, 0.0504555, 0.0176814, 0.0231369, 0.00220429, 0.00504731, -0.01748, -0.0258238, -0.00618197, -0.0189183, -0.0240016, 0.0252324, -0.0836134, 0.00885438, 0.0283083, -0.0137266, -0.0615021, -0.00735816, 0.0155223, -0.0283708, -0.0071407, 0.00697544, 0.00125866, 0.00721726, 0.0920226, 0.000294403, -0.0256922, -0.0371392, 0.0595479, -0.0678927, -0.0225702, 0.00695106, -0.0353875, 0.0539018, -0.00677544, 0.0333292, 0.0161627, -0.107999, 0.00934745, -0.0127055, -0.0101838, 0.0112208, 0.00744718, 0.0497578, 0.00467012, -0.0340022, -0.0206347, -0.0358039, 0.0138037, 0.0155951, -0.00407278, -0.0114626, 0.00177895, 0.00515494, -0.0339255, -0.0169831, 0.0298545, -0.0656267, 0.00493059, -0.054847, 0.0699732, 0.0167784, -0.0293631, 0.0282037, 0.065415, 0.0217627, 0.00791632, 0.0267203, -0.0779811, 0.0362594, -0.0236617, 0.008695, 0.0478338, -0.0546795, 0.0272305, -0.0190688, 0.0497414, 0.0491181, 0.0149678, 0.0482082, -0.0742877, -0.0261901, 0.0121535, 0.0386496, -0.0333083, 0.0514836, -0.0311557, 0.060705, 0.0408358, -0.0758341, -0.0181959, 0.0370691, -0.00762964, 0.00586603, -0.0434589, 0.050293, 0.0496303, -0.0479853, 0.0105055, 0.0158446, 0.0447709, 0.0922739, 0.0307603, 0.0934194, -0.0330052, 0.0189397, 0.0432841, 0.0455605, 0.0109711, 0.0080638, 0.0360895, 0.0183343, 0.02750