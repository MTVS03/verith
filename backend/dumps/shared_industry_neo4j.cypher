MERGE (c:`Chunk` {`id`: '086520-0128-82a83033'}) SET c += {`text`: '[에코프로] 7. 기타 참고사항 > [환경사업부문] > 다. 산업의 특성 및 성장성\n1) 환경산업의 특성\n「환경산업」이란 광범위적으로 자원순환관리, 물관리, 환경복원 및 복구, 기후대응, 대기관리, 환경안전.보건,지속가능 환경.자원, 환경지식.정보.감시 등 다양한 산업에서 환경 개선을 위한 기술 및 서비스를 제공하는 산업을 의미하며, 다음과 특징을 나타내고 있습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '7. 기타 참고사항 > [환경사업부문] > 다. 산업의 특성 및 성장성', `idx`: 128} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0775195, -0.044758, -0.00535996, -0.0508902, -0.0240292, -0.0647037, -0.100795, 0.077215, -0.0333319, 0.0321687, 0.0196699, -0.0195651, 0.00223841, 0.0263935, 0.0852049, -0.0257267, 0.0317332, 0.025894, -0.0093899, -0.074826, -0.00999431, -0.0102514, -0.0374013, -0.0331737, 0.000683907, 0.035729, -0.0243375, -0.0462118, -0.0312229, 0.0351967, -0.0552917, 0.0597556, 0.00171079, 0.0124515, 0.0105179, 0.044202, -0.0417727, -0.0212382, -0.0850017, 0.0429356, -0.0327675, -0.00614331, 0.0339801, -0.00297894, -0.0625831, -0.0153267, -0.0494681, -0.0317137, -0.0080253, -0.0145153, -0.0404618, -0.0278889, 0.010704, -0.0654659, -0.0355134, 0.0228335, -0.0375734, -0.0768763, -0.0143172, 0.0105357, 0.00640489, 0.0421255, -0.00579396, 0.00253234, -0.0483864, -0.0156811, 0.0239391, -0.0307562, 0.0474586, 0.0363526, 0.0266005, 0.00255968, -0.0618023, -0.00445903, 0.0467428, -0.00119033, -0.056597, -0.0135789, -0.0171363, 0.0139307, -0.0919276, -0.0212857, 0.0171478, 0.0152879, -0.000115744, -0.0122901, -0.0749743, 0.0272868, 0.0168386, -0.0445063, 0.00293405, 0.00291551, 0.0652714, -0.0184997, -0.0295407, 0.0588661, -0.0176845, 0.0237987, -0.064575, 0.0417731, -0.0584772, 0.029356, -0.00508608, -0.0444391, -0.0384813, -0.0785512, 0.0659692, 0.0260999, -0.0332399, -0.0100646, -0.0101529, -0.000871361, -0.0723202, 0.0278985, -0.0184296, -0.014399, 0.