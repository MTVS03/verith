MERGE (c:`Chunk` {`id`: '086520-0047-7e9362ca'}) SET c += {`text`: '[에코프로] 5. 위험관리 및 파생거래 > 나. 파생상품 및 풋백옵션 등 거래 현황\n연결회사는 환위험을 회피할 목적으로 파생상품 계약을 체결하고 있으나 위험회피회계는 적용하지 않습니다.\n종속기업인 ㈜에코프로이엠과 관련하여 합작투자자인 삼성SDI㈜와의 합작투자계약을 통해 연결회사의 귀책으로 인해 본 계약이 해지될 경우 삼성SDI㈜가 소유한 ㈜에코프로이엠 주식 전부에 대해 행사 시점의 공정가치로 풋옵션을 행사할 권리를 삼성SDI㈜에게 부여하고 있습니다. 또한, 삼성SDI㈜의 귀책으로 인해 본 계약이 해지될 경우 삼성SDI㈜가 소유한 ㈜에코프로이엠 주식 전부에 대해 행사시점의 공정가치로 콜옵션을 행사할 권리를 보유하고 있습니다.\n연결회사와 삼성SDI㈜는 약정기간 중 ㈜에코프로이엠의 이사회 특별결의에 의한 승인 및 상대방 당사자의 동의 없이는 자신이 소유한 주식을 제3자에게 양도할 수 없습니다.', `company`: '에코프로', `stock_code`: '086520', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260318001612&dcmNo=11144186&eleId=9&offset=142214&length=347053&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 나. 파생상품 및 풋백옵션 등 거래 현황', `idx`: 47} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0235674, -0.0290388, 0.0193786, 0.0321382, -0.076456, 0.0720591, 0.0795998, 0.0550046, 0.0368571, 0.0773933, 0.0398329, 0.0546346, 0.0485728, -0.0137209, 0.00755752, -0.0558754, -0.00613064, -0.00180389, 0.00807298, 0.0138933, -0.000639394, -0.0465863, 0.0011592, -0.0169752, 0.0530689, -0.019923, -0.0217623, -0.00114335, -0.00445136, 0.0272621, -0.00819567, 0.0156812, -0.027893, -0.0323824, -0.00758032, 0.00496242, -0.010514, -0.00903011, 0.0115804, 0.0398217, -0.00886437, 0.0182623, 0.0482242, -0.109593, 0.0318913, -0.0324209, -0.0162137, 0.0202605, -0.0235023, -0.0503401, -0.0379422, 0.0201118, 0.0236068, -0.0229885, 0.0263103, 0.00517912, -0.0334761, -0.0176101, 0.0352647, -0.0256496, 0.0426794, -0.084808, -0.00931686, -0.111613, 0.00420577, -0.0454643, 0.0249834, 0.0396795, 0.000210738, 0.0631794, 0.0350701, -0.0373885, -0.0164528, 0.0328006, -0.0507659, 0.0469857, -0.0369493, -0.0346491, 0.0797215, 0.0341233, 0.0749001, 0.00103041, 0.0399785, 0.0347608, 0.000319095, 0.0240006, -0.0735037, -0.0156267, -0.0192402, 0.0106598, 0.0022493, -0.0546789, 0.0357554, 0.00851768, 0.0629914, -0.0244649, -0.