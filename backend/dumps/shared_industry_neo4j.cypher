MERGE (c:`Chunk` {`id`: '003670-0020-6b694056'}) SET c += {`text`: '[포스코퓨처엠] 5. 위험관리 및 파생거래 > 다. 위험관리조직\n회사는 내부적으로 환위험에 노출될 수 있는 모든 외환 거래에 대해서 적절한 헤징을하도록 하고 있습니다. 환위험을 관리할 전문 인력으로 FX환율 관련 업무 2인, 송금 및 계좌관리 관련 업무 2인을 두고 상호 업무를 분리하여 내부적인 통제수단을 가지고 있습니다. 당사는 경영기획실을 통해서도 전사적 통합 위험관리를 수행하고 있습니다.', `company`: '포스코퓨처엠', `stock_code`: '003670', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260312000826&dcmNo=11114751&eleId=9&offset=140005&length=96118&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 다. 위험관리조직', `idx`: 20} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.00600762, -0.0527374, -0.0225106, 0.018714, -0.0296335, 0.0048352, 0.0324392, 0.0349979, 0.0222608, 0.0204131, -0.0462999, 0.00120547, 0.017242, 0.0648558, 0.0600452, 0.0223594, 0.00160015, -0.0383047, -0.00217439, 0.0587368, 0.0484209, -0.0254133, -0.0303826, -0.00967078, 0.0224825, 0.012757, -0.0319693, 0.0260423, -0.0130033, 0.0512709, 0.0184442, 0.0248219, -0.0580563, -0.00834312, 0.0593748, 0.0686213, 0.0194013, 0.0303969, -0.0532101, -0.00359313, -0.0204348, 0.0305864, -0.0236593, -0.0291475, 0.00816297, -0.0174197, -0.031663, -0.0374684, -0.0203843, -0.0262335, -0.055235, 0.00197974, -0.0223568, 0.0446284, 0.0439243, -0.011922, 0.0290105, -0.015955, 0.0811158, -0.0422465, 0.0626756, -0.0236806, 0.036124, -0.0174632, 0.0169983, -0.00660169, 0.00039138, -0.0161949, 0.00618758, 0.0123439, 0.00357499, 0.0231388, 0.0176408, -0.00641373, -0.136243, 0.0338357, -0.00324558, 0.00939259, 0.0492289, 0.061369, 0.00100543, 0.00325838, 0.026614, 0.0281696, -0.0317284, 0.132381, -0.0459333, -0.0290984, 0.0562455, -0.0570217, -0.00183361, -0.0302612, -0.0200049, -0.0341635, 0.00848666, 0.0130241, -0.0387956, 0.050386, 0.0622845, -0.00350037, 0.0904019, 0.0234034, 0.0167088, -0.0866871, -0.0344797, 0.0299628, -0.063724, 0.0122925, -0.0329304, 0.00765351, 0.0248715, 0.0363881, 0.0145226, 0.0223746, -0.0295132, -0.0387439, -0.0434065, 0.0298959