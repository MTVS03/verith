MERGE (c:`Chunk` {`id`: '361610-0015-8ab0eb55'}) SET c += {`text`: '[SK아이이테크놀로지] 5. 위험관리 및 파생거래 > 다. 파생상품 계약 및 그 계약에 관한 내용\n(1) 통화선도 및 통화스왑 파생금융상품계약 체결 현황\n- 당기말 현재 연결기업은 외화 매출채권 등의 환율 변동 위험을 Hedge하기 위하여 통화선도 계약을 체결하고 있으며, 그 상세내역은 다음과 같습니다.\n(기준일 : 2025년 12월 31일)\n(단위 : 백만USD, 백만원)\n거래처\n계약일\n만기일\n약정환율\n계약금액\n공정가치\n자산\n부채\n위험회피회계 적용 여부\nKB\n(주3)\n2025년 12월\n2026년 1월\nUSDCNY 6.97\nUSD 5\n(56)\n-\n(56)\n미적용\nING 등\n(주4)\n2025년 9월\n2026년 4월\nUSDPLN 3.66\nUSD 50\n(1,106)\n-\n(1,106)\n미적용\nBNP파리바\n(주4)\n2025년 4월\n2026년 9월\nUSDPLN 3.94\nUSD 19\n(2,476)\n-\n(2,476)\n미적용\nING\n(주4)\n2025년 9월\n2026년 9월\nUSDPLN 3.66\nUSD 50\n(1,148)\n-\n(1,148)\n미적용\nBNP파리바\n(주4)\n2025년 4월\n2027년 9월\nUSDPLN 3.98\nUSD 26\n(3,495)\n-\n(3,495)\n미적용\n도이치\n(주4)\n2025년 3월\n2027년 9월\nUSDPLN 4.10\nUSD 135\n(24,486)\n-\n(24,486)\n미적용\n하나은행\n(주4)\n2025년 6월\n2027년 11월\nUSDPLN 3.80\nUSD 50\n(3,263)\n-\n(3,263)\n미적용\n합계\n(36,030)\n-\n(36,030)\n(주1)\n계약금액은 계약통화 기준 금액이며, 공정가치, 자산 및 부채는 원화 기준입니다.\n(주2)\n공정가액 평가주체는 거래처와 동일합니다.\n(주3)', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 다. 파생상품 계약 및 그 계약에 관한 내용', `idx`: 15} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.0389596, -0.00238608, -0.0490018, 0.0177226, 0.00549367, 0.0716067, 0.031495, 0.0364541, 0.0164245, 0.0288394, 0.0453816, 0.0226917, 0.0470983, 0.0143415, -0.00642715, -0.013069, -0.00785606, -0.0447892, -0.00892012, 0.0295372, 0.00312152, -0.0107955, -0.032056, 0.0487166, 0.051411, -0.0660815, -0.0435351, 0.00626525, 0.0142489, 0.055814, 0.0525335, 0.035258, -0.0237683, -0.0289295, 0.0434395, -0.0205334, 0.0196404, 0.0112634, -0.0685836, 0.0357193, 0.0204236, -0.0137397, -0.0129307, -0.0716822, 0.0962544, -0.0136089, 0.0161628, -0.0209977, -0.0227305, -0.00980923, -0.0336008, -0.0667953, 0.0527592, -0.0209094, 0.07