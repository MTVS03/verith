MERGE (c:`Chunk` {`id`: '066970-0021-bdc17942'}) SET c += {`text`: '[엘앤에프] 1. 시장위험\n(11,759,633)\n170,642\n-\n합  계\n357,242,143\n(11,803,261)\n232,962,131\n(11,803,261)\n손실충당금은 연결회사가 자산금액을 회수할 수 없다는 것을 확신하기 전까지 손상차손을 기록하기 위하여 사용됩니다.\n2) 유동성위험\n유동성위험이란 연결회사가 금융부채에 관련된 의무를 충족하는데 어려움을 겪게 될위험을 의미합니다. 연결회사의 유동성 관리방법은 재무적으로 어려운 상황에서도 받아들일 수 없는 손실이 발생하거나, 연결회사의 평판에 손상을 입힐 위험 없이, 만기일에 부채를 상환할 수 있는 충분한 유동성을 유지하도록 하는 것입니다.\n연결회사의 유동성 위험 분석 내역은 다음과 같습니다.\n① 제26(당)기말\n(단위: USD, 천원)\n당기말\n~ 1년\n1 ~ 2년\n2 ~ 5년\n5년 초과\n합  계\n매입채무및기타채무\n363,190,074\n-\n-\n-\n363,190,074\n담보부 은행차입금(*1)\n298,330,796\n347,618,068\n43,192,528\n6,425,425\n695,566,817\n무담보 은행차입금(*1)\n692,696,873\n-\n-\n-\n692,696,873\n기타유동금융부채(*1)\n17,345,107\n-\n-\n-\n17,345,107\n기타비유동금융부채(*1)\n-\n3,246,108\n8,037,955\n2,475,200\n13,759,263\n교환사채(외화)(*1,2)\nUSD 9,500,000\nUSD 9,500,000\nUSD 383,045,205\n-\nUSD 402,045,205\n신주인수권부사채(*1,2)\n1,083,278\n109,070,716\n11,502,464\n-', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 시장위험', `idx`: 21} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0568496, 0.0176197, 0.0264653, -0.0472168, -0.0132609, 0.0884872, 0.0499744, 0.0877923, -0.00718532, -0.0299859, 0.0004392, 0.0453537, 0.0401613, 0.0125714, -0.0126081, -0.0398899, 0.00634752, 0.00727131, -0.0296249, -0.00181419, -0.0167354, -0.0154165, -0.0501281, -0.0501196, -0.0425448, -0.0100808, -0.00759156, 0.022636, 0.00784995, -0.00229484, -0.0226569, 0.0487475, -0.056209, 0.0256776, 0.0382527, -0.00113156, -0.0217559, 0.0243072, -0.0220962, 0.0684524, 0.00370969, 0.0460081, 0.0510726, -0.0764434, 0.00111954, -0.017794, 0.0155422, -0.0291361, -0.00750175, -0.0106091, 0.00684069, -0.0467035, 0.00767659, 0.00525383, 0.00855143, -0.0267918, -0.0308351, 0.0683978, 0.0535132, 0.00631254, 0.00579542, -0.0389429