MERGE (c:`Chunk` {`id`: '096770-0103-b3a7713c'}) SET c += {`text`: '[SK이노베이션] 5. 위험관리 및 파생거래 > 가. 위험관리\n연결실체의 주요 금융부채는 차입금, 사채, 리스부채, 매입채무 및 기타채무로 구성되어 있으며, 이러한 금융부채는 영업활동을 위한 자금을 조달하기 위하여 발생하였습니다. 또한, 연결실체는 영업활동에서 발생하는 매출채권 및 미수금 등과 같은 다양한 금융자산도 보유하고 있습니다.\n연결실체의 금융자산 및 금융부채에서 발생할 수 있는 주요 위험은 시장위험, 신용위험 및 유동성위험입니다. 연결실체의 주요 경영진은 아래에서 설명하는 바와 같이, 각 위험별 관리정책을 정비하고 그 운용이 정책에 부합하는지 확인하고 있습니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 가. 위험관리', `idx`: 103} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.028819, -0.00778867, -0.0266676, -0.0117151, -0.0528119, 0.0689423, 0.0274487, 0.0200025, -0.00516068, 0.02088, -0.026837, -0.0126849, -0.0424457, 0.0383779, -0.0259256, -0.0208536, 0.0129691, 0.013281, -0.0527103, 0.0655066, 0.0236453, -0.041237, -0.00493781, -0.0152252, 0.041502, -0.0344279, -0.0512199, 0.0262729, -0.0207095, 0.0365663, 0.0137754, 0.0495088, -0.0267337, 0.0114621, 0.00493146, -0.0494769, -0.0120994, 0.0118508, -0.0365225, 0.0610035, -0.0407838, 0.0759899, 0.135671, -0.0698274, 0.00605054, 7.67555e-05, 0.0375801, 0.0138947, -0.0270181, -0.0135371, -0.0353065, -0.0668393, -0.0159318, 0.0160675, 0.0496181, -0.0114834, -0.0277173, -0.0143257, 0.0818043, -0.00124139, 0.0389371, 0.0205137, 0.0179901, -0.00240297, 0.0222933, -0.012503, -0.020397, 0.00412968, 0.010313, -0.000556807, -0.0146821, -0.0472213, 0.0121603, 0.0541004, -0.0184916, -0.00422649, -0.0387394, -0.0304298, 0.0385517, -0.000418319, -0.0103218, 0.038663, -0.00290474, 0.0145439, -0.0252203, 0.0984983, -0.0247691, 0.0659619, 0.0375467, -0.0110372, -0.0285731, -0.0697386, -0.00844979, 0.0132825, 0.0120368, -0.00608529, -0.0897525, 0.0269912, 0.0315718, 0.00691506, -0.00491886, 0.0329386, 0.0219736, -0.0410112, 0.0271183, 0.0207097, -0.0641549, -0.0292989, 0