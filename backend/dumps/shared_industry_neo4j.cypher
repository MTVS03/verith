MERGE (c:`Chunk` {`id`: '096770-0069-ffc5197c'}) SET c += {`text`: '[SK이노베이션] 4. 매출 및 수주상황 > [윤활유 사업 부문]\n당사는 Green성장본부 아래 윤활유사업부를 통해 국내외 50여개 국에서 윤활유를 판매하고 있습니다. 중국, 러시아, 인도, 미주의 경우 법인을 설립하여 운영중입니다.\n국내시장 판매는 국내영업조직에서 담당하고 있습니다. 국내 엔진오일 소매는 주로 판매 회사와 판매점을 거쳐 정비소(카센터)로 유통되는 구조를 가지고 있습니다. 판매 회사의 수익은 판매 수익금 및 판매 성과에 따른 인센티브 수취로 이루어져 있습니다. 판매점의 경우 국내에 약 800여개가 있는 것으로 추정되며, 타사의 제품도 취급이 가능합니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '4. 매출 및 수주상황 > [윤활유 사업 부문]', `idx`: 69} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.030747, -0.00502026, 0.00932233, -0.0158299, -0.0390092, 0.0496957, -0.0190658, 0.0367331, 0.0499214, 0.046439, 0.0331474, 0.0208947, -0.00533082, 0.0701906, -0.00500791, 0.0206671, 0.0127788, 0.0084094, -0.075884, -0.00316169, 0.0363545, 0.0224279, -0.0180661, 0.0286579, 0.0574927, -0.0319096, -0.0143361, -0.00467407, -0.0982042, -0.033242, -0.0111425, 0.0372922, -0.0563657, 0.0220243, -0.0445873, -0.0342045, -0.00801741, 0.0236224, -0.0290136, 0.00591325, 0.081727, 0.0163177, 0.0469549, -0.0442939, -0.0334427, 0.000475907, -0.0188048, 0.032705, -0.0522866, 0.0157907, -0.0241257, 0.0449775, -0.0141237, 0.0305319, -0.000709166, 0.0247058, 0.00116118, 0.00413136, -0.0338989, 0.0734102, -0.0740953, 0.0410729, -0.0315713, 0.0401623, -0.0211671, 0.0233812, 0.00276448, -0.01754, -0.0493725, 0.01516, -0.0419301, 0.0330622, -0.01166, -0.0143492, -0.0531889, -0.0251101, 0.00396972, 0.00318095, 0.0382934, -0.0396898, -0.0262275, 0.062093, -0.0614985, 0.0754663, -0.00355942, 0.0127215, -0.0312927, -0.00766248, 0.0797805, -0.0712063, 0.00141055, -0.0526291, -0.0644852, 0.037819, 0.0221432, -0.0116229, -0.0441629, 0.0353732, -0.0476724, -0.0462579, 0.0416933, 0.02654, 0.0598229, -0.0827748, -0.0228184, 0.0484601, -0.0954754, 0.0594081, -0.0500