MERGE (c:`Chunk` {`id`: '096770-0137-67971c57'}) SET c += {`text`: '[SK이노베이션] 2025. 10. 15 ~ > [SK에너지㈜] > 가. 부동산 임차계약 건\n(단위: 백만원)\n해당회사\n계약 상대방\n항목\n내용\nSK에너지\n클린에너지위탁관리\n부동산투자회사\n주식회사\n계약의 목적\n및 내용\n자산 매각 이후 영업지속을 위한 임대차 계약 체결\n계약의 체결시기\n및 계약기간\n계약체결일 : 2021년 6월 24일\n계약기간 : 2021. 7.7 ~ 2031. 6. 30.\n계약금액 및\n대금수수방법 등\n거래금액 30,444 백만원\n(보증금 25,145 백만원/ 연간 임차료 30,175 백만원)\n기타사항\n- 상기 거래금액은 연간 임차료와 보증금에 대한 환산 연간 임차료 (부가가치세법 시행규칙 제47조의 이자율 적용)의 합계액 임.\n※ 환산연간임차료(270만원) = 보증금(25,145백만원) × 부가가치세법 시행규칙 제 47조의 이자율\n- 상기 연간임차료는 향후 임차료 상승, 목적물 변동 등에 따라 금액이 변동될 수 있음.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2025. 10. 15 ~ > [SK에너지㈜] > 가. 부동산 임차계약 건', `idx`: 137} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0560508, 0.0870192, 0.00652159, -0.0325212, -0.049693, 0.0331466, 0.018413, 0.00503411, 0.0290141, -0.0178311, 0.0778181, 0.0885853, -0.0192131, 0.0130889, -0.0158416, -0.0367857, 0.0626626, -0.00475966, -0.0319992, 0.0614938, 0.0507747, -0.049855, -0.0066211, 0.0575506, 0.0367744, -0.0277363, -0.0208137, 0.0544881, 0.0523187, 0.0246984, 0.0490031, 0.0475813, -0.0106732, -0.0276245, -0.0239104, 0.0123844, 0.0674946, 0.0283117, -0.0607865, 0.0704425, -0.00437536, -0.039602, 0.0496935, 0.004533, -0.0225546, -0.0356037, 0.0479924, -0.010766, -0.047825, 0.0817262, 0.000669073, -0.033176, 0.0177526, 0.022738, 0.0834027, -0.00088514, -0.0738259, 0.0310746, 0.0099655, 0.0260626, -0.048001, -0.0713851, 0.00613526, 0.00403166, -0.000444257, -0.0524301, 0.00608745, 0.0333628, 0.0162783, -0.0163078, -0.00349081, -0.00399718, 0.0709551, 0.0259961, -0.00229531, 0.0363694, 0.000667072, 0.0237114, 0.00638892, -0.0168376, -0.00167832, 0.0537032, 0.0126012, 0.00162035, -0.0432976, -0.0167165, -0.0620906, 0.0620151, -0.0256071, -0.0462661, -0.0371172, 0.017298, -0.