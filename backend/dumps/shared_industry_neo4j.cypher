MERGE (c:`Chunk` {`id`: '096770-0210-8fe0d642'}) SET c += {`text`: '[SK이노베이션] 13. LNG 사업\n당사는 2013년 9월 국내 민간기업 최초로 미국 Freeport LNG社와 천연가스 액화서비스 계약을 체결하여 연간 220만톤 규모의 셰일가스를 도입할 수 있는 기반을 마련하였으며, 2020년 6월부터 LNG 수송선을 활용하여 Freeport LNG社로부터 LNG를 직도입하고 있습니다. 2014년 9월에는 미국 Continental Resources社와 북미 셰일가스 공동개발계약을 체결, 셰일가스를 생산하고 있고,  2021년 3월 호주 Caldita-Barossa 해상가스전의 최종투자 의사결정 후 2026년초부터 해당가스전으로부터 LNG를 직도입 할 예정입니다. 그 외 당사가 확보한 계약기반의 장/단기 LNG 도입 포트폴리오와 LNG Value Chain 통합운영을 통해 국가 에너지수급 안정화에 기여할 계획입니다.', `company`: 'SK이노베이션', `stock_code`: '096770', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316000827&dcmNo=11125846&eleId=9&offset=171678&length=639988&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '13. LNG 사업', `idx`: 210} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0274257, 0.0151176, 0.00601843, -0.0407773, -0.00590565, 0.0170172, 0.0177714, 0.0131289, 0.00973692, 0.0194308, 0.127387, -0.0391142, 0.0767173, -0.0520216, 0.0195168, -0.0562597, 0.00546257, -0.00970962, -0.0546126, 0.0538681, 0.0543076, 0.00240065, -0.0220239, 0.0305373, 0.0977154, -0.0713875, 0.0621784, 0.0282557, -0.00797993, -0.0302939, 0.0548159, 0.0645523, -0.0349267, -0.0141341, 0.0466263, -0.0516842, 0.0540995, 0.0222997, -0.0515882, -0.00254811, -0.0179048, -0.048038, -0.00207102, -0.00788161, 0.0303548, 0.0275456, 0.0262008, 0.00841519, -0.0620807, 0.0618063, 0.0109567, 0.0508564, -0.016584, 0.0294287, 0.045792, -0.0243445, -0.0829228, -0.00287955, -0.0141918, 0.0901911, -0.0286275, 0.000757578, -0.00849826, -0.0877821, 0.0517051, -0.0518069, 0.0224792, 0.0349069, -0.0339412, 0.0443169, 0.0218027, 0.0714745, 0.0153464, 0.00672558, -0.0238984, -0.0149528, 0.0334229, -0.0251208, 0.0769737, -0.0464299, 0.0202954, 0.0114827, -0.0613837, -0.00818549, -0.0375217, 0.0265789, -0.0517316, 0.0764209, -0.00212315, -0.0672364, 0.0228005, 0.0183182, -0.0609314, -0.029497, 0.0267382, -0.025283, -0.0617246, 0.0220365, -0.0509534, -0.032271, 0.013