MERGE (c:`Chunk` {`id`: '006400-0023-d59140b3'}) SET c += {`text`: '[삼성SDI] 5. 위험관리 및 파생거래 > 나. 콜옵션 및 풋옵션 거래현황\n만료를 서로 합의할 수 있으며 공급 계약 기간 만료 시 General Motors Holdings LLC.가 소유한 SDI-GM Synergy Cells Holdings LLC.의 지분에 대해 당사는 콜옵션을\n행사할 권한을 갖고 있습니다. 또한, 일방이 합작투자계약 중 일부 조항을 중대하게 위반한 경우, 위반자가 General Motors Holdings LLC.인 경우 당사는 콜옵션을, 위반자가 당사인 경우 General Motors Holdings LLC.는 풋옵션을 행사하거나 그 위반이 해소될 때까지 이사회의 과반석을 보유할 수 있는 권리를 가집니다. 그리고 당사와 General Motors Holdings LLC.는 합작계약상 정해진 예외적인 경우를 제외하고 계약기간 중 상대방의 사전 서면 동의 없이는 본인이 소유한 SDI-GM Synergy CellsHoldings LLC.의 지분을 제3자에게 양도할 수 없습니다.', `company`: '삼성SDI', `stock_code`: '006400', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260310002954&dcmNo=11105146&eleId=9&offset=146354&length=112209&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '5. 위험관리 및 파생거래 > 나. 콜옵션 및 풋옵션 거래현황', `idx`: 23} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [0.00300798, -0.0413004, 0.0545954, 0.0151306, -0.0588017, 0.00501441, 0.0192977, 0.001359, 0.0635509, 0.0405879, 0.0241045, 0.0222877, 0.030338, 0.0139471, 0.0237325, -0.112415, -0.00466512, -0.00611405, -0.0679381, 0.0484831, 0.00879449, -0.0436042, -0.0288684, 0.0202367, 0.0376028, -0.0368607, -0.00441086, -0.00341638, 0.0313507, 0.0417851, -0.0324857, 0.0288965, -0.00100203, -0.0978716, -0.034857, -0.0181251, 0.0112679, -0.0223786, 0.00984561, 0.0473422, -0.0537685, 0.00289946, 0.0531271, -0.143774, -0.00957482, -0.0212823, 0.0096139, 0.0453129, -0.0150263, -0.0172877, -0.0493107, 0.0109371, 0.0417107, 0.0785275, 0.0169885, 0.0273877, -0.0292973, -0.0269886, 0.0262353, 0.0291214, -0.0344652, -0.0785144, -0.0280176, -0.0569362, -0.025693, -0.0459003, 0.0336268, -0.00434017, 0.000558671, 0.0205192, 0.0268199, 0.0291845, -0.00350944, 0.0198732, -0.0864594, 0.0136162, 0.00165103, -0.00431648, 0.0428692, -0.00747217, 0.0629746, 0.0132276, 0.0687414, 0.0112895, -0.0233646, -0.00764948, -0.0419717, -0.0263178, 0.0272663, 0.0178922, 0.0436982, -0.03