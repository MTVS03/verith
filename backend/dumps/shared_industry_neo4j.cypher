MERGE (c:`Chunk` {`id`: '361610-0003-ba32de45'}) SET c += {`text`: '[SK아이이테크놀로지] 2. 주요 제품 및 서비스 > 나. 주요 제품 등의 가격 변동 추이\n- 당사 주요 제품의 가격은 고객사와의 계약에 따라 결정되어 영업기밀에 해당됩니다. 따라서 동 사항에 대한 세부 내용을 공시할 경우 당사의 영업에 현저한 영향을 미칠 수 있다고 판단하여 세부 내역은 기재하지 않았습니다.', `company`: 'SK아이이테크놀로지', `stock_code`: '361610', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260316001149&dcmNo=11127408&eleId=9&offset=65050&length=81180&dtd=dart4.xsd', `report_nm`: '사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '2. 주요 제품 및 서비스 > 나. 주요 제품 등의 가격 변동 추이', `idx`: 3} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0346377, 0.0397833, -0.0657311, -0.017547, -0.0305337, -0.0581675, -0.0084917, 0.0338821, -0.015699, 0.0199048, 0.0458243, 0.0219839, 0.0097966, -0.0326646, -0.00209981, 0.00442684, 0.0301125, 0.0338683, -0.0479119, -0.0248865, -0.01114, -0.00375343, -0.0266777, 0.0605797, 0.0921585, 0.00112459, -0.0399854, -0.019136, 0.0107036, 0.0205269, 0.0804051, 0.0039584, -0.0311917, -0.0253622, -0.0210343, 0.0048387, -0.0148307, 0.0248529, -0.0272516, 0.0900488, 0.0456517, 0.0241979, 0.0445008, -0.0415141, 0.0411473, -0.037541, -0.0143216, -0.00842461, 0.00255481, -0.00733383, -0.00354265, -0.106256, 0.0242547, -0.0338293, 0.0433996, 0.0755524, -0.0595966, -0.0412561, -0.0154672, 0.0640986, -0.033374, -0.0212331, 0.0569945, -0.0193882, 0.0537116, -0.0284289, 0.0411158, 0.0167189, -0.0386022, -0.00594606, -0.0177855, 0.0136037, 0.0151525, 0.0878298, -0.0239989, 0.0924719, -0.00899919, 0.0638264, 0.0174735, 0.0247646, -0.0438421, 0.0108506, -0.0132617, 0.00901474, 0.00721874, 0.0630764, -0.0106694, -0.00814166, 0.0403223, -0.0052406, 0.0146208, -0.0383063, 0.00291793, 0.0391917, 0.0634098, -0.0208229, -0.0708588, 0.0249505, -0.0279199, -0.00510181, -0.0407973, -0.0102343, 0.0614071, -0.0891425, 0.0399863, 0.0321664, -0.0111805, 0.0579429, 0.0251784, 0.0482321, -0.00972748, 0.00604736, -0.0377739, 0.000930482, 0.0438971, -0.0184603, -0.00370034, 0.0271429, 0.0484877, 0.106232, -0