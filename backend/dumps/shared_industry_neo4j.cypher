MERGE (c:`Chunk` {`id`: '066970-0007-785b8510'}) SET c += {`text`: '[엘앤에프] 1. 주요 제품등의 현황\n당사와 연결대상 종속회사는 2차전지 양극활물질을 제조, 판매하고 있으며, 매출액 및 총매출액에서 차지하는 비율은 다음과 같습니다.\n(2025년 12월 31일 기준)\n(단위 : 원, %)\n구분\n매출유형\n품목\n구체적 용도\n매출액\n비율\n(주)엘앤에프 및 종속회사\n제품외\n양극활물질외\n2차전지용 양극활물질\n2,154,938,965,103\n100\n합   계\n-\n2,154,938,965,103\n100\n주1) 기간 : 2025.01.01 ~ 2025.12.31\n주2) 한국채택국제회계기준(K-IFRS)에 따른 연결재무제표기준으로 작성되었습니다', `company`: '엘앤에프', `stock_code`: '066970', `source_url`: 'http://dart.fss.or.kr/report/viewer.do?rcpNo=20260423000414&dcmNo=11343023&eleId=11&offset=167301&length=246597&dtd=dart4.xsd', `report_nm`: '[기재정정]사업보고서 (2025.12)', `bsns_year`: 2025, `section`: '1. 주요 제품등의 현황', `idx`: 7} WITH c CALL db.create.setNodeVectorProperty(c, 'embedding', [-0.0311867, 0.0484668, 0.0277549, -0.0124661, -0.0389825, 0.00567797, 0.0303682, 0.072147, -0.0471347, 0.0199059, -0.0322646, 0.0760705, 0.00815411, -0.0321523, -0.00573198, -0.0372536, 0.0321969, -0.0582344, -0.0233525, -0.0635048, -0.01075, -0.00421684, 0.0106773, 0.0129781, 0.0052552, -0.0116979, -0.0499972, -0.0051187, -0.0424732, -0.00499054, -0.0371321, -0.0357602, -0.0845204, -0.0243891, 0.0235458, -0.00464526, -0.0132797, 0.0475531, -0.0489649, 0.0139555, -0.0251959, 0.0161185, -0.00564037, -0.0430097, -0.00316928, -0.0188664, -0.0067062, -0.00493954, 0.0371214, 0.0255949, -0.051078, 0.0146213, 0.00906314, -0.0271336, 0.0389253, 0.0514866, -0.119288, -0.0263789, -0.0265409, -0.0014275, -0.0117074, -0.00633295, 0.055337, 0.0221219, 0.00734861, -0.057753, -0.025331, 0.0600903, -0.0197027, -0.00814475, -0.0345247, 0.0466191, 0.0220244, 0.0216679, 0.0703165, 0.0271817, 0.0156283, -0.0204449, 0.0782753, -0.00316547, -0.00829903, 0.0385369, -0.0186234, 0.00190592, 0.0252991, -0.00694351, -0.0546669, 0.0293064, -0.0461267, 0.00146592, -0.0786474, -0.0113166, -0.0158517, 0.0702208, 0.0333778, 0.00721062, -0.0641345, 0.0112599, 0.0562488, 0.0105098, -0.0360397, 0.00870993, -0.00876745, -0.00394926, 0.0648172, 0.0359198, -0.032390